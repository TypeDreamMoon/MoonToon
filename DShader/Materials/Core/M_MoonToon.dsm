// MoonToon base material.
//
// Everything authorable lives in MF_MoonToonBaseInput; this material only routes that function's
// six outputs to where the renderer expects them:
//
//   Output            -> Base.MaterialAttributes      (the standard GBuffer surface)
//   ToonBufferA       -> ToonMaterialOutput.Pin[0] |
//   ToonBufferB       -> ToonMaterialOutput.Pin[1] | the toon buffer the Toon shading model reads
//   ToonBufferC       -> ToonMaterialOutput.Pin[2] |
//   FaceOverlayData   -> MoonToonFaceOverlay.Pin[0]   (see-through bangs re-blend, 眉透/瞳透)
//   FaceOverlayParams -> MoonToonFaceOverlay.Pin[1]   (per-MI depth threshold / fade / view fade)
//   FaceOverlayStencilIDs -> MoonToonFaceOverlay.Pin[2] (extra occluder toon-stencil IDs)
//   ModifierData      -> ToonMaterialOutput.Pin[3] | the modifier axis: an additive layer that
//   ModifierID        -> ToonMaterialOutput.Pin[4] | composes with whichever feature was picked
//
// ToonMaterialOutput / MoonToonFaceOverlay are UMaterialExpressionCustomOutputs: they have no
// output pins, so they can only be reached through an Outputs expression binding, never from the
// Graph body.

VirtualFunction(Name="MF_MoonToonBaseInput")
{
	Options = {
		Asset = Path(Plugins.MoonToon, "MaterialFunctions/MF_MoonToonBaseInput");
		Description = "Generated from /MoonToon/MaterialFunctions/MF_MoonToonBaseInput.MF_MoonToonBaseInput";
	}

	Inputs = {
	}

	Outputs = {
		MaterialAttributes Output;
		float4 ToonBufferA;
		float4 ToonBufferB;
		float4 ToonBufferC;
		float4 FaceOverlayData;
		float4 FaceOverlayParams;
		float4 FaceOverlayStencilIDs;
		// The modifier payload and the id that says how to read it. Must stay in step with
		// MF_MoonToonBaseInput's own Outputs block -- this is a restated signature, and a missing
		// entry is an "OutputIndex is out of range" build error.
		float4 ModifierData;
		float ModifierID;
	}
}

// Retired along with the dithered-translucency call in Graph. Uncomment BOTH together if the old
// look is ever needed again.
// VirtualFunction(Name="MF_MoonToonTranslucencyShadow")
// {
// 	Options = {
// 		Asset = Path(Plugins.MoonToon, "MaterialFunctions/MF_MoonToonTranslucencyShadow");
// 		Description = "Generated from /MoonToon/MaterialFunctions/MF_MoonToonTranslucencyShadow.MF_MoonToonTranslucencyShadow";
// 	}
//
// 	Inputs = {
// 		MaterialAttributes In;
// 	}
//
// 	Outputs = {
// 		MaterialAttributes Result;
// 	}
// }

Shader(Name="Materials/Core/M_MoonToon", Root="Plugin.MoonToon")
{
	Settings = {
		// A real node graph rather than the default thin-custom material, so the base stays
		// openable in the Material Editor.
		Backend      = "Graph";
		Domain       = "Surface";
#if !DS_SUBSTRATE
		// Under Substrate the shading model comes from the closure: binding Base.FrontMaterial
		// force-sets the material to Substrate, and SubstrateMoonToonBSDF registers SSM_Toon, which
		// the engine folds back to MSM_Toon for every toon gate. Only the legacy GBuffer needs the
		// setting spelled out.
		ShadingModel = "Toon";
#endif
#if DS_SUBSTRATE
		// The per-pin form has no MaterialAttributes struct to carry the customised UVs: UMaterial
		// compiles CustomizedUV[i] only for i < NumCustomizedUVs and passes the raw vertex UV through
		// otherwise. MF_MoonToonBaseInput moves the head-forward / hair tangent from the vertex stage to
		// the pixel stage through CustomizedUV1/2 (the Tangent pin reads TexCoords[1].xy + TexCoords[2].x
		// back), so the SDF facial shadow needs UV1 and UV2 compiled -- 3 covers UV0..UV2. The
		// attributes form (legacy branch) compiles them from the attribute struct regardless of this.
		NumCustomizedUVs = 3;
#endif
		BlendMode    = "Opaque";

		// Real translucency (engine-side ToonTranslucent). A translucent MI of this base gets:
		//   - per-pixel forward toon shading   (this setting -- ToonBxDF only runs per pixel here;
		//     the default VolumetricNonDirectional never reaches it, and the engine logs a warning)
		//   - single-layer coverage            (Moon_MeshPass_ToonTranslucentPrepass, automatic)
		//   - inner lines composited after the fill, opacity-independent
		//   - premultiplied specular so highlights outlive a thin body -- use BlendMode
		//     AlphaComposite on the MI for that; plain Translucent fades highlights with the body
		// Opacity is already routed from MF_MoonToonBaseInput ("Opacity" x "Opacity Map"), so a
		// translucent MI needs no graph change -- only the blend-mode override.
		TranslucencyLightingMode   = "SurfacePerPixelLighting";
		bOutputTranslucentVelocity = true;

		// Dithered masked translucency (the pre-ToonTranslucent approach) is retired -- see the
		// commented-out MF_MoonToonTranslucencyShadow call in Graph below.
		// DitherOpacityMask       = true;

		bUsedWithSkeletalMesh = true;
		bUsedWithMorphTargets = true;
		bUsedWithNanite       = true;
	}

	Outputs = {
#if DS_SUBSTRATE
		// Substrate storage. The shaded surface travels as a closure (SubstrateMoonToonBSDF, the
		// engine's Moon toon BSDF), and EVERY root pin the base input writes is bound as well, from
		// the same authored attributes. That is what the engine's hidden legacy conversion did (it
		// left MaterialAttributes on the root next to the converted closure), and the root pins are
		// not dead under Substrate: the template still builds PixelMaterialInputs from them, and the
		// toon base pass reads some of them directly -- ComposeToonBufferD (ToonMaterialCommon.ush)
		// takes the feature id and the SDF-live bit from the ROOT MoonEncodedAttribute0/4, so with
		// those unbound the face lost its SDF shadow while the closure itself was correct; the
		// ray-tracing hit shaders read the root CustomData0; WorldNormal / WorldTangent come from
		// the root Normal / Tangent. Binding all of them keeps the two storages byte-for-byte alike
		// in what the passes see.
		Substrate ToonClosure;
		float3 BaseColor;
		float  Metallic;
		float  Specular;
		float  Roughness;
		float  Anisotropy;
		float3 EmissiveColor;
		float3 Normal;
		float3 Tangent;
		float4 MoonEncodedAttribute0;
		float4 MoonEncodedAttribute1;
		float4 MoonEncodedAttribute2;
		float4 MoonEncodedAttribute3;
		float4 MoonEncodedAttribute4;
		float  Opacity;
		float  OpacityMask;
		float  AmbientOcclusion;
		float2 CustomizedUV1;
		float2 CustomizedUV2;
		float  CustomData0;
		float  CustomData1;
#else
		MaterialAttributes Attributes;
#endif
		float4 ToonDataA;
		float4 ToonDataB;
		float4 ToonDataC;
		float4 FaceOverlay;
		float4 FaceOverlayTuning;
		float4 FaceOverlayStencils;
		float4 ToonDataD;
		float ToonDataE;

#if DS_SUBSTRATE
		Base.FrontMaterial    = ToonClosure;
		Base.BaseColor             = BaseColor;
		Base.Metallic              = Metallic;
		Base.Specular              = Specular;
		Base.Roughness             = Roughness;
		Base.Anisotropy            = Anisotropy;
		Base.EmissiveColor         = EmissiveColor;
		Base.Normal                = Normal;
		Base.Tangent               = Tangent;
		Base.MoonEncodedAttribute0 = MoonEncodedAttribute0;
		Base.MoonEncodedAttribute1 = MoonEncodedAttribute1;
		Base.MoonEncodedAttribute2 = MoonEncodedAttribute2;
		Base.MoonEncodedAttribute3 = MoonEncodedAttribute3;
		Base.MoonEncodedAttribute4 = MoonEncodedAttribute4;
		Base.Opacity          = Opacity;
		Base.OpacityMask      = OpacityMask;
		Base.AmbientOcclusion = AmbientOcclusion;
		Base.CustomizedUV1    = CustomizedUV1;
		Base.CustomizedUV2    = CustomizedUV2;
		Base.CustomData0      = CustomData0;
		Base.CustomData1      = CustomData1;
#else
		Base.MaterialAttributes = Attributes;
#endif

		Expression(Class="ToonMaterialOutput").Pin[0] = ToonDataA;
		Expression(Class="ToonMaterialOutput").Pin[1] = ToonDataB;
		Expression(Class="ToonMaterialOutput").Pin[2] = ToonDataC;
		// Pins 3 and 4 are the feature-INDEPENDENT modifier axis. A/B/C only mean something in the
		// context of the selected feature; these two survive whichever it is. Pin 3 is the payload
		// (ToonFeatureRT4) and pin 4 the id that selects what its channels mean (ToonFeatureRT3.w),
		// which is why they are bound next to each other and fed from one selector.
		Expression(Class="ToonMaterialOutput").Pin[3] = ToonDataD;
		Expression(Class="ToonMaterialOutput").Pin[4] = ToonDataE;

		Expression(Class="MoonToonFaceOverlay").Pin[0] = FaceOverlay;
		Expression(Class="MoonToonFaceOverlay").Pin[1] = FaceOverlayTuning;
		Expression(Class="MoonToonFaceOverlay").Pin[2] = FaceOverlayStencils;
	}

	Graph = {
		MaterialAttributes Surface = MF_MoonToonBaseInput(OutputIndex=0);

		// Retired: dithered translucent shadow, which faked translucency on a MASKED material by
		// turning the shadow into a dithered opacity mask. Superseded by real toon translucency
		// (see Settings above). The dither could not do what that does -- it wrote full depth and
		// velocity, so SSR/AO/DOF treated a "transparent" character as solid, it leaned on TSR
		// history (noise and smear on fast motion or a cut), and it had no colour, only present or
		// absent. MF_MoonToonTranslucencyShadow.dsf is kept, unreferenced, so an MI that still
		// wants the old look can be rebuilt from it.
		// Attributes = MF_MoonToonTranslucencyShadow(Surface);
		//
		// MF_MoonToonBaseInput already writes both channels: Attributes.Opacity for the translucent
		// blend and Attributes.OpacityMask ("Shadow Opacity" x "Apply Opacity to Shadow") for the
		// masked shadow, so passing Surface straight through keeps masked materials working.
#if !DS_SUBSTRATE
		Attributes = Surface;
#else
		// Substrate: the same authored attributes, split the way Substrate stores them. The
		// closure takes the shaded-surface set; Normal is the authored tangent-space normal (the
		// node converts it to world space, as the legacy root did) and Tangent is the authored
		// world-space direction (facial forward / hair direction), which the node stores as-is.
		// The same values are then routed to the root pins (see the Outputs block for why).
		ToonClosure = UE.Expression(
			Class="SubstrateMoonToonBSDF", OutputType="Substrate",
			BaseColor         = Surface.BaseColor,
			Metallic          = Surface.Metallic,
			Specular          = Surface.Specular,
			Roughness         = Surface.Roughness,
			Normal            = Surface.Normal,
			EmissiveColor     = Surface.EmissiveColor,
			Anisotropy        = Surface.Anisotropy,
			Tangent           = Surface.Tangent,
			EncodedAttribute0 = Surface.MoonEncodedAttribute0,
			EncodedAttribute1 = Surface.MoonEncodedAttribute1,
			EncodedAttribute2 = Surface.MoonEncodedAttribute2,
			EncodedAttribute3 = Surface.MoonEncodedAttribute3,
			EncodedAttribute4 = Surface.MoonEncodedAttribute4
		);
		BaseColor             = Surface.BaseColor;
		Metallic              = Surface.Metallic;
		Specular              = Surface.Specular;
		Roughness             = Surface.Roughness;
		Anisotropy            = Surface.Anisotropy;
		EmissiveColor         = Surface.EmissiveColor;
		Normal                = Surface.Normal;
		Tangent               = Surface.Tangent;
		MoonEncodedAttribute0 = Surface.MoonEncodedAttribute0;
		MoonEncodedAttribute1 = Surface.MoonEncodedAttribute1;
		MoonEncodedAttribute2 = Surface.MoonEncodedAttribute2;
		MoonEncodedAttribute3 = Surface.MoonEncodedAttribute3;
		MoonEncodedAttribute4 = Surface.MoonEncodedAttribute4;
		Opacity               = Surface.Opacity;
		OpacityMask           = Surface.OpacityMask;
		AmbientOcclusion      = Surface.AmbientOcclusion;
		CustomizedUV1         = Surface.CustomizedUV1;
		CustomizedUV2         = Surface.CustomizedUV2;
		CustomData0           = Surface.CustomData0;
		CustomData1           = Surface.CustomData1;
#endif

		ToonDataA = MF_MoonToonBaseInput(OutputIndex=1);
		ToonDataB = MF_MoonToonBaseInput(OutputIndex=2);
		ToonDataC = MF_MoonToonBaseInput(OutputIndex=3);
		FaceOverlay = MF_MoonToonBaseInput(OutputIndex=4);
		FaceOverlayTuning = MF_MoonToonBaseInput(OutputIndex=5);
		FaceOverlayStencils = MF_MoonToonBaseInput(OutputIndex=6);
		ToonDataD = MF_MoonToonBaseInput(OutputIndex=7);
		ToonDataE = MF_MoonToonBaseInput(OutputIndex=8);
	}
}
