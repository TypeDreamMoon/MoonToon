// MoonToon base material.
//
// Everything authorable lives in MF_MoonToonBaseInput and in the thirteen MF_ToonFeature_*
// functions; this material is the wiring that turns them into one Substrate closure.
//
//   Base.FrontMaterial <- a chain of the twelve "Is ..." static switches, each branch a finished
//                         Moon toon closure: a SubstrateMoonToonBSDF of that feature's KIND, plus a
//                         MoonToonFeature node for its TERM where the feature has one. Nothing
//                         ticked falls through to Kind = Default, which is plain toon.
//   Base.Opacity / OpacityMask / AmbientOcclusion / CustomizedUV1 / CustomizedUV2 / CustomData0 / 1
//                      <- the non-shading root pins, straight from the base input's named outputs.
//   MoonToonFaceOverlay.Pin[0..4] <- the see-through-bangs re-blend, the per-MI depth threshold /
//                         fade tuning, the extra accepted occluder classes, this material's own
//                         occluder class (engine #10: the overlay's occluder layer, not CustomStencil),
//                         its see-through group (brow / eye) for the per-character tier, and its
//                         hair-thickness falloff (Pin[5]).
//
// MoonToonFaceOverlay is a UMaterialExpressionCustomOutput: it has no output pins, so it can only be
// reached through an Outputs expression binding, never from the Graph body. It stays a custom output
// because it feeds a mesh pass (Moon_MeshPass_FaceOverlay) per pixel and Substrate has no equivalent.
//
// What this replaced, and why. Until 2026-09-13 the toon surface reached the renderer as a
// MaterialAttributes root plus ShadingModel = "Toon", and the engine converted that behind the
// scenes: a hidden SubstrateConvertMaterialAttributes bridge saw MSM_Toon, read five bit-packed
// MoonEncodedAttribute root pins, and went looking through the asset's expression list for a
// ToonMaterialOutput node to take the feature payload off. Two things were wrong with it. The
// payload never travelled along a wire, so a custom output placed inside a material function was
// silently not found; and the bridge passed profile id 0 unconditionally, so the Moon toon profile
// an artist attached to a material instance did nothing at all on the production path. Both are
// gone: every value here is a pin, and the closure node carries the profile.
//
// The feature parameters are still pruned per instance -- that was the only reason feature selection
// had to be static, and it still is. GetVisibleMaterialParametersFromExpression descends the taken
// side of a static switch and no other, so an instance shows the eleven-odd rows of the feature it
// picked rather than all ninety-six.
//
// The thirteen leaves are written out rather than factored. A GraphFunction cannot take or return a
// Substrate value (DreamShader Docs/language/graph-function.md:44 and :183), and a #define here is a
// named value for #if to test, never a macro (Docs/language/preprocessor.md:299) -- so there is
// nothing to factor them into. What keeps them identical is that each reads the same Surf_* locals.

import "Shared/ToonFeatureSignatures.dsh";
import "Shared/ToonFunctions.dsh";

VirtualFunction(Name="MF_MoonToonBaseInput")
{
	Options = {
		Asset = Path(Plugins.MoonToon, "MaterialFunctions/MF_MoonToonBaseInput");
		Description = "Generated from /MoonToon/MaterialFunctions/MF_MoonToonBaseInput.MF_MoonToonBaseInput";
	}

	Inputs = {
	}

	// Restated by hand, and it must stay in step with MF_MoonToonBaseInput's own Outputs block: a
	// missing entry is an "OutputIndex is out of range" build error, and a REORDERED one is worse,
	// because these names are what Output="..." resolves against.
	Outputs = {
		MaterialAttributes Output;
		float4 ToonBufferA;
		float4 ToonBufferB;
		float4 ToonBufferC;
		float4 FaceOverlayData;
		float4 FaceOverlayParams;
		float4 FaceOverlayStencilIDs;
		float4 ModifierData;
		float ModifierID;
		// The Substrate lane. Everything above it is the legacy (r.Substrate=0) shape and this
		// material reads none of it except the three face-overlay float4s, which are storage
		// independent.
		float3 OutBaseColor;
		float  OutMetallic;
		float  OutSpecular;
		float  OutRoughness;
		float3 OutNormal;
		float3 OutEmissiveColor;
		float  OutAnisotropy;
		float3 OutTangent;
		float  OutOpacity;
		float  OutOpacityMask;
		float  OutAmbientOcclusion;
		float2 OutCustomizedUV1;
		float2 OutCustomizedUV2;
		float  OutCustomData0;
		float3 OutMainLightShadowColor;
		float  OutDiffuseColorRampIndex;
		float  OutDiffuseRampUVOffset;
		float3 OutSpecularColor;
		float  OutSpecularColorRampIndex;
		float  OutSpecularRampUVOffset;
		float  OutReflectionIntensity;
		float  OutStencil;
		float  OutRayTracingShadowFlag;
		float  OutFacialShadowSdfLeft;
		float  OutFacialShadowSdfRight;
		float  OutKajiyaStrandShift;
		float4 OutGlobalMaskA;
		float4 OutGlobalMaskB;
		float4 OutGlobalMaskC;
		float  OutStockingsThickness;
		float3 OutStockingsSkinColor;
		float  FaceOverlayOccluderClass;
		float  FaceOverlayPart;
		float  FaceOverlayThickness;
	}
}

// Retired along with the dithered-translucency call in Graph. Uncomment BOTH together if the old
// look is ever needed again.
// VirtualFunction(Name="MF_MoonToonTranslucencyShadow")
// {
// 	Options = {
// 		Asset = Path(Plugins.MoonToon, "MaterialFunctions/MF_MoonToonTranslucencyShadow");
// 		Description = "Generated from /MoonToon/MaterialFunctions/MF_MoonToonTranslucencyShadow.MF_MoonToonTranslucencyShadow";
// 	}
//
// 	Inputs = {
// 		MaterialAttributes In;
// 	}
//
// 	Outputs = {
// 		MaterialAttributes Result;
// 	}
// }

// The closure's COVERAGE weight, decided by the material's blend mode at shader-compile time.
//
// Under Substrate a translucent blend takes its alpha from the closure's coverage; the root's Opacity
// pin is ignored for BLEND_Translucent and only read for AlphaComposite -- and only when the PARENT
// material's own blend mode is AlphaComposite (UMaterial::IsPropertyActive), so an instance's blend-mode
// override never reaches it. The legacy bridge folded Opacity into coverage on its way to the hidden
// closure; the node form has to say so itself, or every translucent instance renders at coverage 1.
//
// It must NOT apply to opaque and masked instances: their "Opacity" is the base colour map's alpha
// by default ("Opacity From Base Color Map"), which is not 1 everywhere on production textures, and
// a coverage below 1 on an opaque closure darkens it. The graph cannot see the blend mode, but the
// shader can: MATERIALBLENDING_* are compile-time defines of every material permutation, including
// the ones an instance's blend-mode override produces, so this Custom node is the one place that
// can make the weight a no-op for opaque and the opacity for translucent.
Function float MoonToonCoverageWeight(in float Opacity)
{
#if MATERIALBLENDING_TRANSLUCENT || MATERIALBLENDING_ADDITIVE || MATERIALBLENDING_ALPHACOMPOSITE
	return Opacity;
#else
	return 1.0f;
#endif
}

// Hair-tip translucency (T12 / G27, "Use Hair Tip Translucency"). One switch, two roles, and the
// blend mode picks the role the same way MoonToonCoverageWeight does:
//   opaque / masked (the section's own material) -- the CUT: the tip leaves OpacityMask, so the
//     masked base pass, depth and the inner lines all see the fringe without its ends;
//   translucent (a child instance set as the slot's Overlay Material) -- the REDRAW: only the tip
//     has opacity. Every vertex below the tip threshold is pushed back along its own camera ray --
//     the screen footprint does not move, only the depth -- so it sits behind the opaque section it
//     duplicates: the translucent pass rejects it at the depth test (no forward shading for the
//     whole fringe at opacity 0) and the toon translucent prepass, which ignores opacity, records it
//     as hidden rather than as a layer in front.
Function float MoonToonHairTipOpacity(in float Opacity, in float Tip, in float TipOpacity)
{
#if MATERIALBLENDING_TRANSLUCENT || MATERIALBLENDING_ADDITIVE || MATERIALBLENDING_ALPHACOMPOSITE
	return Opacity * Tip * TipOpacity;
#else
	return Opacity;
#endif
}

Function float MoonToonHairTipCut(in float OpacityMask, in float Tip)
{
#if MATERIALBLENDING_TRANSLUCENT || MATERIALBLENDING_ADDITIVE || MATERIALBLENDING_ALPHACOMPOSITE
	return OpacityMask;
#else
	return OpacityMask * (1.0f - Tip);
#endif
}

Function float3 MoonToonHairTipPush(in float3 AwayFromCamera, in float Keep, in float Push)
{
#if MATERIALBLENDING_TRANSLUCENT || MATERIALBLENDING_ADDITIVE || MATERIALBLENDING_ALPHACOMPOSITE
	return AwayFromCamera * (Push * (1.0f - Keep));
#else
	return float3(0.0f, 0.0f, 0.0f);
#endif
}

Shader(Name="Materials/Core/M_MoonToon", Root="Plugin.MoonToon")
{
	Settings = {
		// A real node graph rather than the default thin-custom material, so the base stays
		// openable in the Material Editor.
		Backend      = "Graph";
		Domain       = "Surface";
		// No ShadingModel line: binding Base.FrontMaterial force-sets the material to Substrate, and
		// SubstrateMoonToonBSDF registers SSM_Toon, which the engine folds back to MSM_Toon for every
		// toon gate. Writing anything but "Substrate" here is DSH8045.

		// The per-pin form has no MaterialAttributes struct to carry the customised UVs: UMaterial
		// compiles CustomizedUV[i] only for i < NumCustomizedUVs and passes the raw vertex UV through
		// otherwise. MF_MoonToonBaseInput moves the head-forward / hair tangent from the vertex stage
		// to the pixel stage through CustomizedUV1/2 (the Tangent pin reads TexCoords[1].xy +
		// TexCoords[2].x back), so the SDF facial shadow needs UV1 and UV2 compiled -- 3 covers
		// UV0..UV2. The attributes form got this for free.
		NumCustomizedUVs = 3;
		BlendMode    = "Opaque";

		// Real translucency (engine-side ToonTranslucent). A translucent MI of this base gets:
		//   - per-pixel forward toon shading   (this setting -- ToonBxDF only runs per pixel here;
		//     the default VolumetricNonDirectional never reaches it, and the engine logs a warning)
		//   - single-layer coverage            (Moon_MeshPass_ToonTranslucentPrepass, automatic)
		//   - inner lines composited after the fill, opacity-independent
		//   - premultiplied specular so highlights outlive a thin body -- use BlendMode
		//     AlphaComposite on the MI for that; plain Translucent fades highlights with the body
		// Opacity is already routed from MF_MoonToonBaseInput ("Opacity" x "Opacity Map"), so a
		// translucent MI needs no graph change -- only the blend-mode override.
		TranslucencyLightingMode   = "SurfacePerPixelLighting";
		bOutputTranslucentVelocity = true;

		// Dithered masked translucency (the pre-ToonTranslucent approach) is retired -- see the
		// commented-out MF_MoonToonTranslucencyShadow call in Graph below.
		// DitherOpacityMask       = true;

		bUsedWithSkeletalMesh = true;
		bUsedWithMorphTargets = true;
		bUsedWithNanite       = true;
	}

	Properties = {
		// The fourteen "pick one" static switches, declared here because the closure chain they cut
		// is here. Every ParameterName, Group, SortPriority and Description is verbatim what
		// MF_MoonToonFeatureSelect / MF_MoonToonModifierSelect declare (both generated by
		// Tools/gen_feature_functions.py) -- the ParameterName is what makes a switch declared in two
		// places ONE material parameter, which is how the 207 production instances keep their
		// overrides. Three of them are declared a third time in MF_MoonToonBaseInput, where they also
		// gate the tangent / CustomizedUV decode; that has always been so.
		//
		// Order is priority order: the first one ticked wins, because it is the outermost switch in
		// the chain below. Nothing ticked = Kind Default = plain toon.
		StaticSwitchParameter Is_PBRSpecular = false [ParameterName="Is PBRSpecular"; Group="30 - Shading Feature (pick one)"; SortPriority=0; Description="启用 PBR Specular 着色特征. 只应勾选一个; 若勾了多个, 本文件中靠前的胜出. 一个都不勾 = 普通 toon. 勾选后, 未选中特征的参数会从材质实例面板里消失(静态开关会裁掉未走的分支)."];
		StaticSwitchParameter Is_KajiyaHair = false [ParameterName="Is KajiyaHair"; Group="30 - Shading Feature (pick one)"; SortPriority=1; Description="启用 Hair Kajiya Kay 着色特征. 只应勾选一个; 若勾了多个, 本文件中靠前的胜出. 一个都不勾 = 普通 toon. 勾选后, 未选中特征的参数会从材质实例面板里消失(静态开关会裁掉未走的分支)."];
		StaticSwitchParameter Is_ToonKajiyaHair = false [ParameterName="Is ToonKajiyaHair"; Group="30 - Shading Feature (pick one)"; SortPriority=2; Description="启用 Hair Toon Kajiya Kay 着色特征. 只应勾选一个; 若勾了多个, 本文件中靠前的胜出. 一个都不勾 = 普通 toon. 勾选后, 未选中特征的参数会从材质实例面板里消失(静态开关会裁掉未走的分支)."];
		StaticSwitchParameter Is_DFFacialShadow = false [ParameterName="Is DFFacialShadow"; Group="30 - Shading Feature (pick one)"; SortPriority=3; Description="启用 SDF Face 着色特征. 只应勾选一个; 若勾了多个, 本文件中靠前的胜出. 一个都不勾 = 普通 toon. 勾选后, 未选中特征的参数会从材质实例面板里消失(静态开关会裁掉未走的分支)."];
		StaticSwitchParameter Use_Full_Angle_SDF = false [ParameterName="Use Full Angle SDF"; Group="32 - SDF Face|Full Angle"; SortPriority=-1; Description="(配合 Is DFFacialShadow) 脸部阴影改用全角度 SDF 图集(Tools/SDF360 烘焙, T18): 材质按关键光(含灯光装配/脸角度覆盖)求值, 主干直接用结果, 顶光/底光/背光都对. 图集参数从 sdf360.json 抄.\r\n(With Is DFFacialShadow) the face shadow from a full-angle SDF atlas (Tools/SDF360, T18): evaluated in the material for the key light (light rig and face override included), used by the trunk as is, so top, bottom and back light all work."];
		StaticSwitchParameter Is_AngelRing = false [ParameterName="Is AngelRing"; Group="30 - Shading Feature (pick one)"; SortPriority=4; Description="启用新天使环(鸣潮/异环式, T17): 材质函数 MF_ToonAngelRing 算出环的颜色和暗带, 主干只对主光求值(阴影下限、光色/固定色、暗带压暗漫反射). 只应勾选一个; 勾了多个时靠前的胜出. 旧的 Is HairHighlightMask 可用 Tools/AngelRing/migrate_hair_highlight_mask.py 迁移过来.\r\nThe new angel ring (T17): MF_ToonAngelRing paints the ring and its dark band; the trunk evaluates them on the main light only (shadow floor, light colour or fixed colour, the band darkening the diffuse)."];
		StaticSwitchParameter Is_HairHighlightMask = false [ParameterName="Is HairHighlightMask"; Group="30 - Shading Feature (pick one)"; SortPriority=4; Description="启用 Hair Highlight Mask 着色特征. 只应勾选一个; 若勾了多个, 本文件中靠前的胜出. 一个都不勾 = 普通 toon. 勾选后, 未选中特征的参数会从材质实例面板里消失(静态开关会裁掉未走的分支)."];
		StaticSwitchParameter Is_Skin = false [ParameterName="Is Skin"; Group="30 - Shading Feature (pick one)"; SortPriority=5; Description="启用 Skin 着色特征. 只应勾选一个; 若勾了多个, 本文件中靠前的胜出. 一个都不勾 = 普通 toon. 勾选后, 未选中特征的参数会从材质实例面板里消失(静态开关会裁掉未走的分支)."];
		StaticSwitchParameter Is_Stockings = false [ParameterName="Is Stockings"; Group="30 - Shading Feature (pick one)"; SortPriority=6; Description="启用 Stockings 着色特征. 只应勾选一个; 若勾了多个, 本文件中靠前的胜出. 一个都不勾 = 普通 toon. 勾选后, 未选中特征的参数会从材质实例面板里消失(静态开关会裁掉未走的分支)."];
		StaticSwitchParameter Is_NPRStockings = false [ParameterName="Is NPRStockings"; Group="30 - Shading Feature (pick one)"; SortPriority=7; Description="启用 Stockings 着色特征. 只应勾选一个; 若勾了多个, 本文件中靠前的胜出. 一个都不勾 = 普通 toon. 勾选后, 未选中特征的参数会从材质实例面板里消失(静态开关会裁掉未走的分支)."];
		StaticSwitchParameter Is_Eye = false [ParameterName="Is Eye"; Group="30 - Shading Feature (pick one)"; SortPriority=8; Description="启用 Eye 着色特征. 只应勾选一个; 若勾了多个, 本文件中靠前的胜出. 一个都不勾 = 普通 toon. 勾选后, 未选中特征的参数会从材质实例面板里消失(静态开关会裁掉未走的分支)."];
		StaticSwitchParameter Is_ClothVelvet = false [ParameterName="Is ClothVelvet"; Group="30 - Shading Feature (pick one)"; SortPriority=9; Description="启用 Cloth Velvet 着色特征. 只应勾选一个; 若勾了多个, 本文件中靠前的胜出. 一个都不勾 = 普通 toon. 勾选后, 未选中特征的参数会从材质实例面板里消失(静态开关会裁掉未走的分支)."];
		StaticSwitchParameter Is_ToonMetal = false [ParameterName="Is ToonMetal"; Group="30 - Shading Feature (pick one)"; SortPriority=10; Description="启用 Metal 着色特征. 只应勾选一个; 若勾了多个, 本文件中靠前的胜出. 一个都不勾 = 普通 toon. 勾选后, 未选中特征的参数会从材质实例面板里消失(静态开关会裁掉未走的分支)."];
		StaticSwitchParameter Is_EmissiveInk = false [ParameterName="Is EmissiveInk"; Group="30 - Shading Feature (pick one)"; SortPriority=11; Description="启用 Emissive Ink 着色特征. 只应勾选一个; 若勾了多个, 本文件中靠前的胜出. 一个都不勾 = 普通 toon. 勾选后, 未选中特征的参数会从材质实例面板里消失(静态开关会裁掉未走的分支)."];

		// The MODIFIER axis, the second static choice. A modifier is ADDED on top of whichever
		// feature was picked, so it does not compete for the 30 group's single slot.
		StaticSwitchParameter Is_Modifier_Matcap = false [ParameterName="Is Modifier Matcap"; Group="43 - Modifier (pick one)"; SortPriority=0; Description="启用 Matcap 修饰层. 修饰层叠加在着色特征之上, 与任意特征共存 —— 它不占 30 组的单选. 只应勾选一个; 若勾了多个, 本文件中靠前的胜出. 一个都不勾 = 无修饰层, 在面板和着色器里都不花代价."];
		// Coplanar layers: imported characters often carry a decal-like section (a forehead mark, blush,
		// a tattoo) whose triangles are an exact copy of the skin under it. Both surfaces then have the
		// same depth to the last bit and the depth test flips between them frame to frame -- the
		// flicker. The fix belongs on the LAYER: nudge it toward the camera by a hair. A static switch,
		// so every other instance keeps a constant-zero WPO that the translator folds away.
		ScalarParameter Coplanar_Depth_Bias = 0.05 [ParameterName="Coplanar Depth Bias"; Group="14 - Coplanar Layer"; SortPriority=1; Description="(配合 Use Coplanar Depth Bias) 这个材质的顶点沿指向相机的方向前移的距离, cm. 用于和皮肤完全共面的贴片层(额头印记/腮红/纹身)消除深度打架造成的闪烁. 0.02~0.1 足够, 太大会在侧视时看出贴片浮起.\r\n(With Use Coplanar Depth Bias) how far, in cm, this material's vertices move toward the camera. For decal-like layers that sit exactly on the skin (a forehead mark, blush, a tattoo), which otherwise z-fight with it and flicker."];
		StaticSwitchParameter Use_Coplanar_Depth_Bias = false [ParameterName="Use Coplanar Depth Bias"; Group="14 - Coplanar Layer"; SortPriority=0; Description="把这个材质当作共面贴片层: 顶点朝相机前移 Coplanar Depth Bias, 消除和下面皮肤的深度打架(闪烁). 只给贴片层开, 不要给皮肤本体开.\r\nTreat this material as a coplanar layer: its vertices move toward the camera by Coplanar Depth Bias so it stops z-fighting (flickering) with the surface under it. Enable on the layer, never on the skin itself."];
		StaticSwitchParameter Use_Sheer_Dither = false [ParameterName="Use Sheer Dither"; Group="21 - Translucency"; SortPriority=40; Description="薄纱镂空(鸣潮纱袖的做法): 材质仍是不透明 GBuffer, 每帧按屏幕位置丢掉一部分像素, 交给 TSR 时间累积成半透明. 覆盖率 = Opacity x Opacity Map(即原 OpacityMask), 1 = 不透. 只在 Blend Mode 覆盖为 Masked 的实例上生效; 阴影 pass 不抖动, 仍用 Shadow Opacity. 代价: 写满深度和速度, 快速运动/切镜会有噪点拖影.\r\nSheer screen-door (the Wuthering Waves sleeve technique): the surface stays an opaque GBuffer write, a per-frame screen-space pattern discards part of it, and TSR accumulates the holes into translucency. Coverage = Opacity x Opacity Map (the usual OpacityMask), 1 = solid. Needs the instance's Blend Mode overridden to Masked; the shadow pass is not dithered and keeps Shadow Opacity."];
		StaticSwitchParameter Use_Hair_Tip_Translucency = false [ParameterName="Use Hair Tip Translucency"; Group="21 - Translucency|Hair Tip"; SortPriority=50; Description="发梢真半透明(终末地刘海的做法). 一张发梢遮罩(Hair Tip Mask), 两个实例: 头发本身的实例(Blend Mode 覆盖为 Masked)把发梢裁掉; 它的子实例 Blend Mode 覆盖为 Translucent, 设成该槽位的 Overlay Material(网格组件 Material Slots Overlay Material), 只画发梢、用底色贴图 alpha 混合, 眉眼从发梢透出来. 同一个开关, 角色由混合模式决定. 详见 MoonToon/Docs/HairTipTranslucency.md.\r\nHair-tip true translucency (the Arknights: Endfield fringe). One tip mask, two instances: the section's own instance (Blend Mode overridden to Masked) cuts the tips out; a child instance with Blend Mode overridden to Translucent, set as that slot's Overlay Material, draws only the tips, blended by the base colour alpha, so brows and eyes read through them. Same switch on both; the blend mode picks the role."];
		ScalarParameter Hair_Tip_Root_Opacity = 1.0 [ParameterName="Hair Tip Root Opacity"; Group="21 - Translucency|Hair Tip"; SortPriority=54; Description="(半透明重画)发梢根部(遮罩值 = 阈值处)的不透明度, 再乘底色 alpha. 保持 1 与不透明部分无缝衔接.\r\n(Translucent redraw) opacity where the tip begins (mask = threshold), times the base colour alpha. Keep 1 for a seamless join with the opaque part."];
		ScalarParameter Hair_Tip_End_Opacity = 1.0 [ParameterName="Hair Tip End Opacity"; Group="21 - Translucency|Hair Tip"; SortPriority=55; Description="(半透明重画)发梢末端(遮罩值 = 1 处)的不透明度, 再乘底色 alpha. 二值遮罩 + 底色 alpha(终末地)保持 1; 渐变遮罩可降到 0.6 左右(异环).\r\n(Translucent redraw) opacity at the very end (mask = 1), times the base colour alpha. 1 with a binary mask and an authored alpha (Endfield); about 0.6 with a gradient mask (NTE)."];
		ScalarParameter Hair_Tip_Casts_Shadow = 1.0 [ParameterName="Hair Tip Casts Shadow"; Group="21 - Translucency|Hair Tip"; SortPriority=56; Description="(不透明裁剪)发梢是否仍投影: 1 = 阴影 pass 不裁发梢(额头上的发影保持完整), 0 = 阴影也裁掉.\r\n(Opaque cut) whether the cut tips still cast shadows: 1 = the shadow pass keeps them, 0 = cut there too."];
		ScalarParameter Hair_Tip_Hidden_Push = 2.0 [ParameterName="Hair Tip Hidden Push"; Group="21 - Translucency|Hair Tip"; SortPriority=57; Description="(半透明重画)非发梢顶点沿视线往后推的距离, cm. 让重画的非发梢部分落到不透明头发后面: 不做前向着色, 也不被半透明预深度当成前景层. 远景描边/内线出问题时调大; 太大无害(屏幕位置不变).\r\n(Translucent redraw) how far, in cm, non-tip vertices move back along their camera ray, so the redraw's non-tip part sits behind the opaque section: no forward shading for it, and the translucent prepass does not take it for a front layer. Screen position is unchanged, so larger is harmless."];
		ScalarParameter Sheer_Emissive_Opaque = 1.0 [ParameterName="Sheer Emissive Opaque"; Group="21 - Translucency"; SortPriority=41; Description="(配合 Use Sheer Dither) 自发光亮度抬高覆盖率的倍数: 覆盖率 = max(OpacityMask, 自发光亮度 x 此值). 让闪点/发光花纹在薄纱上保持实心不被打孔. 0 = 关.\r\n(With Use Sheer Dither) how much emissive luminance raises coverage, so glitter and glowing patterns stay solid on the gauze. 0 = off."];
		// Effects (T09-T11, G05 / G06). One shared mask for every effect: which packed map and channel
		// say where the effects live. 0 = the whole material. Each effect is its own static switch below,
		// so an instance that ticks none compiles exactly what it compiled before.
		ScalarParameter FX_Mask_Source = 0.0 [ParameterName="FX Mask Source"; Group="50 - FX"; SortPriority=0; Description="特效作用区域取自哪张打包遮罩图: 0 = 整个材质, 1/2/3 = Global Mask Map 1/2/3(通道由 FX Mask Channel 决定). 所有特效共用这一个遮罩.\r\nWhere the effects live: 0 = the whole material, 1/2/3 = Global Mask Map 1/2/3 through FX Mask Channel. Shared by every effect."];
		ChannelMaskParameter FX_Mask_Channel = float4(1.0, 0.0, 0.0, 0.0) [ParameterName="FX Mask Channel"; Group="50 - FX"; SortPriority=1; MaskChannel=Red];
		StaticSwitchParameter Is_Modifier_OilFilm = false [ParameterName="Is Modifier Oil Film"; Group="43 - Modifier (pick one)"; SortPriority=1; Description="启用 Oil Film 修饰层. 修饰层叠加在着色特征之上, 与任意特征共存 —— 它不占 30 组的单选. 只应勾选一个; 若勾了多个, 本文件中靠前的胜出. 一个都不勾 = 无修饰层, 在面板和着色器里都不花代价."];
	}

	Outputs = {
		Substrate ToonClosure;
		Substrate ToonSurface;
		float  Opacity;
		float  OpacityMask;
		float  AmbientOcclusion;
		float2 CustomizedUV1;
		float2 CustomizedUV2;
		float  CustomData0;
		float  CustomData1;
		float4 FaceOverlay;
		float4 FaceOverlayTuning;
		float4 FaceOverlayStencils;
		float  FaceOverlayOccluder;
		float  FaceOverlayPart;
		float  FaceOverlayThickness;
		float3 WorldPositionOffset;

		// The one shading wire. Everything the renderer needs to shade this pixel is inside it.
		Base.FrontMaterial = ToonSurface;

		// The root pins a closure does not carry. Opacity and OpacityMask are the blend, not the
		// surface; the customised UVs are a vertex-to-pixel channel; CustomData0 is the ray tracing
		// payload (FMoonCustomPayload: the self-shadow and cast-shadow-on-toon bits plus the
		// stencil), which the hit shaders read off the root on both storages.
		Base.Opacity          = Opacity;
		Base.OpacityMask      = OpacityMask;
		Base.AmbientOcclusion = AmbientOcclusion;
		Base.CustomizedUV1    = CustomizedUV1;
		Base.CustomizedUV2    = CustomizedUV2;
		Base.CustomData0      = CustomData0;
		Base.CustomData1      = CustomData1;
		Base.WorldPositionOffset = WorldPositionOffset;

		Expression(Class="MoonToonFaceOverlay").Pin[0] = FaceOverlay;
		Expression(Class="MoonToonFaceOverlay").Pin[1] = FaceOverlayTuning;
		Expression(Class="MoonToonFaceOverlay").Pin[2] = FaceOverlayStencils;
		Expression(Class="MoonToonFaceOverlay").Pin[3] = FaceOverlayOccluder;
		Expression(Class="MoonToonFaceOverlay").Pin[4] = FaceOverlayPart;
		Expression(Class="MoonToonFaceOverlay").Pin[5] = FaceOverlayThickness;
	}

	Graph = {
		#Region "Authored surface"
		// One call, read many times: a VirtualFunction call with the same argument list is served
		// from the graph builder's reuse cache, so MF_MoonToonBaseInput is one node in the generated
		// asset however many of its outputs are read here.
		float3 Surf_BaseColorAuthored      = MF_MoonToonBaseInput(Output="OutBaseColor");
		float  Surf_Metallic               = MF_MoonToonBaseInput(Output="OutMetallic");
		float  Surf_SpecularAuthored       = MF_MoonToonBaseInput(Output="OutSpecular");
		float  Surf_RoughnessAuthored      = MF_MoonToonBaseInput(Output="OutRoughness");
		float3 Surf_Normal                 = MF_MoonToonBaseInput(Output="OutNormal");
		float3 Surf_EmissiveColorAuthored  = MF_MoonToonBaseInput(Output="OutEmissiveColor");
		float  Surf_Anisotropy             = MF_MoonToonBaseInput(Output="OutAnisotropy");
		float3 Surf_Tangent                = MF_MoonToonBaseInput(Output="OutTangent");

		float3 Surf_MainLightShadowColorAuthored = MF_MoonToonBaseInput(Output="OutMainLightShadowColor");
		float  Surf_DiffuseColorRampIndex  = MF_MoonToonBaseInput(Output="OutDiffuseColorRampIndex");
		float  Surf_DiffuseRampUVOffset    = MF_MoonToonBaseInput(Output="OutDiffuseRampUVOffset");
		float3 Surf_SpecularColor          = MF_MoonToonBaseInput(Output="OutSpecularColor");
		float  Surf_SpecularColorRampIndex = MF_MoonToonBaseInput(Output="OutSpecularColorRampIndex");
		float  Surf_SpecularRampUVOffset   = MF_MoonToonBaseInput(Output="OutSpecularRampUVOffset");
		float  Surf_ReflectionIntensity    = MF_MoonToonBaseInput(Output="OutReflectionIntensity");
		float  Surf_Stencil                = MF_MoonToonBaseInput(Output="OutStencil");
		float  Surf_RayTracingShadowFlag   = MF_MoonToonBaseInput(Output="OutRayTracingShadowFlag");
		float  Surf_FacialShadowSdfLeft    = MF_MoonToonBaseInput(Output="OutFacialShadowSdfLeft");
		float  Surf_FacialShadowSdfRight   = MF_MoonToonBaseInput(Output="OutFacialShadowSdfRight");

		// What the feature functions need from the base input. These used to be the inputs of
		// MF_MoonToonFeatureSelect, the function this chain replaces.
		float  Surf_KajiyaStrandShift      = MF_MoonToonBaseInput(Output="OutKajiyaStrandShift");
		float4 Surf_GlobalMaskA            = MF_MoonToonBaseInput(Output="OutGlobalMaskA");
		float4 Surf_GlobalMaskB            = MF_MoonToonBaseInput(Output="OutGlobalMaskB");
		float4 Surf_GlobalMaskC            = MF_MoonToonBaseInput(Output="OutGlobalMaskC");
		float  Surf_StockingsThickness     = MF_MoonToonBaseInput(Output="OutStockingsThickness");
		float3 Surf_StockingsSkinColor     = MF_MoonToonBaseInput(Output="OutStockingsSkinColor");

		#Region "FX (T09-T11)"
		// Effects (G05 / G06), each behind its own static switch, all reading one shared mask. Every
		// stage below passes the previous value through untouched when its switch is off -- a culled
		// branch, not a multiply by one -- so an instance with no effect ticked compiles to exactly the
		// graph it had before. Order: base colour (view hue -> wet -> hologram), emissive (each effect
		// adds, flicker last), coverage (reveal / dissolve / hologram cut, applied at Opacity below).
		float2 FX_UV = UE.Expression(Class="TextureCoordinate", OutputType="float2", CoordinateIndex=0);
		float4 FX_MaskMap = float4(1.0, 1.0, 1.0, 1.0);
		SelectGlobalMaskMap(Surf_GlobalMaskA, Surf_GlobalMaskB, Surf_GlobalMaskC, FX_Mask_Source, FX_MaskMap);
		float FX_Mask = FX_Mask_Channel(Input = FX_MaskMap);

		float3 FX_Base_Hue = UE.Expression(
				Class="StaticSwitchParameter",
				OutputType="float3",
				True=MF_ToonFX_ViewHueShift(Surf_BaseColorAuthored, float3(0.0, 0.0, 0.0), FX_UV, FX_Mask),
				False=Surf_BaseColorAuthored,
				ParameterName="Use FX View Hue Shift",
				Group="50 - FX",
				SortPriority=10,
				Desc="镭射/视角色相旋转(鸣潮镭射): 按 N.V 旋转底色色相.\r\nView-dependent hue rotation of the base colour (foil)."
			);
		float3 FX_Base_Wet = UE.Expression(
				Class="StaticSwitchParameter",
				OutputType="float3",
				True=MF_ToonFX_Wet(FX_Base_Hue, Surf_RoughnessAuthored, Surf_SpecularAuthored, float3(0.0, 0.0, 0.0), FX_Mask, Output="Result"),
				False=FX_Base_Hue,
				ParameterName="Use FX Wet",
				Group="50 - FX",
				SortPriority=20,
				Desc="湿身(异环雨水): 底色变暗、粗糙度降低、高光增强、竖直面上流下雨痕.\r\nWet surface: darker, glossier, with rain streaks on vertical faces."
			);
		float  Surf_Roughness = UE.Expression(
				Class="StaticSwitchParameter",
				OutputType="float",
				True=MF_ToonFX_Wet(FX_Base_Hue, Surf_RoughnessAuthored, Surf_SpecularAuthored, float3(0.0, 0.0, 0.0), FX_Mask, Output="RoughnessOut"),
				False=Surf_RoughnessAuthored,
				ParameterName="Use FX Wet",
				Group="50 - FX",
				SortPriority=20
			);
		float  Surf_Specular = UE.Expression(
				Class="StaticSwitchParameter",
				OutputType="float",
				True=MF_ToonFX_Wet(FX_Base_Hue, Surf_RoughnessAuthored, Surf_SpecularAuthored, float3(0.0, 0.0, 0.0), FX_Mask, Output="SpecularOut"),
				False=Surf_SpecularAuthored,
				ParameterName="Use FX Wet",
				Group="50 - FX",
				SortPriority=20
			);
		float3 Surf_BaseColor = UE.Expression(
				Class="StaticSwitchParameter",
				OutputType="float3",
				True=MF_ToonFX_Hologram(FX_Base_Wet, float3(0.0, 0.0, 0.0), FX_Mask, Output="BaseColorOut"),
				False=FX_Base_Wet,
				ParameterName="Use FX Hologram",
				Group="50 - FX",
				SortPriority=30,
				Desc="全息(少前2): 扫描线 + 边缘发光 + 闪烁, 底色压暗, 扫描线之间降低覆盖率.\r\nHologram: scan lines, rim glow, flicker; darker base, lower coverage between the lines."
			);

		float3 FX_Emissive_Glitter = UE.Expression(
				Class="StaticSwitchParameter",
				OutputType="float3",
				True=(Surf_EmissiveColorAuthored + MF_ToonFX_Glitter(FX_UV, Surf_BaseColor, FX_Mask, 1.0, Output="Result")),
				False=Surf_EmissiveColorAuthored,
				ParameterName="Use FX Glitter",
				Group="50 - FX",
				SortPriority=40,
				Desc="闪点(鸣潮纱袍): 两层点阵 + 视差 + 时间滚动, 视角一动就闪.\r\nGlitter: two dot layers with view parallax; sparkles when the view moves."
			);
		float3 FX_Emissive_Flow = UE.Expression(
				Class="StaticSwitchParameter",
				OutputType="float3",
				True=(FX_Emissive_Glitter + MF_ToonFX_FlowLight(FX_UV, FX_Mask)),
				False=FX_Emissive_Glitter,
				ParameterName="Use FX Flow Light",
				Group="50 - FX",
				SortPriority=50,
				Desc="流光(鸣潮): 焦散纹理按时间滚动、自扭曲, 进自发光.\r\nFlow light: a scrolling, self-distorted caustic in the emissive."
			);
		float3 FX_Emissive_Reveal = UE.Expression(
				Class="StaticSwitchParameter",
				OutputType="float3",
				True=(FX_Emissive_Flow + MF_ToonFX_Reveal(FX_UV, FX_Mask, Output="Result")),
				False=FX_Emissive_Flow,
				ParameterName="Use FX Reveal",
				Group="50 - FX",
				SortPriority=60,
				Desc="显现(鸣潮额饰): 按顺序图和进度显现, 边缘带噪声发光.\r\nReveal: appears along an order map by Progress, with a noisy glowing edge."
			);
		float3 FX_Emissive_Pulse = UE.Expression(
				Class="StaticSwitchParameter",
				OutputType="float3",
				True=(FX_Emissive_Reveal + MF_ToonFX_Pulse(Surf_BaseColor, FX_Mask)),
				False=FX_Emissive_Reveal,
				ParameterName="Use FX Pulse",
				Group="50 - FX",
				SortPriority=70,
				Desc="脉冲(鸣潮宝石): 底色 x 颜色的自发光随时间呼吸.\r\nPulse: base colour x colour emissive breathing over time."
			);
		float3 FX_Emissive_Dissolve = UE.Expression(
				Class="StaticSwitchParameter",
				OutputType="float3",
				True=(FX_Emissive_Pulse + MF_ToonFX_Dissolve(FX_UV, FX_Mask, Output="Result")),
				False=FX_Emissive_Pulse,
				ParameterName="Use FX Dissolve",
				Group="50 - FX",
				SortPriority=80,
				Desc="溶解(异环): 噪声/高度溶解, 边缘发光, 溶掉的地方裁掉.\r\nDissolve: noise / height dissolve with a glowing edge; the dissolved part is cut."
			);
		float3 FX_Emissive_Hologram = UE.Expression(
				Class="StaticSwitchParameter",
				OutputType="float3",
				True=(FX_Emissive_Dissolve + MF_ToonFX_Hologram(FX_Base_Wet, float3(0.0, 0.0, 0.0), FX_Mask, Output="Result")),
				False=FX_Emissive_Dissolve,
				ParameterName="Use FX Hologram",
				Group="50 - FX",
				SortPriority=30
			);
		float3 Surf_EmissiveColor = UE.Expression(
				Class="StaticSwitchParameter",
				OutputType="float3",
				True=MF_ToonFX_Flicker(FX_Emissive_Hologram, FX_UV, FX_Mask),
				False=FX_Emissive_Hologram,
				ParameterName="Use FX Flicker",
				Group="50 - FX",
				SortPriority=90,
				Desc="闪烁: 自发光随机明灭, 可加随机亮点(鸣潮顶点闪烁).\r\nFlicker: the emissive blinks; optional random sparkles."
			);
		#EndRegion

		// Shadow colour LUT (T08 / G22): the shadow side's colour looked up from the albedo in a 32^3
		// LUT instead of one colour (Endfield's skin). Off by default; the culled branch leaves the
		// shadow colour exactly what the base input authored. Every leaf below reads this one local.
		float3 Surf_MainLightShadowColor =
			UE.Expression(
				Class="StaticSwitchParameter",
				OutputType="float3",
				True=MF_ToonShadowColorLUT(Surf_BaseColor, Surf_MainLightShadowColorAuthored),
				False=Surf_MainLightShadowColorAuthored,
				ParameterName="Use Shadow Color LUT",
				Group="10 - Diffuse|Shadow Color LUT",
				SortPriority=0,
				Desc="暗部颜色改为按底色查 3D LUT(终末地皮肤的做法): 色相、饱和度随底色变化, 比单色相乘更自然. 关 = 原来的 Shadow Color.\r\nLook the shadow-side colour up from the albedo in a 32^3 LUT (Endfield's skin). Off = the authored Shadow Color."
			);
		#EndRegion

		#Region "Modifier"
		// The modifier is feature-INDEPENDENT: it composes with whichever leaf the chain below picks,
		// so it is resolved once and handed to every leaf's two modifier pins.
		//
		// Two MoonToonModifier nodes per modifier rather than one, because the payload output is a
		// float4 and the id output a float, and UE.Expression's node-reuse key carries the declared
		// OutputType. The id node's channel pins are dead -- the node answers that output with a
		// compile-time constant -- so the second node costs nothing in the shader.
		float4 ModifierPayload_Matcap = UE.Expression(
			Class = "MoonToonModifier", OutputType = "float4", Output = "Modifier Payload",
			Modifier    = "Matcap",
			Color       = MF_ToonModifier_Matcap(Surf_Normal, Output="Color"),
			LightingMix = MF_ToonModifier_Matcap(Surf_Normal, Output="LightingMix"));
		float ModifierId_Matcap = UE.Expression(
			Class = "MoonToonModifier", OutputType = "float", Output = "Modifier Id",
			Modifier    = "Matcap",
			Color       = MF_ToonModifier_Matcap(Surf_Normal, Output="Color"),
			LightingMix = MF_ToonModifier_Matcap(Surf_Normal, Output="LightingMix"));

		float4 ModifierPayload_OilFilm = UE.Expression(
			Class = "MoonToonModifier", OutputType = "float4", Output = "Modifier Payload",
			Modifier       = "OilFilm",
			Intensity      = MF_ToonModifier_OilFilm(Output="Intensity"),
			HighlightScale = MF_ToonModifier_OilFilm(Output="HighlightScale"),
			FalloffPower   = MF_ToonModifier_OilFilm(Output="FalloffPower"),
			HueShift       = MF_ToonModifier_OilFilm(Output="HueShift"));
		float ModifierId_OilFilm = UE.Expression(
			Class = "MoonToonModifier", OutputType = "float", Output = "Modifier Id",
			Modifier       = "OilFilm",
			Intensity      = MF_ToonModifier_OilFilm(Output="Intensity"),
			HighlightScale = MF_ToonModifier_OilFilm(Output="HighlightScale"),
			FalloffPower   = MF_ToonModifier_OilFilm(Output="FalloffPower"),
			HueShift       = MF_ToonModifier_OilFilm(Output="HueShift"));

		// Nothing ticked is the normal state and it is free: id 0 is MOON_TOON_MODIFIER_ID_NONE,
		// which the engine's dispatcher answers with no module at all.
		float4 ModifierPayload = Is_Modifier_Matcap(
			True = ModifierPayload_Matcap,
			False = Is_Modifier_OilFilm(
				True = ModifierPayload_OilFilm,
				False = float4(0.0, 0.0, 0.0, 0.0)));
		float ModifierId = Is_Modifier_Matcap(
			True = ModifierId_Matcap,
			False = Is_Modifier_OilFilm(
				True = ModifierId_OilFilm,
				False = 0.0));
		#EndRegion

		#Region "Closure leaves"
		// One per legacy shading feature id, built from MOON_TOON_LEGACY_FEATURE_MAP
		// (Engine/Shaders/Shared/MoonToonFeatureRegistry.h): id -> Kind, Terms, Variants. The Moon
		// toon PROFILE is deliberately left off every node. A node with no profile still emits the
		// Guid-free profile scalar parameter, which is what lets a material INSTANCE attach one --
		// and the instance is where all 207 production materials would attach it.
		//
		// The eyebrow id (12) has no leaf: it routes to the Default module, shades as plain toon, and
		// has no selector switch to reach it with. The node's bEyebrow property is what would tag it,
		// and nothing authors that today -- the eyebrow-through-hair effect ships as the
		// MoonToonFaceOverlay custom output bound above.
		// 0 DEFAULT -- what a material with nothing ticked shades as.
		Substrate Leaf_Default = UE.Expression(
			Class = "SubstrateMoonToonBSDF", OutputType = "Substrate",
			Kind = "Default",
			BaseColor               = Surf_BaseColor,
			Metallic                = Surf_Metallic,
			Specular                = Surf_Specular,
			Roughness               = Surf_Roughness,
			Normal                  = Surf_Normal,
			Emissive_Color          = Surf_EmissiveColor,
			Anisotropy              = Surf_Anisotropy,
			Tangent                 = Surf_Tangent,
			Main_Light_Shadow_Color = Surf_MainLightShadowColor,
			Diffuse_Ramp_Index      = Surf_DiffuseColorRampIndex,
			Diffuse_Ramp_UV_Offset  = Surf_DiffuseRampUVOffset,
			Toon_Specular_Color     = Surf_SpecularColor,
			Specular_Ramp_Index     = Surf_SpecularColorRampIndex,
			Specular_Ramp_UV_Offset = Surf_SpecularRampUVOffset,
			Reflection_Intensity    = Surf_ReflectionIntensity,
			Stencil                 = Surf_Stencil,
			Ray_Tracing_Shadow_Flag = Surf_RayTracingShadowFlag,
			MultiBandCelEnable = MF_ToonFeature_Default(Output="MultiBandCelEnable"),
			TerminatorWidth    = MF_ToonFeature_Default(Output="TerminatorWidth"),
			BloomWeight        = MF_ToonFeature_Default(Output="BloomWeight"),
			Modifier_Payload        = ModifierPayload,
			Modifier_Id             = ModifierId);

		// 1 PBR_SPECULAR -- Kind Default + term PBR Specular. The base leaves the three
		// Default channels unconnected on purpose: the term writes the same lanes, and an
		// unconnected channel takes the slot table's own default rather than nothing.
		Substrate Base_PBRSpecular = UE.Expression(
			Class = "SubstrateMoonToonBSDF", OutputType = "Substrate",
			Kind = "Default",
			BaseColor               = Surf_BaseColor,
			Metallic                = Surf_Metallic,
			Specular                = Surf_Specular,
			Roughness               = Surf_Roughness,
			Normal                  = Surf_Normal,
			Emissive_Color          = Surf_EmissiveColor,
			Anisotropy              = Surf_Anisotropy,
			Tangent                 = Surf_Tangent,
			Main_Light_Shadow_Color = Surf_MainLightShadowColor,
			Diffuse_Ramp_Index      = Surf_DiffuseColorRampIndex,
			Diffuse_Ramp_UV_Offset  = Surf_DiffuseRampUVOffset,
			Toon_Specular_Color     = Surf_SpecularColor,
			Specular_Ramp_Index     = Surf_SpecularColorRampIndex,
			Specular_Ramp_UV_Offset = Surf_SpecularRampUVOffset,
			Reflection_Intensity    = Surf_ReflectionIntensity,
			Stencil                 = Surf_Stencil,
			Ray_Tracing_Shadow_Flag = Surf_RayTracingShadowFlag,
			Modifier_Payload        = ModifierPayload,
			Modifier_Id             = ModifierId);

		Substrate Leaf_PBRSpecular = UE.Expression(
			Class = "MoonToonFeature", OutputType = "Substrate",
			Term = "PBRSpecular",
			MoonToonMaterial = Base_PBRSpecular,
			BloomWeight = MF_ToonFeature_PBRSpecular(Output="BloomWeight"));

		// 2 KAJIYA_HAIR_SPECULAR -- Kind Default + term Hair Kajiya Kay.
		Substrate Base_KajiyaHair = UE.Expression(
			Class = "SubstrateMoonToonBSDF", OutputType = "Substrate",
			Kind = "Default",
			BaseColor               = Surf_BaseColor,
			Metallic                = Surf_Metallic,
			Specular                = Surf_Specular,
			Roughness               = Surf_Roughness,
			Normal                  = Surf_Normal,
			Emissive_Color          = Surf_EmissiveColor,
			Anisotropy              = Surf_Anisotropy,
			Tangent                 = Surf_Tangent,
			Main_Light_Shadow_Color = Surf_MainLightShadowColor,
			Diffuse_Ramp_Index      = Surf_DiffuseColorRampIndex,
			Diffuse_Ramp_UV_Offset  = Surf_DiffuseRampUVOffset,
			Toon_Specular_Color     = Surf_SpecularColor,
			Specular_Ramp_Index     = Surf_SpecularColorRampIndex,
			Specular_Ramp_UV_Offset = Surf_SpecularRampUVOffset,
			Reflection_Intensity    = Surf_ReflectionIntensity,
			Stencil                 = Surf_Stencil,
			Ray_Tracing_Shadow_Flag = Surf_RayTracingShadowFlag,
			Modifier_Payload        = ModifierPayload,
			Modifier_Id             = ModifierId);

		Substrate Leaf_KajiyaHair = UE.Expression(
			Class = "MoonToonFeature", OutputType = "Substrate",
			Term = "Kajiya",
			MoonToonMaterial = Base_KajiyaHair,
			TangentRotate       = MF_ToonFeature_KajiyaHair(Output="TangentRotate"),
			SecondaryShift      = MF_ToonFeature_KajiyaHair(Output="SecondaryShift"),
			SecondaryMask       = MF_ToonFeature_KajiyaHair(Output="SecondaryMask"),
			PrimaryShift        = MF_ToonFeature_KajiyaHair(Output="PrimaryShift"),
			PrimaryExpScale     = MF_ToonFeature_KajiyaHair(Output="PrimaryExpScale"),
			SecondaryExpScale   = MF_ToonFeature_KajiyaHair(Output="SecondaryExpScale"),
			OverallIntensity    = MF_ToonFeature_KajiyaHair(Output="OverallIntensity"),
			PrimaryIntensity    = MF_ToonFeature_KajiyaHair(Output="PrimaryIntensity"),
			SecondaryIntensity  = MF_ToonFeature_KajiyaHair(Output="SecondaryIntensity"),
			SecondaryShiftScale = MF_ToonFeature_KajiyaHair(Output="SecondaryShiftScale"),
			ShadowStrength      = MF_ToonFeature_KajiyaHair(Output="ShadowStrength"));

		// 5 TOON_KAJIYA_HAIR_SPECULAR -- the same term, toon-ramp VARIANT. The variant is
		// not a second pin: the Term enum spells it out as its own entry.
		Substrate Base_ToonKajiyaHair = UE.Expression(
			Class = "SubstrateMoonToonBSDF", OutputType = "Substrate",
			Kind = "Default",
			BaseColor               = Surf_BaseColor,
			Metallic                = Surf_Metallic,
			Specular                = Surf_Specular,
			Roughness               = Surf_Roughness,
			Normal                  = Surf_Normal,
			Emissive_Color          = Surf_EmissiveColor,
			Anisotropy              = Surf_Anisotropy,
			Tangent                 = Surf_Tangent,
			Main_Light_Shadow_Color = Surf_MainLightShadowColor,
			Diffuse_Ramp_Index      = Surf_DiffuseColorRampIndex,
			Diffuse_Ramp_UV_Offset  = Surf_DiffuseRampUVOffset,
			Toon_Specular_Color     = Surf_SpecularColor,
			Specular_Ramp_Index     = Surf_SpecularColorRampIndex,
			Specular_Ramp_UV_Offset = Surf_SpecularRampUVOffset,
			Reflection_Intensity    = Surf_ReflectionIntensity,
			Stencil                 = Surf_Stencil,
			Ray_Tracing_Shadow_Flag = Surf_RayTracingShadowFlag,
			Modifier_Payload        = ModifierPayload,
			Modifier_Id             = ModifierId);

		Substrate Leaf_ToonKajiyaHair = UE.Expression(
			Class = "MoonToonFeature", OutputType = "Substrate",
			Term = "KajiyaToon",
			MoonToonMaterial = Base_ToonKajiyaHair,
			TangentRotate       = MF_ToonFeature_ToonKajiyaHair(Surf_KajiyaStrandShift, Surf_KajiyaStrandShift, Output="TangentRotate"),
			SecondaryShift      = MF_ToonFeature_ToonKajiyaHair(Surf_KajiyaStrandShift, Surf_KajiyaStrandShift, Output="SecondaryShift"),
			SecondaryMask       = MF_ToonFeature_ToonKajiyaHair(Surf_KajiyaStrandShift, Surf_KajiyaStrandShift, Output="SecondaryMask"),
			PrimaryShift        = MF_ToonFeature_ToonKajiyaHair(Surf_KajiyaStrandShift, Surf_KajiyaStrandShift, Output="PrimaryShift"),
			PrimaryExpScale     = MF_ToonFeature_ToonKajiyaHair(Surf_KajiyaStrandShift, Surf_KajiyaStrandShift, Output="PrimaryExpScale"),
			SecondaryExpScale   = MF_ToonFeature_ToonKajiyaHair(Surf_KajiyaStrandShift, Surf_KajiyaStrandShift, Output="SecondaryExpScale"),
			OverallIntensity    = MF_ToonFeature_ToonKajiyaHair(Surf_KajiyaStrandShift, Surf_KajiyaStrandShift, Output="OverallIntensity"),
			PrimaryIntensity    = MF_ToonFeature_ToonKajiyaHair(Surf_KajiyaStrandShift, Surf_KajiyaStrandShift, Output="PrimaryIntensity"),
			SecondaryIntensity  = MF_ToonFeature_ToonKajiyaHair(Surf_KajiyaStrandShift, Surf_KajiyaStrandShift, Output="SecondaryIntensity"),
			SecondaryShiftScale = MF_ToonFeature_ToonKajiyaHair(Surf_KajiyaStrandShift, Surf_KajiyaStrandShift, Output="SecondaryShiftScale"),
			ShadowStrength      = MF_ToonFeature_ToonKajiyaHair(Surf_KajiyaStrandShift, Surf_KajiyaStrandShift, Output="ShadowStrength"));

		// 3 DISTANCE_FIELD_FACIAL_SHADOW -- Kind Skin with the SDF pair CONNECTED. Connecting
		// them is the switch; there is no second flag, which is what the old id-3-versus-id-6
		// pair could disagree about.
		Substrate Leaf_DFFacialShadow = UE.Expression(
			Class = "SubstrateMoonToonBSDF", OutputType = "Substrate",
			Kind = "Skin",
			BaseColor               = Surf_BaseColor,
			Metallic                = Surf_Metallic,
			Specular                = Surf_Specular,
			Roughness               = Surf_Roughness,
			Normal                  = Surf_Normal,
			Emissive_Color          = Surf_EmissiveColor,
			Anisotropy              = Surf_Anisotropy,
			Tangent                 = Surf_Tangent,
			Main_Light_Shadow_Color = Surf_MainLightShadowColor,
			Diffuse_Ramp_Index      = Surf_DiffuseColorRampIndex,
			Diffuse_Ramp_UV_Offset  = Surf_DiffuseRampUVOffset,
			Toon_Specular_Color     = Surf_SpecularColor,
			Specular_Ramp_Index     = Surf_SpecularColorRampIndex,
			Specular_Ramp_UV_Offset = Surf_SpecularRampUVOffset,
			Reflection_Intensity    = Surf_ReflectionIntensity,
			Stencil                 = Surf_Stencil,
			Ray_Tracing_Shadow_Flag = Surf_RayTracingShadowFlag,
			Facial_Shadow_SDF_Left  = Surf_FacialShadowSdfLeft,
			Facial_Shadow_SDF_Right = Surf_FacialShadowSdfRight,
			ScatterStrength         = MF_ToonFeature_DFFacialShadow(Output="ScatterStrength"),
			TransmissionStrength    = MF_ToonFeature_DFFacialShadow(Output="TransmissionStrength"),
			TransmissionPower       = MF_ToonFeature_DFFacialShadow(Output="TransmissionPower"),
			PrimaryRoughnessScale   = MF_ToonFeature_DFFacialShadow(Output="PrimaryRoughnessScale"),
			SecondaryRoughnessScale = MF_ToonFeature_DFFacialShadow(Output="SecondaryRoughnessScale"),
			SecondaryRampOffset     = MF_ToonFeature_DFFacialShadow(Output="SecondaryRampOffset"),
			OverallSpecIntensity    = MF_ToonFeature_DFFacialShadow(Output="OverallSpecIntensity"),
			PrimaryLobeIntensity    = MF_ToonFeature_DFFacialShadow(Output="PrimaryLobeIntensity"),
			SecondaryLobeIntensity  = MF_ToonFeature_DFFacialShadow(Output="SecondaryLobeIntensity"),
			SpecShadowStrength      = MF_ToonFeature_DFFacialShadow(Output="SpecShadowStrength"),
			WarmTintStrength        = MF_ToonFeature_DFFacialShadow(Output="WarmTintStrength"),
			Modifier_Payload        = ModifierPayload,
			Modifier_Id             = ModifierId);

		// 3b THE SAME FACE, FULL-ANGLE SDF (G26, R2 / T18). MF_ToonFullAngleSDF evaluates the baked
		// theta x phi atlas for the character's key light (MF_MoonToonKeyLight: the rig's face direction,
		// the scene main light without one) and the node is told the result is final
		// (bFacialShadowSdfPreEvaluated), so the trunk thresholds it at 0.5 for the main light instead of
		// splitting by azimuth. Head forward: the rig's head frame when the character has one, else the
		// baked face-forward the classic leaf uses (the Tangent pin).
		float3 SDF360_FaceDirection = MF_MoonToonKeyLight(Output="FaceDirection");
		float3 SDF360_HeadForward   = MF_MoonToonKeyLight(Output="HeadForward");
		float3 SDF360_HeadUp        = MF_MoonToonKeyLight(Output="HeadUp");
		float3 SDF360_Forward = lerp(Surf_Tangent, SDF360_HeadForward, step(0.5, dot(SDF360_HeadForward, SDF360_HeadForward)));
		float2 SDF360_UV = UE.Expression(Class="TextureCoordinate", OutputType="float2", CoordinateIndex=0);
		float Surf_FacialShadowSdf360 = MF_ToonFullAngleSDF(SDF360_UV, SDF360_FaceDirection, SDF360_Forward, SDF360_HeadUp);
		Substrate Leaf_DFFacialShadow360 = UE.Expression(
			Class = "SubstrateMoonToonBSDF", OutputType = "Substrate",
			Kind = "Skin",
			bFacialShadowSdfPreEvaluated = true,
			BaseColor               = Surf_BaseColor,
			Metallic                = Surf_Metallic,
			Specular                = Surf_Specular,
			Roughness               = Surf_Roughness,
			Normal                  = Surf_Normal,
			Emissive_Color          = Surf_EmissiveColor,
			Anisotropy              = Surf_Anisotropy,
			Tangent                 = Surf_Tangent,
			Main_Light_Shadow_Color = Surf_MainLightShadowColor,
			Diffuse_Ramp_Index      = Surf_DiffuseColorRampIndex,
			Diffuse_Ramp_UV_Offset  = Surf_DiffuseRampUVOffset,
			Toon_Specular_Color     = Surf_SpecularColor,
			Specular_Ramp_Index     = Surf_SpecularColorRampIndex,
			Specular_Ramp_UV_Offset = Surf_SpecularRampUVOffset,
			Reflection_Intensity    = Surf_ReflectionIntensity,
			Stencil                 = Surf_Stencil,
			Ray_Tracing_Shadow_Flag = Surf_RayTracingShadowFlag,
			Facial_Shadow_SDF_Left  = Surf_FacialShadowSdf360,
			Facial_Shadow_SDF_Right = Surf_FacialShadowSdf360,
			ScatterStrength         = MF_ToonFeature_DFFacialShadow(Output="ScatterStrength"),
			TransmissionStrength    = MF_ToonFeature_DFFacialShadow(Output="TransmissionStrength"),
			TransmissionPower       = MF_ToonFeature_DFFacialShadow(Output="TransmissionPower"),
			PrimaryRoughnessScale   = MF_ToonFeature_DFFacialShadow(Output="PrimaryRoughnessScale"),
			SecondaryRoughnessScale = MF_ToonFeature_DFFacialShadow(Output="SecondaryRoughnessScale"),
			SecondaryRampOffset     = MF_ToonFeature_DFFacialShadow(Output="SecondaryRampOffset"),
			OverallSpecIntensity    = MF_ToonFeature_DFFacialShadow(Output="OverallSpecIntensity"),
			PrimaryLobeIntensity    = MF_ToonFeature_DFFacialShadow(Output="PrimaryLobeIntensity"),
			SecondaryLobeIntensity  = MF_ToonFeature_DFFacialShadow(Output="SecondaryLobeIntensity"),
			SpecShadowStrength      = MF_ToonFeature_DFFacialShadow(Output="SpecShadowStrength"),
			WarmTintStrength        = MF_ToonFeature_DFFacialShadow(Output="WarmTintStrength"),
			Modifier_Payload        = ModifierPayload,
			Modifier_Id             = ModifierId);

		// 4 HAIR_HIGHLIGHT_MASK -- Kind Default + term Hair Highlight Mask.
		Substrate Base_HairHighlightMask = UE.Expression(
			Class = "SubstrateMoonToonBSDF", OutputType = "Substrate",
			Kind = "Default",
			BaseColor               = Surf_BaseColor,
			Metallic                = Surf_Metallic,
			Specular                = Surf_Specular,
			Roughness               = Surf_Roughness,
			Normal                  = Surf_Normal,
			Emissive_Color          = Surf_EmissiveColor,
			Anisotropy              = Surf_Anisotropy,
			Tangent                 = Surf_Tangent,
			Main_Light_Shadow_Color = Surf_MainLightShadowColor,
			Diffuse_Ramp_Index      = Surf_DiffuseColorRampIndex,
			Diffuse_Ramp_UV_Offset  = Surf_DiffuseRampUVOffset,
			Toon_Specular_Color     = Surf_SpecularColor,
			Specular_Ramp_Index     = Surf_SpecularColorRampIndex,
			Specular_Ramp_UV_Offset = Surf_SpecularRampUVOffset,
			Reflection_Intensity    = Surf_ReflectionIntensity,
			Stencil                 = Surf_Stencil,
			Ray_Tracing_Shadow_Flag = Surf_RayTracingShadowFlag,
			Modifier_Payload        = ModifierPayload,
			Modifier_Id             = ModifierId);

		Substrate Leaf_HairHighlightMask = UE.Expression(
			Class = "MoonToonFeature", OutputType = "Substrate",
			Term = "HairHighlightMask",
			MoonToonMaterial = Base_HairHighlightMask,
			Mask            = MF_ToonFeature_HairHighlightMask(Surf_GlobalMaskA, Surf_GlobalMaskB, Surf_GlobalMaskC, Output="Mask"),
			Intensity       = MF_ToonFeature_HairHighlightMask(Surf_GlobalMaskA, Surf_GlobalMaskB, Surf_GlobalMaskC, Output="Intensity"),
			ShadowIntensity = MF_ToonFeature_HairHighlightMask(Surf_GlobalMaskA, Surf_GlobalMaskB, Surf_GlobalMaskC, Output="ShadowIntensity"),
			ViewAnchorBlend = MF_ToonFeature_HairHighlightMask(Surf_GlobalMaskA, Surf_GlobalMaskB, Surf_GlobalMaskC, Output="ViewAnchorBlend"));

		// 4b ANGEL RING (G08, R2 / T17) -- Kind Default + term Angel Ring, i.e. the hair-mask term with
		// the angel-ring variant bit. MF_ToonAngelRing is evaluated once (the graph builder reuses the
		// call); every one of the five slots is wired, because the Feature node does not write an
		// unconnected term pin and ShadowFloor would otherwise inherit the Kind's ScalarC.
		float2 AngelRing_UV0 = UE.Expression(Class="TextureCoordinate", OutputType="float2", CoordinateIndex=0);
		float2 AngelRing_UV1 = UE.Expression(Class="TextureCoordinate", OutputType="float2", CoordinateIndex=1);
		Substrate Base_AngelRing = UE.Expression(
			Class = "SubstrateMoonToonBSDF", OutputType = "Substrate",
			Kind = "Default",
			BaseColor               = Surf_BaseColor,
			Metallic                = Surf_Metallic,
			Specular                = Surf_Specular,
			Roughness               = Surf_Roughness,
			Normal                  = Surf_Normal,
			Emissive_Color          = Surf_EmissiveColor,
			Anisotropy              = Surf_Anisotropy,
			Tangent                 = Surf_Tangent,
			Main_Light_Shadow_Color = Surf_MainLightShadowColor,
			Diffuse_Ramp_Index      = Surf_DiffuseColorRampIndex,
			Diffuse_Ramp_UV_Offset  = Surf_DiffuseRampUVOffset,
			Toon_Specular_Color     = Surf_SpecularColor,
			Specular_Ramp_Index     = Surf_SpecularColorRampIndex,
			Specular_Ramp_UV_Offset = Surf_SpecularRampUVOffset,
			Reflection_Intensity    = Surf_ReflectionIntensity,
			Stencil                 = Surf_Stencil,
			Ray_Tracing_Shadow_Flag = Surf_RayTracingShadowFlag,
			Modifier_Payload        = ModifierPayload,
			Modifier_Id             = ModifierId);

		Substrate Leaf_AngelRing = UE.Expression(
			Class = "MoonToonFeature", OutputType = "Substrate",
			Term = "AngelRing",
			MoonToonMaterial = Base_AngelRing,
			DarkBand    = MF_ToonAngelRing(float3(0.0, 0.0, 0.0), AngelRing_UV0, AngelRing_UV1, 1.0, float3(0.0, 0.0, 0.0), float3(0.0, 0.0, 0.0), float3(0.0, 0.0, 0.0), Output="DarkBand"),
			Intensity   = MF_ToonAngelRing(float3(0.0, 0.0, 0.0), AngelRing_UV0, AngelRing_UV1, 1.0, float3(0.0, 0.0, 0.0), float3(0.0, 0.0, 0.0), float3(0.0, 0.0, 0.0), Output="IntensityEncoded"),
			ShadowFloor = MF_ToonAngelRing(float3(0.0, 0.0, 0.0), AngelRing_UV0, AngelRing_UV1, 1.0, float3(0.0, 0.0, 0.0), float3(0.0, 0.0, 0.0), float3(0.0, 0.0, 0.0), Output="ShadowFloor"),
			ColorMode   = MF_ToonAngelRing(float3(0.0, 0.0, 0.0), AngelRing_UV0, AngelRing_UV1, 1.0, float3(0.0, 0.0, 0.0), float3(0.0, 0.0, 0.0), float3(0.0, 0.0, 0.0), Output="ColorMode"),
			RingColor   = MF_ToonAngelRing(float3(0.0, 0.0, 0.0), AngelRing_UV0, AngelRing_UV1, 1.0, float3(0.0, 0.0, 0.0), float3(0.0, 0.0, 0.0), float3(0.0, 0.0, 0.0), Output="RingColor"));

		// 6 SKIN -- the same Kind as the SDF face, without the pair wired.
		Substrate Leaf_Skin = UE.Expression(
			Class = "SubstrateMoonToonBSDF", OutputType = "Substrate",
			Kind = "Skin",
			BaseColor               = Surf_BaseColor,
			Metallic                = Surf_Metallic,
			Specular                = Surf_Specular,
			Roughness               = Surf_Roughness,
			Normal                  = Surf_Normal,
			Emissive_Color          = Surf_EmissiveColor,
			Anisotropy              = Surf_Anisotropy,
			Tangent                 = Surf_Tangent,
			Main_Light_Shadow_Color = Surf_MainLightShadowColor,
			Diffuse_Ramp_Index      = Surf_DiffuseColorRampIndex,
			Diffuse_Ramp_UV_Offset  = Surf_DiffuseRampUVOffset,
			Toon_Specular_Color     = Surf_SpecularColor,
			Specular_Ramp_Index     = Surf_SpecularColorRampIndex,
			Specular_Ramp_UV_Offset = Surf_SpecularRampUVOffset,
			Reflection_Intensity    = Surf_ReflectionIntensity,
			Stencil                 = Surf_Stencil,
			Ray_Tracing_Shadow_Flag = Surf_RayTracingShadowFlag,
			ScatterStrength         = MF_ToonFeature_Skin(Output="ScatterStrength"),
			TransmissionStrength    = MF_ToonFeature_Skin(Output="TransmissionStrength"),
			TransmissionPower       = MF_ToonFeature_Skin(Output="TransmissionPower"),
			PrimaryRoughnessScale   = MF_ToonFeature_Skin(Output="PrimaryRoughnessScale"),
			SecondaryRoughnessScale = MF_ToonFeature_Skin(Output="SecondaryRoughnessScale"),
			SecondaryRampOffset     = MF_ToonFeature_Skin(Output="SecondaryRampOffset"),
			OverallSpecIntensity    = MF_ToonFeature_Skin(Output="OverallSpecIntensity"),
			PrimaryLobeIntensity    = MF_ToonFeature_Skin(Output="PrimaryLobeIntensity"),
			SecondaryLobeIntensity  = MF_ToonFeature_Skin(Output="SecondaryLobeIntensity"),
			SpecShadowStrength      = MF_ToonFeature_Skin(Output="SpecShadowStrength"),
			WarmTintStrength        = MF_ToonFeature_Skin(Output="WarmTintStrength"),
			Modifier_Payload        = ModifierPayload,
			Modifier_Id             = ModifierId);

		// 7 PBR_STOCKINGS -- Kind Skin + term Stockings, PBR variant. The Skin channels stay
		// unconnected: the stockings table is FULL, so the term writes every lane anyway.
		Substrate Base_Stockings = UE.Expression(
			Class = "SubstrateMoonToonBSDF", OutputType = "Substrate",
			Kind = "Skin",
			BaseColor               = Surf_BaseColor,
			Metallic                = Surf_Metallic,
			Specular                = Surf_Specular,
			Roughness               = Surf_Roughness,
			Normal                  = Surf_Normal,
			Emissive_Color          = Surf_EmissiveColor,
			Anisotropy              = Surf_Anisotropy,
			Tangent                 = Surf_Tangent,
			Main_Light_Shadow_Color = Surf_MainLightShadowColor,
			Diffuse_Ramp_Index      = Surf_DiffuseColorRampIndex,
			Diffuse_Ramp_UV_Offset  = Surf_DiffuseRampUVOffset,
			Toon_Specular_Color     = Surf_SpecularColor,
			Specular_Ramp_Index     = Surf_SpecularColorRampIndex,
			Specular_Ramp_UV_Offset = Surf_SpecularRampUVOffset,
			Reflection_Intensity    = Surf_ReflectionIntensity,
			Stencil                 = Surf_Stencil,
			Ray_Tracing_Shadow_Flag = Surf_RayTracingShadowFlag,
			Modifier_Payload        = ModifierPayload,
			Modifier_Id             = ModifierId);

		Substrate Leaf_Stockings = UE.Expression(
			Class = "MoonToonFeature", OutputType = "Substrate",
			Term = "StockingsPBR",
			MoonToonMaterial = Base_Stockings,
			Density                = MF_ToonFeature_Stockings(Surf_StockingsThickness, Surf_GlobalMaskA, Surf_GlobalMaskB, Surf_GlobalMaskC, Surf_StockingsSkinColor, Output="Density"),
			FresnelPower           = MF_ToonFeature_Stockings(Surf_StockingsThickness, Surf_GlobalMaskA, Surf_GlobalMaskB, Surf_GlobalMaskC, Surf_StockingsSkinColor, Output="FresnelPower"),
			TransmissionStrength   = MF_ToonFeature_Stockings(Surf_StockingsThickness, Surf_GlobalMaskA, Surf_GlobalMaskB, Surf_GlobalMaskC, Surf_StockingsSkinColor, Output="TransmissionStrength"),
			TransmissionDistortion = MF_ToonFeature_Stockings(Surf_StockingsThickness, Surf_GlobalMaskA, Surf_GlobalMaskB, Surf_GlobalMaskC, Surf_StockingsSkinColor, Output="TransmissionDistortion"),
			SpecularIntensity      = MF_ToonFeature_Stockings(Surf_StockingsThickness, Surf_GlobalMaskA, Surf_GlobalMaskB, Surf_GlobalMaskC, Surf_StockingsSkinColor, Output="SpecularIntensity"),
			ShadowStrength         = MF_ToonFeature_Stockings(Surf_StockingsThickness, Surf_GlobalMaskA, Surf_GlobalMaskB, Surf_GlobalMaskC, Surf_StockingsSkinColor, Output="ShadowStrength"),
			GrazingDarkenStrength  = MF_ToonFeature_Stockings(Surf_StockingsThickness, Surf_GlobalMaskA, Surf_GlobalMaskB, Surf_GlobalMaskC, Surf_StockingsSkinColor, Output="GrazingDarkenStrength"),
			SkinColor              = MF_ToonFeature_Stockings(Surf_StockingsThickness, Surf_GlobalMaskA, Surf_GlobalMaskB, Surf_GlobalMaskC, Surf_StockingsSkinColor, Output="SkinColor"),
			GrazingSpecBoost       = MF_ToonFeature_Stockings(Surf_StockingsThickness, Surf_GlobalMaskA, Surf_GlobalMaskB, Surf_GlobalMaskC, Surf_StockingsSkinColor, Output="GrazingSpecBoost"));

		// 14 NPR_STOCKINGS -- the same term and the same parameter names, no PBR variant bit.
		Substrate Base_NPRStockings = UE.Expression(
			Class = "SubstrateMoonToonBSDF", OutputType = "Substrate",
			Kind = "Skin",
			BaseColor               = Surf_BaseColor,
			Metallic                = Surf_Metallic,
			Specular                = Surf_Specular,
			Roughness               = Surf_Roughness,
			Normal                  = Surf_Normal,
			Emissive_Color          = Surf_EmissiveColor,
			Anisotropy              = Surf_Anisotropy,
			Tangent                 = Surf_Tangent,
			Main_Light_Shadow_Color = Surf_MainLightShadowColor,
			Diffuse_Ramp_Index      = Surf_DiffuseColorRampIndex,
			Diffuse_Ramp_UV_Offset  = Surf_DiffuseRampUVOffset,
			Toon_Specular_Color     = Surf_SpecularColor,
			Specular_Ramp_Index     = Surf_SpecularColorRampIndex,
			Specular_Ramp_UV_Offset = Surf_SpecularRampUVOffset,
			Reflection_Intensity    = Surf_ReflectionIntensity,
			Stencil                 = Surf_Stencil,
			Ray_Tracing_Shadow_Flag = Surf_RayTracingShadowFlag,
			Modifier_Payload        = ModifierPayload,
			Modifier_Id             = ModifierId);

		Substrate Leaf_NPRStockings = UE.Expression(
			Class = "MoonToonFeature", OutputType = "Substrate",
			Term = "Stockings",
			MoonToonMaterial = Base_NPRStockings,
			Density                = MF_ToonFeature_NPRStockings(Surf_StockingsThickness, Surf_GlobalMaskA, Surf_GlobalMaskB, Surf_GlobalMaskC, Surf_StockingsSkinColor, Output="Density"),
			FresnelPower           = MF_ToonFeature_NPRStockings(Surf_StockingsThickness, Surf_GlobalMaskA, Surf_GlobalMaskB, Surf_GlobalMaskC, Surf_StockingsSkinColor, Output="FresnelPower"),
			TransmissionStrength   = MF_ToonFeature_NPRStockings(Surf_StockingsThickness, Surf_GlobalMaskA, Surf_GlobalMaskB, Surf_GlobalMaskC, Surf_StockingsSkinColor, Output="TransmissionStrength"),
			TransmissionDistortion = MF_ToonFeature_NPRStockings(Surf_StockingsThickness, Surf_GlobalMaskA, Surf_GlobalMaskB, Surf_GlobalMaskC, Surf_StockingsSkinColor, Output="TransmissionDistortion"),
			SpecularIntensity      = MF_ToonFeature_NPRStockings(Surf_StockingsThickness, Surf_GlobalMaskA, Surf_GlobalMaskB, Surf_GlobalMaskC, Surf_StockingsSkinColor, Output="SpecularIntensity"),
			ShadowStrength         = MF_ToonFeature_NPRStockings(Surf_StockingsThickness, Surf_GlobalMaskA, Surf_GlobalMaskB, Surf_GlobalMaskC, Surf_StockingsSkinColor, Output="ShadowStrength"),
			GrazingDarkenStrength  = MF_ToonFeature_NPRStockings(Surf_StockingsThickness, Surf_GlobalMaskA, Surf_GlobalMaskB, Surf_GlobalMaskC, Surf_StockingsSkinColor, Output="GrazingDarkenStrength"),
			SkinColor              = MF_ToonFeature_NPRStockings(Surf_StockingsThickness, Surf_GlobalMaskA, Surf_GlobalMaskB, Surf_GlobalMaskC, Surf_StockingsSkinColor, Output="SkinColor"),
			GrazingSpecBoost       = MF_ToonFeature_NPRStockings(Surf_StockingsThickness, Surf_GlobalMaskA, Surf_GlobalMaskB, Surf_GlobalMaskC, Surf_StockingsSkinColor, Output="GrazingSpecBoost"));

		// 8 EYE
		Substrate Leaf_Eye = UE.Expression(
			Class = "SubstrateMoonToonBSDF", OutputType = "Substrate",
			Kind = "Eye",
			BaseColor               = Surf_BaseColor,
			Metallic                = Surf_Metallic,
			Specular                = Surf_Specular,
			Roughness               = Surf_Roughness,
			Normal                  = Surf_Normal,
			Emissive_Color          = Surf_EmissiveColor,
			Anisotropy              = Surf_Anisotropy,
			Tangent                 = Surf_Tangent,
			Main_Light_Shadow_Color = Surf_MainLightShadowColor,
			Diffuse_Ramp_Index      = Surf_DiffuseColorRampIndex,
			Diffuse_Ramp_UV_Offset  = Surf_DiffuseRampUVOffset,
			Toon_Specular_Color     = Surf_SpecularColor,
			Specular_Ramp_Index     = Surf_SpecularColorRampIndex,
			Specular_Ramp_UV_Offset = Surf_SpecularRampUVOffset,
			Reflection_Intensity    = Surf_ReflectionIntensity,
			Stencil                 = Surf_Stencil,
			Ray_Tracing_Shadow_Flag = Surf_RayTracingShadowFlag,
			DiffuseWrapStrength     = MF_ToonFeature_Eye(Output="DiffuseWrapStrength"),
			LimbalDarkenStrength    = MF_ToonFeature_Eye(Output="LimbalDarkenStrength"),
			SpecularShadowStrength  = MF_ToonFeature_Eye(Output="SpecularShadowStrength"),
			PrimaryRoughnessScale   = MF_ToonFeature_Eye(Output="PrimaryRoughnessScale"),
			SecondaryRoughnessScale = MF_ToonFeature_Eye(Output="SecondaryRoughnessScale"),
			PrimaryIntensity        = MF_ToonFeature_Eye(Output="PrimaryIntensity"),
			SecondaryIntensity      = MF_ToonFeature_Eye(Output="SecondaryIntensity"),
			EyeTint                 = MF_ToonFeature_Eye(Output="EyeTint"),
			SecondaryRampOffset     = MF_ToonFeature_Eye(Output="SecondaryRampOffset"),
			Modifier_Payload        = ModifierPayload,
			Modifier_Id             = ModifierId);

		// 9 CLOTH_VELVET -- Kind Default + term Cloth Velvet.
		Substrate Base_ClothVelvet = UE.Expression(
			Class = "SubstrateMoonToonBSDF", OutputType = "Substrate",
			Kind = "Default",
			BaseColor               = Surf_BaseColor,
			Metallic                = Surf_Metallic,
			Specular                = Surf_Specular,
			Roughness               = Surf_Roughness,
			Normal                  = Surf_Normal,
			Emissive_Color          = Surf_EmissiveColor,
			Anisotropy              = Surf_Anisotropy,
			Tangent                 = Surf_Tangent,
			Main_Light_Shadow_Color = Surf_MainLightShadowColor,
			Diffuse_Ramp_Index      = Surf_DiffuseColorRampIndex,
			Diffuse_Ramp_UV_Offset  = Surf_DiffuseRampUVOffset,
			Toon_Specular_Color     = Surf_SpecularColor,
			Specular_Ramp_Index     = Surf_SpecularColorRampIndex,
			Specular_Ramp_UV_Offset = Surf_SpecularRampUVOffset,
			Reflection_Intensity    = Surf_ReflectionIntensity,
			Stencil                 = Surf_Stencil,
			Ray_Tracing_Shadow_Flag = Surf_RayTracingShadowFlag,
			Modifier_Payload        = ModifierPayload,
			Modifier_Id             = ModifierId);

		Substrate Leaf_ClothVelvet = UE.Expression(
			Class = "MoonToonFeature", OutputType = "Substrate",
			Term = "Cloth",
			MoonToonMaterial = Base_ClothVelvet,
			WrapStrength          = MF_ToonFeature_ClothVelvet(Output="WrapStrength"),
			SheenPower            = MF_ToonFeature_ClothVelvet(Output="SheenPower"),
			SheenShadowStrength   = MF_ToonFeature_ClothVelvet(Output="SheenShadowStrength"),
			RoughnessScale        = MF_ToonFeature_ClothVelvet(Output="RoughnessScale"),
			SheenIntensity        = MF_ToonFeature_ClothVelvet(Output="SheenIntensity"),
			RetroDiffuseStrength  = MF_ToonFeature_ClothVelvet(Output="RetroDiffuseStrength"),
			GrazingDarkenStrength = MF_ToonFeature_ClothVelvet(Output="GrazingDarkenStrength"),
			SheenTint             = MF_ToonFeature_ClothVelvet(Output="SheenTint"),
			RimBias               = MF_ToonFeature_ClothVelvet(Output="RimBias"));

		// 10 TOON_METAL
		Substrate Leaf_ToonMetal = UE.Expression(
			Class = "SubstrateMoonToonBSDF", OutputType = "Substrate",
			Kind = "Metal",
			BaseColor               = Surf_BaseColor,
			Metallic                = Surf_Metallic,
			Specular                = Surf_Specular,
			Roughness               = Surf_Roughness,
			Normal                  = Surf_Normal,
			Emissive_Color          = Surf_EmissiveColor,
			Anisotropy              = Surf_Anisotropy,
			Tangent                 = Surf_Tangent,
			Main_Light_Shadow_Color = Surf_MainLightShadowColor,
			Diffuse_Ramp_Index      = Surf_DiffuseColorRampIndex,
			Diffuse_Ramp_UV_Offset  = Surf_DiffuseRampUVOffset,
			Toon_Specular_Color     = Surf_SpecularColor,
			Specular_Ramp_Index     = Surf_SpecularColorRampIndex,
			Specular_Ramp_UV_Offset = Surf_SpecularRampUVOffset,
			Reflection_Intensity    = Surf_ReflectionIntensity,
			Stencil                 = Surf_Stencil,
			Ray_Tracing_Shadow_Flag = Surf_RayTracingShadowFlag,
			DiffuseIntensity    = MF_ToonFeature_ToonMetal(Output="DiffuseIntensity"),
			ShadowSpecularFloor = MF_ToonFeature_ToonMetal(Output="ShadowSpecularFloor"),
			RampOffset          = MF_ToonFeature_ToonMetal(Output="RampOffset"),
			RoughnessScale      = MF_ToonFeature_ToonMetal(Output="RoughnessScale"),
			SpecularIntensity   = MF_ToonFeature_ToonMetal(Output="SpecularIntensity"),
			EdgeBoost           = MF_ToonFeature_ToonMetal(Output="EdgeBoost"),
			SpecularContrast    = MF_ToonFeature_ToonMetal(Output="SpecularContrast"),
			MetalTint           = MF_ToonFeature_ToonMetal(Output="MetalTint"),
			Modifier_Payload        = ModifierPayload,
			Modifier_Id             = ModifierId);

		// 11 TOON_EMISSIVE_INK -- Kind Default + term Emissive Ink.
		Substrate Base_EmissiveInk = UE.Expression(
			Class = "SubstrateMoonToonBSDF", OutputType = "Substrate",
			Kind = "Default",
			BaseColor               = Surf_BaseColor,
			Metallic                = Surf_Metallic,
			Specular                = Surf_Specular,
			Roughness               = Surf_Roughness,
			Normal                  = Surf_Normal,
			Emissive_Color          = Surf_EmissiveColor,
			Anisotropy              = Surf_Anisotropy,
			Tangent                 = Surf_Tangent,
			Main_Light_Shadow_Color = Surf_MainLightShadowColor,
			Diffuse_Ramp_Index      = Surf_DiffuseColorRampIndex,
			Diffuse_Ramp_UV_Offset  = Surf_DiffuseRampUVOffset,
			Toon_Specular_Color     = Surf_SpecularColor,
			Specular_Ramp_Index     = Surf_SpecularColorRampIndex,
			Specular_Ramp_UV_Offset = Surf_SpecularRampUVOffset,
			Reflection_Intensity    = Surf_ReflectionIntensity,
			Stencil                 = Surf_Stencil,
			Ray_Tracing_Shadow_Flag = Surf_RayTracingShadowFlag,
			Modifier_Payload        = ModifierPayload,
			Modifier_Id             = ModifierId);

		Substrate Leaf_EmissiveInk = UE.Expression(
			Class = "MoonToonFeature", OutputType = "Substrate",
			Term = "Ink",
			MoonToonMaterial = Base_EmissiveInk,
			LightInfluence    = MF_ToonFeature_EmissiveInk(Output="LightInfluence"),
			ShadowLift        = MF_ToonFeature_EmissiveInk(Output="ShadowLift"),
			InkDarkenStrength = MF_ToonFeature_EmissiveInk(Output="InkDarkenStrength"),
			RoughnessScale    = MF_ToonFeature_EmissiveInk(Output="RoughnessScale"),
			SpecularIntensity = MF_ToonFeature_EmissiveInk(Output="SpecularIntensity"),
			EdgeBoost         = MF_ToonFeature_EmissiveInk(Output="EdgeBoost"),
			InkBlend          = MF_ToonFeature_EmissiveInk(Output="InkBlend"),
			InkTint           = MF_ToonFeature_EmissiveInk(Output="InkTint"),
			RimBias           = MF_ToonFeature_EmissiveInk(Output="RimBias"));
		#EndRegion

		#Region "Feature selection"
		// The twelve switches, outermost first, so the topmost ticked one wins -- the same priority
		// MF_MoonToonFeatureSelect had, and the same convention: exactly one SHOULD be ticked, and
		// nothing enforces it.
		//
		// The engine resolves these while it builds the material topology tree
		// (UMaterialExpressionStaticSwitchParameter::SubstrateGenerateMaterialTopologyTree) and
		// descends only the taken side, so the translator sees ONE closure however many leaves are
		// wired here. DreamShader used to refuse this outright (DSH7103); it now refuses only a
		// switch that MIXES a closure with a number.
		ToonClosure = Is_PBRSpecular(
			True = Leaf_PBRSpecular,
			False = Is_KajiyaHair(
				True = Leaf_KajiyaHair,
				False = Is_ToonKajiyaHair(
					True = Leaf_ToonKajiyaHair,
					False = Is_DFFacialShadow(
						True = Use_Full_Angle_SDF(True = Leaf_DFFacialShadow360, False = Leaf_DFFacialShadow),
						False = Is_AngelRing(
							True = Leaf_AngelRing,
							False = Is_HairHighlightMask(
							True = Leaf_HairHighlightMask,
							False = Is_Skin(
								True = Leaf_Skin,
								False = Is_Stockings(
									True = Leaf_Stockings,
									False = Is_NPRStockings(
										True = Leaf_NPRStockings,
										False = Is_Eye(
											True = Leaf_Eye,
											False = Is_ClothVelvet(
												True = Leaf_ClothVelvet,
												False = Is_ToonMetal(
													True = Leaf_ToonMetal,
													False = Is_EmissiveInk(
														True = Leaf_EmissiveInk,
														False = Leaf_Default)))))))))))));
		#EndRegion

		#Region "Root pins and custom outputs"
		// Retired: dithered translucent shadow, which faked translucency on a MASKED material by
		// turning the shadow into a dithered opacity mask. Superseded by real toon translucency
		// (see Settings above). The dither could not do what that does -- it wrote full depth and
		// velocity, so SSR/AO/DOF treated a "transparent" character as solid, it leaned on TSR
		// history (noise and smear on fast motion or a cut), and it had no colour, only present or
		// absent. MF_MoonToonTranslucencyShadow.dsf is kept, unreferenced, so an MI that still
		// wants the old look can be rebuilt from it.
		//
		// MF_MoonToonBaseInput writes both channels: OutOpacity for the translucent blend and
		// OutOpacityMask (the sampled alpha, with "Shadow Opacity" x "Apply Opacity to Shadow"
		// substituted in the shadow pass) for the masked cutout.
		// FX coverage (reveal / dissolve / hologram), chained like the FX region: each stage passes the
		// previous value through untouched when its switch is off.
		float Surf_OpacityAuthored     = MF_MoonToonBaseInput(Output="OutOpacity");
		float Surf_OpacityMaskAuthored = MF_MoonToonBaseInput(Output="OutOpacityMask");
		float FX_Opacity_Reveal = UE.Expression(
				Class="StaticSwitchParameter",
				OutputType="float",
				True=(Surf_OpacityAuthored * MF_ToonFX_Reveal(FX_UV, FX_Mask, Output="Coverage")),
				False=Surf_OpacityAuthored,
				ParameterName="Use FX Reveal",
				Group="50 - FX",
				SortPriority=60
			);
		float FX_OpacityMask_Reveal = UE.Expression(
				Class="StaticSwitchParameter",
				OutputType="float",
				True=(Surf_OpacityMaskAuthored * MF_ToonFX_Reveal(FX_UV, FX_Mask, Output="Coverage")),
				False=Surf_OpacityMaskAuthored,
				ParameterName="Use FX Reveal",
				Group="50 - FX",
				SortPriority=60
			);
		float FX_Opacity_Dissolve = UE.Expression(
				Class="StaticSwitchParameter",
				OutputType="float",
				True=(FX_Opacity_Reveal * MF_ToonFX_Dissolve(FX_UV, FX_Mask, Output="Coverage")),
				False=FX_Opacity_Reveal,
				ParameterName="Use FX Dissolve",
				Group="50 - FX",
				SortPriority=80
			);
		float FX_OpacityMask_Dissolve = UE.Expression(
				Class="StaticSwitchParameter",
				OutputType="float",
				True=(FX_OpacityMask_Reveal * MF_ToonFX_Dissolve(FX_UV, FX_Mask, Output="Coverage")),
				False=FX_OpacityMask_Reveal,
				ParameterName="Use FX Dissolve",
				Group="50 - FX",
				SortPriority=80
			);
		float FX_Opacity_Hologram = UE.Expression(
				Class="StaticSwitchParameter",
				OutputType="float",
				True=(FX_Opacity_Dissolve * MF_ToonFX_Hologram(FX_Base_Wet, float3(0.0, 0.0, 0.0), FX_Mask, Output="Coverage")),
				False=FX_Opacity_Dissolve,
				ParameterName="Use FX Hologram",
				Group="50 - FX",
				SortPriority=30
			);
		float FX_OpacityMask_Hologram = UE.Expression(
				Class="StaticSwitchParameter",
				OutputType="float",
				True=(FX_OpacityMask_Dissolve * MF_ToonFX_Hologram(FX_Base_Wet, float3(0.0, 0.0, 0.0), FX_Mask, Output="Coverage")),
				False=FX_OpacityMask_Dissolve,
				ParameterName="Use FX Hologram",
				Group="50 - FX",
				SortPriority=30
			);

		// Hair-tip translucency (T12, "Use Hair Tip Translucency"; the role functions at the top of this
		// file say which half runs). Off: both pins are exactly the FX chain's result.
		float HairTip_Tip      = MF_ToonHairTip(FX_UV, Output="Tip");
		float HairTip_Gradient = MF_ToonHairTip(FX_UV, Output="Gradient");
		float HairTip_Keep     = MF_ToonHairTip(FX_UV, Output="Keep");
		Opacity = Use_Hair_Tip_Translucency(
			True = MoonToonHairTipOpacity(FX_Opacity_Hologram, HairTip_Tip, lerp(Hair_Tip_Root_Opacity, Hair_Tip_End_Opacity, HairTip_Gradient)),
			False = FX_Opacity_Hologram);
		// The cut keeps the tips in the shadow pass unless Hair Tip Casts Shadow is 0, so the fringe's
		// shadow on the forehead does not lose its ends.
		float HairTip_CutMask = MoonToonHairTipCut(FX_OpacityMask_Hologram, HairTip_Tip);
		float HairTip_OpacityMask =
			UE.Expression(
				Class="ShadowReplace",
				OutputType="float",
				Default=HairTip_CutMask,
				Shadow=lerp(HairTip_CutMask, FX_OpacityMask_Hologram, Hair_Tip_Casts_Shadow)
			);
		float Surf_OpacityMask = Use_Hair_Tip_Translucency(
			True = HairTip_OpacityMask,
			False = FX_OpacityMask_Hologram);

		// Sheer dither (opt-in, "Use Sheer Dither"). A narrower revival of the retired scheme above,
		// for one job only: thin cloth over a body, where writing full depth/velocity is harmless.
		// Ported from Wuthering Waves' gauze sleeves (RenderDoc 2026-10-30, Toon/WUWA_CHARACTER_
		// RENDERING_ANALYSIS.md 10.5): keep the pixel when ((2y+x+3f)%5 + n)/5 >= 1 - coverage, with
		// n a static per-pixel noise and f the frame. Five interleaved phases rotate through the
		// frames, so TSR averages each pixel to ~coverage; the static n spreads the threshold within
		// a phase. Wuwa maps coverage 0.8333 to solid and uses the TAA jitter index for f; here 1 is
		// solid and f is StateFrameIndex, which cycles the five phases evenly whatever the jitter
		// sequence length. Emissive luminance lifts coverage the way Wuwa's specular/glitter does.
		// The binary 0/1 result clips correctly against any clip value in (0,1). The shadow pass gets
		// the undithered mask, so "Shadow Opacity" keeps meaning what it says.
		float Sheer_Keep =
			UE.Expression(
				Class="Custom",
				OutputType="float",
				Code="float Coverage = saturate(max(Mask, dot(Emissive, float3(0.3f, 0.59f, 0.11f)) * EmissiveOpaque));\r\nfloat2 Pixel = floor(Parameters.SvPosition.xy - ResolvedView.ViewRectMin.xy);\r\nfloat Frame = (float)(View.StateFrameIndex % 5u);\r\nfloat Phase = fmod(2.0f * (Pixel.y + Frame) + (Pixel.x + Frame), 5.0f);\r\nfloat Noise = frac(52.9829189f * frac(dot(Pixel, float2(0.06711056f, 0.00583715f))));\r\nreturn ((Phase + Noise) * 0.2f >= 1.0f - Coverage) ? 1.0f : 0.0f;",
				Description="Sheer screen-door dither (Wuthering Waves style)",
				Mask=Surf_OpacityMask,
				Emissive=Surf_EmissiveColor,
				EmissiveOpaque=Sheer_Emissive_Opaque
			);
		float Sheer_OpacityMask =
			UE.Expression(
				Class="ShadowReplace",
				OutputType="float",
				Default=Sheer_Keep,
				Shadow=Surf_OpacityMask
			);
		OpacityMask = Use_Sheer_Dither(True = Sheer_OpacityMask, False = Surf_OpacityMask);
		// Coverage: the opacity for translucent blends, 1 for opaque and masked -- see
		// MoonToonCoverageWeight at the top of this file for why that has to be decided in HLSL.
		ToonSurface = Substrate.Weight(A = ToonClosure, Weight = MoonToonCoverageWeight(Opacity));
		AmbientOcclusion = MF_MoonToonBaseInput(Output="OutAmbientOcclusion");
		CustomizedUV1    = MF_MoonToonBaseInput(Output="OutCustomizedUV1");
		CustomizedUV2    = MF_MoonToonBaseInput(Output="OutCustomizedUV2");
		CustomData0      = MF_MoonToonBaseInput(Output="OutCustomData0");
		CustomData1      = 1.0;

		FaceOverlay         = MF_MoonToonBaseInput(Output="FaceOverlayData");
		FaceOverlayTuning   = MF_MoonToonBaseInput(Output="FaceOverlayParams");
		FaceOverlayStencils = MF_MoonToonBaseInput(Output="FaceOverlayStencilIDs");
		FaceOverlayOccluder = MF_MoonToonBaseInput(Output="FaceOverlayOccluderClass");
		FaceOverlayPart     = MF_MoonToonBaseInput(Output="FaceOverlayPart");
		FaceOverlayThickness = MF_MoonToonBaseInput(Output="FaceOverlayThickness");

		// Coplanar layer bias (see the property). Toward the camera rather than along the normal, so
		// the layer's silhouette does not grow; constant zero while the switch is off.
		float3 CoplanarBias_CameraPos = UE.Expression(Class="CameraPositionWS", OutputType="float3");
		float3 CoplanarBias_WorldPos  = UE.Expression(Class="WorldPosition", OutputType="float3");
		float3 CoplanarBias_ToCamera  = normalize(CoplanarBias_CameraPos - CoplanarBias_WorldPos);
		float3 CoplanarBias_Offset = Use_Coplanar_Depth_Bias(
			True = (CoplanarBias_ToCamera * Coplanar_Depth_Bias),
			False = float3(0.0, 0.0, 0.0));
		// Hair-tip redraw: non-tip vertices step back along their camera ray (zero in the opaque cut).
		WorldPositionOffset = Use_Hair_Tip_Translucency(
			True = (CoplanarBias_Offset + MoonToonHairTipPush(-CoplanarBias_ToCamera, HairTip_Keep, Hair_Tip_Hidden_Push)),
			False = CoplanarBias_Offset);
		#EndRegion
	}
}
