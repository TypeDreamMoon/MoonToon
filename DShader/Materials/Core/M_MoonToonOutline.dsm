// MoonToon back-face outline.
//
// Re-authored from MooaToon's M_Outline. Same technique -- inverted-hull outline extruded along the
// baked smoothed normal, width ramped by camera distance -- with three deliberate differences:
//
//   1. The smoothed normal is read from UV2.y + UV3.xy, which is the layout MoonToon's own bake tool
//      (UMoonToonSmoothNormalTool) writes. MooaToon read TexCoord2/TexCoord3 wholesale.
//   2. The hull is a Substrate closure of its own, not a copy of the surface's. It needs three
//      things from the toon model -- a flat colour, a shadow tint, and the stencil the outline /
//      post groups key on -- so it is a Kind = Default Moon toon BSDF with those three pins driven
//      and everything else passed through from MF_MoonToonBaseInput. No feature, no modifier: a
//      hull is not lit like the surface it wraps.
//   3. The debug-visualisation Custom node is dropped. It was a dozen static branches over
//      Show* switches; keep the shipping path clean and debug in the base material instead.
//
// Until 2026-09-13 this material reached the toon path the only way there was -- ShadingModel =
// "Toon" and a MaterialAttributes root -- and overrode the shadow tint by decoding and re-encoding
// the five bit-packed MoonEncodedAttribute lanes (MoonDecodeToonAttributes / MoonSetToonAttributes).
// Both nodes are gone with the packing: the shadow colour is a pin now, so overriding it is an
// assignment.

VirtualFunction(Name="MF_MoonToonBaseInput")
{
	Options = {
		Asset = Path(Plugins.MoonToon, "MaterialFunctions/MF_MoonToonBaseInput");
		Description = "Generated from /MoonToon/MaterialFunctions/MF_MoonToonBaseInput.MF_MoonToonBaseInput";
	}

	Inputs = {
	}

	// Restated by hand, and it must stay in step with MF_MoonToonBaseInput's own Outputs block: a
	// missing entry is an "OutputIndex is out of range" build error, and a REORDERED one is worse,
	// because these names are what Output="..." resolves against. Kept complete rather than trimmed
	// to what this file reads, so the two materials' restatements can be diffed against each other.
	Outputs = {
		MaterialAttributes Output;
		float4 ToonBufferA;
		float4 ToonBufferB;
		float4 ToonBufferC;
		float4 FaceOverlayData;
		float4 FaceOverlayParams;
		float4 FaceOverlayStencilIDs;
		float4 ModifierData;
		float ModifierID;
		float3 OutBaseColor;
		float  OutMetallic;
		float  OutSpecular;
		float  OutRoughness;
		float3 OutNormal;
		float3 OutEmissiveColor;
		float  OutAnisotropy;
		float3 OutTangent;
		float  OutOpacity;
		float  OutOpacityMask;
		float  OutAmbientOcclusion;
		float2 OutCustomizedUV1;
		float2 OutCustomizedUV2;
		float  OutCustomData0;
		float3 OutMainLightShadowColor;
		float  OutDiffuseColorRampIndex;
		float  OutDiffuseRampUVOffset;
		float3 OutSpecularColor;
		float  OutSpecularColorRampIndex;
		float  OutSpecularRampUVOffset;
		float  OutReflectionIntensity;
		float  OutStencil;
		float  OutRayTracingShadowFlag;
		float  OutFacialShadowSdfLeft;
		float  OutFacialShadowSdfRight;
		float  OutKajiyaStrandShift;
		float4 OutGlobalMaskA;
		float4 OutGlobalMaskB;
		float4 OutGlobalMaskC;
		float  OutStockingsThickness;
		float3 OutStockingsSkinColor;
		float  FaceOverlayOccluderClass;
	}
}

Shader(Name="Materials/Core/M_MoonToonOutline", Root="Plugin.MoonToon")
{
	Settings = {
		Backend      = "Graph";
		Domain       = "Surface";
		// No ShadingModel line: binding Base.FrontMaterial force-sets the material to Substrate, and
		// the Moon toon closure registers SSM_Toon, which is what every toon gate keys on.

		// Same reason as M_MoonToon: the per-pin form compiles CustomizedUV[i] only for
		// i < NumCustomizedUVs, and MF_MoonToonBaseInput routes the head-forward / hair tangent
		// through UV1 and UV2. The hull does not shade off them, but it is drawn from the same
		// function and a missing customised UV would be a silent difference rather than an error.
		NumCustomizedUVs = 3;

		// Masked, not Opaque. The hull wraps whatever section it was drawn for, and on an imported
		// character most of those sections are alpha-cut -- hair cards, lace, gauze. An opaque hull
		// behind an alpha-cut surface fills every hole the cutout was there to make, which is what
		// "透明的地方也是黑色一片" was. See UMoonToonOutlineSetupTool, which generates one instance
		// per slot with that slot's own cutout copied in; with the stock instance (white opacity map)
		// this costs one extra clip instruction and changes nothing.
		BlendMode    = "Masked";

		bOutputTranslucentVelocity = true;
		bUsedWithSkeletalMesh      = true;
		bUsedWithMorphTargets      = true;

		// The hull is the inverted back faces of the mesh; it must never cast shadows of its own.
		bCastRayTracedShadows = false;
	}

	Properties = {
		ScalarParameter Outline_Width = 1.0 [
			ParameterName="Outline Width";
			Group="00 - Outline";
			SortPriority=10;
			Description="Multiplier on the width ramp, in world units at the ramp's reference distance.";
		];
		ScalarParameter Max_Distance = 1000.0 [
			ParameterName="Max Distance";
			Group="00 - Outline";
			SortPriority=15;
			Description="Camera distance that maps to the right-hand end of the width ramp.";
		];
		ScalarParameter Use_Smooth_Normal = 1.0 [
			ParameterName="Use Smooth Normal Baked In TexCoord23";
			Group="00 - Outline";
			SortPriority=20;
			Description="0 = extrude along the raw vertex normal (splits at hard edges), 1 = along the baked smoothed normal.";
		];
		ScalarParameter Reject_Inverted_Smooth_Normal = 0.0 [
			ParameterName="Reject Inverted Smooth Normal";
			Group="00 - Outline";
			SortPriority=21;
			Description="逐顶点丢弃与顶点法线夹角超过 90 度的烘焙平滑法线, 改用顶点法线外扩. 0 = 关(默认, 照单全收), 1 = 全开.\n\n默认关: 在 weld 过重合几何的导入角色上, '反向'极其常见 —— SK_ww_yy 脸部 23% 的顶点如此, 因为睫毛/眉毛/表情片/腮红这些浮在脸皮前面的薄片被焊进脸皮后法线相互抵消. 沿反向法线外扩会让壳沉进模型内部、被深度剔除, 结果就是脸上没有内描边 —— 那恰好是美术要的.\n\n开启的场景是单面开放片(裙摆/飘带): 那里没有'内部'可藏, 壳向内穿到背面会露出错误的描边. 按实例开.";
		];
		VectorParameter Outline_Color = float4(0.0, 0.0, 0.0, 1.0) [
			ParameterName="Outline Color";
			Group="00 - Outline";
			SortPriority=30;
		];
		ScalarParameter Outline_Color_From_Base = 0.0 [
			ParameterName="Blend Outline Color From Surface";
			Group="00 - Outline";
			SortPriority=40;
			Description="0 = flat Outline Color everywhere, 1 = derive the outline colour from the surface so skin outlines read as skin, hair as hair.";
		];
		ScalarParameter Outline_Use_Shadow_Tint = 1.0 [
			ParameterName="Derive From Shadow Color";
			Group="00 - Outline";
			SortPriority=41;
			Description="Source for the per-region colour. 1 = the material's authored MainLightShadowColor (already art-directed and palette-consistent -- an outline is just the darkest shadow band). 0 = raw albedo.";
		];
		ScalarParameter Outline_Gamma = 1.8 [
			ParameterName="Outline Darken Gamma";
			Group="00 - Outline";
			SortPriority=42;
			Description="Darkens via pow(), which raises saturation and keeps hue -- unlike a flat multiply, which only dims and reads muddy. 1 = no change, 1.5-2.5 typical.";
		];
		VectorParameter Outline_Tint = float4(1.0, 1.0, 1.0, 1.0) [
			ParameterName="Outline Tint";
			Group="00 - Outline";
			SortPriority=43;
			Description="Multiplies the region-derived colour. Keep near white: darkening is Gamma's job, and a dark multiplier would crush every region back to black.";
		];
	}

	Outputs = {
		Substrate ToonClosure;
		float  OpacityMask;
		float3 WorldPositionOffset;
		float  AmbientOcclusion;
		float2 CustomizedUV1;
		float2 CustomizedUV2;
		float  CustomData0;
		float  CustomData1;

		Base.FrontMaterial       = ToonClosure;
		Base.OpacityMask         = OpacityMask;
		Base.WorldPositionOffset = WorldPositionOffset;
		Base.AmbientOcclusion    = AmbientOcclusion;
		Base.CustomizedUV1       = CustomizedUV1;
		Base.CustomizedUV2       = CustomizedUV2;
		Base.CustomData0         = CustomData0;
		Base.CustomData1         = CustomData1;
	}

	Graph = {
		#Region "Surface"
		// One call, read many times -- the graph builder's reuse cache makes this one node.
		//
		// "The surface" below means THIS material instance's own settings, not the section's.
		// Worth being blunt about, because the naming invites the opposite reading: the outline is
		// drawn from its own FMaterialRenderProxy (see FSkeletalMeshSceneProxy's outline batch), so
		// MF_MoonToonBaseInput is evaluated with the outline instance's parameters. Point the
		// outline instance at the same Base Color Map / Shadow Color as the section and the
		// derivation is real; leave it on the defaults and it resolves to one flat colour for the
		// whole mesh, whatever the character underneath looks like.
		//
		// UMoonToonOutlineSetupTool generates one instance per slot and copies the cutout across.
		// It deliberately does NOT copy the shading parameters -- those are shader permutations, and
		// a hull is not lit like the surface it wraps -- so per-region colour still means setting
		// Base Color Map on the generated instances by hand, or leaving
		// "Blend Outline Color From Surface" at 0 and using a flat Outline Color.
		float3 Surf_BaseColor              = MF_MoonToonBaseInput(Output="OutBaseColor");
		float  Surf_Metallic               = MF_MoonToonBaseInput(Output="OutMetallic");
		float  Surf_Specular               = MF_MoonToonBaseInput(Output="OutSpecular");
		float  Surf_Roughness              = MF_MoonToonBaseInput(Output="OutRoughness");
		float3 Surf_Normal                 = MF_MoonToonBaseInput(Output="OutNormal");
		float3 Surf_EmissiveColor          = MF_MoonToonBaseInput(Output="OutEmissiveColor");
		float  Surf_Anisotropy             = MF_MoonToonBaseInput(Output="OutAnisotropy");
		float3 Surf_Tangent                = MF_MoonToonBaseInput(Output="OutTangent");
		float3 Surf_MainLightShadowColor   = MF_MoonToonBaseInput(Output="OutMainLightShadowColor");
		float  Surf_DiffuseColorRampIndex  = MF_MoonToonBaseInput(Output="OutDiffuseColorRampIndex");
		float  Surf_DiffuseRampUVOffset    = MF_MoonToonBaseInput(Output="OutDiffuseRampUVOffset");
		float3 Surf_SpecularColor          = MF_MoonToonBaseInput(Output="OutSpecularColor");
		float  Surf_SpecularColorRampIndex = MF_MoonToonBaseInput(Output="OutSpecularColorRampIndex");
		float  Surf_SpecularRampUVOffset   = MF_MoonToonBaseInput(Output="OutSpecularRampUVOffset");
		float  Surf_ReflectionIntensity    = MF_MoonToonBaseInput(Output="OutReflectionIntensity");
		float  Surf_Stencil                = MF_MoonToonBaseInput(Output="OutStencil");
		float  Surf_RayTracingShadowFlag   = MF_MoonToonBaseInput(Output="OutRayTracingShadowFlag");
		float  Surf_Opacity                = MF_MoonToonBaseInput(Output="OutOpacity");
		#EndRegion

		#Region "Smoothed normal"
		// The bake stores tangent-space smoothed normal * curvature, remapped to [0,1], across
		// UV2.y | UV3.x | UV3.y -- see UMoonToonSmoothNormalTool::BakeSmoothedNormalAndCurvature.
		//
		// Read it defensively. Two states of those channels are NOT a smoothed normal, and the
		// straight normalize() this used to be turned both of them into a wrecked hull:
		//
		//   * Never baked. The channels are 0, so v*2-1 is (-1,-1,-1), which normalizes perfectly
		//     well -- that is the trap. Every vertex then extrudes along one fixed tangent-space
		//     diagonal and the hull shears off the model. |v| is sqrt(3) here, and a real encode
		//     can never exceed 1 (it is a unit normal scaled by curvature in [0,1]), so the length
		//     alone tells them apart.
		//   * Baked but degenerate. Zero curvature -- or one of the geometry-script lookups in the
		//     bake tool returning nothing, which that tool does not check -- writes exactly
		//     (0.5,0.5,0.5), which decodes to exactly (0,0,0). normalize() of that is 0 * rsqrt(0)
		//     = NaN, the NaN lands in WorldPositionOffset, and every triangle touching such a
		//     vertex rasterises as garbage. This is not theoretical: 5.1% of the wedges on
		//     SK_星穹铁道—昔涟5 are exact zeros, and 0% on SK_Lin / SK_ww_yy -- which is precisely
		//     the "only on some characters" in the bug report.
		//
		// So: normalize by hand with a floored denominator, which cannot produce NaN, and weight
		// the result by whether the decoded length looks like a curvature at all.
		float2 UV2 = UE.Expression(Class="TextureCoordinate", OutputType="float2", CoordinateIndex=2);
		float2 UV3 = UE.Expression(Class="TextureCoordinate", OutputType="float2", CoordinateIndex=3);

		float3 BakedNormalRaw = (float3(UV2.g, UV3.r, UV3.g) * 2.0 - 1.0);
		float BakedLenSq = dot(BakedNormalRaw, BakedNormalRaw);
		float3 SmoothNormalTS = (BakedNormalRaw / sqrt(max(BakedLenSq, 0.000001)));

		// Spaces spelled out rather than left to the node defaults: this decode is only correct as
		// tangent -> world, and a silently different default would be invisible in the source.
		float3 SmoothNormalRawWS =
			UE.Expression(
				Class="Transform",
				OutputType="float3",
				Input=SmoothNormalTS,
				TransformSourceType="TRANSFORMSOURCE_Tangent",
				TransformType="TRANSFORM_World"
			);
		// Re-normalized after the transform. The tangent basis is only approximately orthonormal --
		// skewed UVs leave it slightly sheared -- so a unit tangent-space vector does not come out
		// unit length, and this value is used BOTH as the extrusion direction (where its length
		// scales the outline width) and inside a dot product (where its length scales the gate).
		float3 SmoothNormalWS = (SmoothNormalRawWS / sqrt(max(dot(SmoothNormalRawWS, SmoothNormalRawWS), 0.000001)));

		float3 VertexNormalWS = UE.Expression(Class="VertexNormalWS", OutputType="float3");

		// How much to trust the bake, per vertex. Two length tests, always on, and one direction
		// test that is off by default -- see below for why the third one is not free.
		//
		//   lower edge: |v| ramps in over 0.01 .. 0.05, so the degenerate encode fades out instead
		//               of switching. It is seamless because low curvature *means* flat, and on a
		//               flat patch the smoothed normal already equals the vertex normal.
		//   upper edge: |v| > ~1.1 is not a curvature-scaled unit vector, so the channel holds
		//               something else (unbaked zeros, or another tool's data). Reject outright.
		float BakeWeight =
			(smoothstep(0.0001, 0.0025, BakedLenSq)
			 * step(BakedLenSq, 1.2));

		// The direction test, and why it is a parameter defaulting to OFF rather than always on.
		//
		// The premise -- "a smoothed normal is an average of the faces at a vertex, so it can
		// approach 90 degrees from the vertex normal but never exceed it, and anything past 90
		// drives the hull INTO the surface" -- is true for a closed, well-formed mesh. It is not
		// true for a welded MMD/PMX import, and applying it there does visible harm:
		//
		//   * Measured on SK_ww_yy, per body region, the fraction of wedges this test would zero:
		//     legs 1.0%, torso 0.6%, chest 4.5%, neck/jaw 5.3%, skull 14.6%, FACE 23.1% (11.0% of
		//     the face is at dot <= -0.7, i.e. nearly fully inverted). Those are not damaged
		//     wedges: the face carries lashes, brows, expression cards, blush and eye whites as
		//     separate sheets floating in front of the skin, the bake welds coincident geometry
		//     before averaging, and a sheet welded to the skin behind it averages to a flipped
		//     normal. The whole face is like this by construction.
		//   * Extruding along such a normal sinks the hull INSIDE the head, where the depth test
		//     discards it -- so the face gets no inner outline, which is exactly what the art
		//     wants. "Rescuing" those wedges to the vertex normal pops the hull back out and
		//     draws a line across every cheek and jaw. That regression is what this parameter
		//     exists to undo.
		//
		// Turn it ON for open single-sided sheets -- a skirt panel, a ribbon -- where there is no
		// interior to hide in and an inward hull emerges through the back face instead.
		float BakeAgreement = dot(SmoothNormalWS, VertexNormalWS);
		BakeWeight = (BakeWeight * lerp(1.0, saturate(BakeAgreement * 4.0), saturate(Reject_Inverted_Smooth_Normal)));
		float3 OffsetDirRaw = lerp(VertexNormalWS, SmoothNormalWS, (saturate(Use_Smooth_Normal) * BakeWeight));
		// Floored again: the blend of two directions can cancel, and a zero here would re-introduce
		// the NaN through the back door. Worst case the hull collapses onto the surface locally,
		// which is a missing outline rather than a corrupted mesh.
		float3 OffsetDir = (OffsetDirRaw / sqrt(max(dot(OffsetDirRaw, OffsetDirRaw), 0.000001)));
		#EndRegion

		#Region "Width"
		// Per-vertex width mask. Vertex colour alpha scales the outline, so the same material can
		// carry a heavy silhouette and a thin line around the eyes, nose and inner mouth -- the
		// places a uniform hull always reads too fat -- with the weighting painted on the mesh
		// rather than split across extra materials.
		//
		// Static switch, not a lerp: switched off the VertexColor fetch compiles out entirely and
		// the mesh needs no colour stream at all. Two things to know when it is ON: a mesh with no
		// vertex colours reads white, so alpha is 1 and the width is unchanged (safe), but a mesh
		// whose colours were authored for something else and left black reads alpha 0 and the
		// outline disappears. And alpha 0 collapses the hull exactly onto the surface, which
		// z-fights rather than cleanly vanishing -- paint a small floor instead of true black
		// anywhere the outline is meant to be absent.
		float WidthMask =
			UE.Expression(
				Class="StaticSwitchParameter",
				OutputType="float",
				True=(UE.Expression(Class="VertexColor", OutputType="float4")).a,
				False=1.0,
				ParameterName="Use Vertex Color A as Outline Width",
				Group="00 - Outline",
				SortPriority=12
			);

		// Ramp the width by camera distance so the outline keeps a roughly constant screen weight.
		float PixelDepth = UE.Expression(Class="PixelDepth", OutputType="float");
		float4 Width_Ramp =
			UE.Expression(
				Class="TextureSampleParameter2D",
				OutputType="float4",
				ParameterName="Outline Width Ramp Map",
				Group="00 - Outline",
				SortPriority=25,
				Desc="X axis: camera distance to the character. Y axis: outline width. Generate with a Curve Atlas.",
				Coordinates=float2(saturate(PixelDepth / Max_Distance), 0.5),
				Texture=Path(Plugins.MoonToon, "Assets/OutlineWidthRamps/CA_OutlineWidthRamp"),
				SamplerType="SAMPLERTYPE_LinearColor"
			);
		float Width = (Width_Ramp.r * Outline_Width * WidthMask);
		#EndRegion

		#Region "Outline colour"
		// Per-region outline colour. Two things matter here:
		//   * The source is the authored shadow tint, not raw albedo. The artist already decided what
		//     skin/hair look like in shadow, and an outline is the darkest shadow band -- so this comes
		//     out palette-consistent for free, per material, with nothing extra to author. It is one
		//     named output now; it used to mean decoding it back out of a packed lane.
		//   * Darkening is pow(), not a multiply by a dark colour. pow widens the ratios between
		//     channels, so it darkens AND saturates while preserving hue; multiplying by a near-black
		//     tint would collapse skin and hair to the same black and throw away the very distinction
		//     we want. The tint stays near white and only nudges temperature.
		float3 RegionColor = lerp(Surf_BaseColor, (Surf_BaseColor * Surf_MainLightShadowColor), Outline_Use_Shadow_Tint);
		float3 FromSurface = (pow(max(RegionColor, 0.0), Outline_Gamma) * Outline_Tint.rgb);

		// Per-vertex outline tint. Painted RGB multiplies the finished outline colour, so a region can
		// be pushed warmer or darker straight on the mesh -- the per-vertex counterpart to Outline Tint
		// above, and they compose by multiplying. Identity is white, which is exactly the False branch.
		//
		// De-gamma'd on the way in: vertex colours are picked against an sRGB display in the DCC but
		// reach the shader as raw normalised bytes, so a swatch the artist read as mid-grey would
		// otherwise land at 0.5 linear -- far brighter than intended. pow 2.2 is what MooaToon's own
		// Safe_sRGBToLinear does; inlined rather than calling MF_sRGBToLinear so MoonToon does not
		// take an asset dependency on MooaToon for it.
		float3 VertexTint =
			UE.Expression(
				Class="StaticSwitchParameter",
				OutputType="float3",
				True=pow(max((UE.Expression(Class="VertexColor", OutputType="float4")).rgb, 0.0), 2.2),
				False=float3(1.0, 1.0, 1.0),
				ParameterName="Use Vertex Color RGB as Outline Color",
				Group="00 - Outline",
				SortPriority=35
			);

		// Tint applied after the flat/derived lerp so it modulates whichever source is active, and
		// applied once -- OutlineShadowColor is derived from OutlineColor, so it inherits it. (The
		// original multiplied the tint into base and shadow colour separately, which is the same
		// result by a longer route.)
		float3 OutlineColor = (lerp(Outline_Color.rgb, FromSurface, Outline_Color_From_Base) * VertexTint);
		float3 OutlineShadowColor = (OutlineColor * Surf_MainLightShadowColor);
		#EndRegion

		#Region "Closure"
		// Kind = Default and nothing stacked on it: the hull has no shading feature and no modifier.
		// Two pins carry the outline -- the flat colour and the shadow tint -- and the rest is the
		// surface's, so a hull that does end up lit reads like the material it wraps rather than like
		// a default grey. The three Default channel pins are left unconnected, which means the slot
		// table's own defaults rather than zero.
		ToonClosure = UE.Expression(
			Class = "SubstrateMoonToonBSDF", OutputType = "Substrate",
			Kind = "Default",
			BaseColor               = OutlineColor,
			Metallic                = Surf_Metallic,
			Specular                = Surf_Specular,
			Roughness               = Surf_Roughness,
			Normal                  = Surf_Normal,
			Emissive_Color          = Surf_EmissiveColor,
			Anisotropy              = Surf_Anisotropy,
			Tangent                 = Surf_Tangent,
			Main_Light_Shadow_Color = OutlineShadowColor,
			Diffuse_Ramp_Index      = Surf_DiffuseColorRampIndex,
			Diffuse_Ramp_UV_Offset  = Surf_DiffuseRampUVOffset,
			Toon_Specular_Color     = Surf_SpecularColor,
			Specular_Ramp_Index     = Surf_SpecularColorRampIndex,
			Specular_Ramp_UV_Offset = Surf_SpecularRampUVOffset,
			Reflection_Intensity    = Surf_ReflectionIntensity,
			Stencil                 = Surf_Stencil,
			Ray_Tracing_Shadow_Flag = Surf_RayTracingShadowFlag);
		#EndRegion

		#Region "Root pins"
		WorldPositionOffset = (OffsetDir * Width);

		// The hull is cut by the surface opacity, not by what MF_MoonToonBaseInput left on
		// OpacityMask -- that pin carries the SHADOW opacity (opacity folded through
		// "Apply Opacity to Shadow" and then scaled by "Shadow Opacity"), which is a different
		// quantity and would cut the hull to the shadow's silhouette rather than the surface's.
		OpacityMask = Surf_Opacity;

		AmbientOcclusion = MF_MoonToonBaseInput(Output="OutAmbientOcclusion");
		CustomizedUV1    = MF_MoonToonBaseInput(Output="OutCustomizedUV1");
		CustomizedUV2    = MF_MoonToonBaseInput(Output="OutCustomizedUV2");
		CustomData0      = MF_MoonToonBaseInput(Output="OutCustomData0");
		CustomData1      = 1.0;
		#EndRegion
	}
}
