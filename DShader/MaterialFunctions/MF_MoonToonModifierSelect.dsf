		opt float3 InNormalTS = float3(0.0, 0.0, 1.0) [Description="Tangent-space normal, the same one the surface ends up shading with."];
	}

	Outputs = {
		// ToonMaterialOutput pin 3 -> ToonFeatureRT4. What its channels mean is selected by ModifierID.
		float4 ModifierData;
		// ToonMaterialOutput pin 4 -> ToonFeatureRT3.w, as a RAW id; ComposeToonBufferD normalizes it
		// into the 8-bit lane. Same static choice that picked the branch above, so the payload and the
		// id that says how to read it cannot disagree.
		float ModifierID;
	}

	Properties = {
		StaticSwitchParameter Is_Modifier_Matcap = false [ParameterName="Is Modifier Matcap"; Group="43 - Modifier (pick one)"; SortPriority=0; Description="启用 Matcap 修饰层. 修饰层叠加在着色特征之上, 与任意特征共存 —— 它不占 30 组的单选. 只应勾选一个; 若勾了多个, 本文件中靠前的胜出. 一个都不勾 = 无修饰层, 在面板和着色器里都不花代价."];
		StaticSwitchParameter Is_Modifier_OilFilm = false [ParameterName="Is Modifier Oil Film"; Group="43 - Modifier (pick one)"; SortPriority=1; Description="启用 Oil Film 修饰层. 修饰层叠加在着色特征之上, 与任意特征共存 —— 它不占 30 组的单选. 只应勾选一个; 若勾了多个, 本文件中靠前的胜出. 一个都不勾 = 无修饰层, 在面板和着色器里都不花代价."];
	}

	Graph = {
		ModifierData = Is_Modifier_Matcap(
			True = MF_ToonModifier_Matcap(InNormalTS, OutputIndex=0),
			False = Is_Modifier_OilFilm(
				True = MF_ToonModifier_OilFilm(OutputIndex=0),
				False = float4(0.0, 0.0, 0.0, 0.0)));

		ModifierID = Is_Modifier_Matcap(
			True = 1.0,
			False = Is_Modifier_OilFilm(
				True = 2.0,
				False = 0.0));
	}
}
