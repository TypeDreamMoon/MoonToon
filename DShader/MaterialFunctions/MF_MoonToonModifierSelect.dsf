ShaderFunction(Name="MaterialFunctions/MF_MoonToonModifierSelect", Root="Plugin.MoonToon")
{
	Settings = {
		Description       = "Selects one toon modifier and packs its parameters into the modifier payload.";
		ExposeToLibrary   = true;
		LibraryCategories = "MoonToon";
	}

