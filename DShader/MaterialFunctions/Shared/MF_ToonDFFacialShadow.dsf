// Distance-field facial shadow sampling, lifted out of MF_MoonToonBaseInput.
//
// The SDF map stores the light angle at which each pixel of the face flips into shadow, for one half
// of the face; the other half is the same texture read with a mirrored U. Both halves come out of
// here, and which one is which can be swapped when the map was authored the other way round.
//
// The "Is DFFacialShadow" feature gate deliberately stays in the caller: it selects between four
// different things there, and duplicating a static switch across two functions to gate one of them
// would make the panel row ambiguous about which node owns the default.

ShaderFunction(Name="MaterialFunctions/Shared/MF_ToonDFFacialShadow", Root="Plugin.MoonToon")
{
	Settings = {
		Description       = "Samples the distance-field facial shadow map for both halves of the face.";
		ExposeToLibrary   = true;
		LibraryCategories = "MoonToon|Shared";
	}

	Inputs = {
	}

	Outputs = {
		float SdfLeft;
		float SdfRight;
	}

	Properties = {
		ChannelMaskParameter Distance_Field_Facial_Shadow_Map_Channel = float4(1.0, 0.0, 0.0, 0.0) [
			ParameterName="Face SDF Map Channel";
			Group="20 - Face: SDF Shadow";
			MaskChannel=Red;
			SortPriority=13;
			Description="SDF 脸阴影图用哪个通道. 选通道(R/G/B/A). Picks the channel (R/G/B/A). ";
		];
		ChannelMaskParameter Distance_Field_Facial_Shadow_Map_Channel_1 = float4(1.0, 0.0, 0.0, 0.0) [
			ParameterName="Face SDF Map Channel";
			Group="20 - Face: SDF Shadow";
			MaskChannel=Red;
			SortPriority=13;
			Description="SDF 脸阴影图用哪个通道. 选通道(R/G/B/A). Picks the channel (R/G/B/A). ";
		];
		ScalarParameter Flip_Left_Right_Flag = 0.0 [
			ParameterName="Face SDF Flip Left Right";
			Group="20 - Face: SDF Shadow";
			SortPriority=2;
			Description="1 = 左右两半的 SDF 互换(贴图按另一侧画的时候用).\r\n以前是静态开关, 现在是标量(>= 0.5 算开): 不再多一套着色器排列. 现有实例的开关值已迁移过来.\r\n\r\n\r\n1 = swap the two halves' SDF values (for a map authored for the other side).\r\nIt used to be a static switch; it is a scalar now (>= 0.5 counts as on), so it no longer costs a shader permutation. Existing instances' switch values were migrated.";
			SliderMin=0;
			SliderMax=1;
		];
		ScalarParameter RG_Average_Flag = 0.0 [
			ParameterName="Face SDF R+G Average";
			Group="20 - Face: SDF Shadow";
			SortPriority=3;
			Description="1 = 距离场面影贴图按终末地式 R+G 分半格式读: 阈值 = (R + G) / 2, 约 9 位精度(Tools/FaceSDF 可输出). 0 = 按上面的通道读.\r\n以前是静态开关, 现在是标量(>= 0.5 算开): 不再多一套着色器排列. 现有实例的开关值已迁移过来.\r\n\r\n\r\n1 = read the map as an Endfield-style R+G split: threshold = (R + G) / 2, about 9 bits (Tools/FaceSDF writes it). 0 = the channel above.\r\nIt used to be a static switch; it is a scalar now (>= 0.5 counts as on), so it no longer costs a shader permutation. Existing instances' switch values were migrated.";
			SliderMin=0;
			SliderMax=1;
		];
	}

	Graph = {
		float2 MaterialExpressionTextureCoordinate_2 = UE.Expression(Class="TextureCoordinate", OutputType="float2");
		#Region "Texture Sample"
		float2 Multiply_19 = (float2(-1.0, 1.0) * MaterialExpressionTextureCoordinate_2);
		float4 Distance_Field_Facial_Shadow_Map =
			UE.Expression(
				Class="TextureSampleParameter2D",
				OutputType="float4",
				OutputIndex=5,
				ParameterName="Face SDF Map",
				Group="20 - Face: SDF Shadow",
				Desc="距离场面影贴图, 关于制作方法搜索\"Distance Field Facial Shadow\".\r\n压缩格式必须是\"Half Float (R16F)\", 且禁用sRGB.\r\n\r\n\r\nDistance Field Facial Shadow Map, search \"Distance Field Facial Shadow\" for the production method.\r\nThe compression format must be \"Half Float (R16F)\", and disable sRGB.",
				Coordinates=Multiply_19,
				Texture=Path(Plugins.MoonToon, "Textures/T_White_Linear"),
				SamplerType="SAMPLERTYPE_LinearColor",
				SamplerSource="SSM_Wrap_WorldGroupSettings",
				MipValueMode="TMVM_MipLevel",
				ConstMipValue=0,
				SortPriority=14
			);
		#EndRegion

		// R+G Average (T24): an Endfield-style split map, the threshold spread over two 8-bit channels and
		// read back as (R + G) / 2 -- 511 levels, about 9 bits, from an uncompressed RGBA8 texture
		// (VectorDisplacementmap; any block compression mixes R and G and loses the extra bit). Tools/FaceSDF
		// writes it. Off = the channel mask, exactly as before.
		float SampledFacialShadowSdfRight = UE.Expression(Class="If", OutputType="float", A=RG_Average_Flag, B=0.5, AGreaterThanB=((Distance_Field_Facial_Shadow_Map.r + Distance_Field_Facial_Shadow_Map.g) * 0.5), AEqualsB=((Distance_Field_Facial_Shadow_Map.r + Distance_Field_Facial_Shadow_Map.g) * 0.5), ALessThanB=Distance_Field_Facial_Shadow_Map_Channel(Input = Distance_Field_Facial_Shadow_Map.rgba), EqualsThreshold=0.0);
		float2 MaterialExpressionTextureCoordinate_2_1 = UE.Expression(Class="TextureCoordinate", OutputType="float2");
		#Region "Texture Sample"
		float4 Distance_Field_Facial_Shadow_Map_1 =
			UE.Expression(
				Class="TextureSampleParameter2D",
				OutputType="float4",
				OutputIndex=5,
				ParameterName="Face SDF Map",
				Group="20 - Face: SDF Shadow",
				Desc="距离场面影贴图, 关于制作方法搜索\"Distance Field Facial Shadow\".\r\n压缩格式必须是\"Half Float (R16F)\", 且禁用sRGB.\r\n\r\n\r\nDistance Field Facial Shadow Map, search \"Distance Field Facial Shadow\" for the production method.\r\nThe compression format must be \"Half Float (R16F)\", and disable sRGB.",
				Coordinates=MaterialExpressionTextureCoordinate_2_1,
				Texture=Path(Plugins.MoonToon, "Textures/T_White_Linear"),
				SamplerType="SAMPLERTYPE_LinearColor",
				SamplerSource="SSM_Wrap_WorldGroupSettings",
				MipValueMode="TMVM_MipLevel",
				ConstMipValue=0,
				SortPriority=14
			);
		#EndRegion

		float SampledFacialShadowSdfLeft = UE.Expression(Class="If", OutputType="float", A=RG_Average_Flag, B=0.5, AGreaterThanB=((Distance_Field_Facial_Shadow_Map_1.r + Distance_Field_Facial_Shadow_Map_1.g) * 0.5), AEqualsB=((Distance_Field_Facial_Shadow_Map_1.r + Distance_Field_Facial_Shadow_Map_1.g) * 0.5), ALessThanB=Distance_Field_Facial_Shadow_Map_Channel_1(Input = Distance_Field_Facial_Shadow_Map_1.rgba), EqualsThreshold=0.0);

		#Region "Distance Field Facial Shadow"
		SdfLeft = UE.Expression(Class="If", OutputType="float", A=Flip_Left_Right_Flag, B=0.5, AGreaterThanB=SampledFacialShadowSdfRight, AEqualsB=SampledFacialShadowSdfRight, ALessThanB=SampledFacialShadowSdfLeft, EqualsThreshold=0.0);
		SdfRight = UE.Expression(Class="If", OutputType="float", A=Flip_Left_Right_Flag, B=0.5, AGreaterThanB=SampledFacialShadowSdfLeft, AEqualsB=SampledFacialShadowSdfLeft, ALessThanB=SampledFacialShadowSdfRight, EqualsThreshold=0.0);
		#EndRegion
	}
}
