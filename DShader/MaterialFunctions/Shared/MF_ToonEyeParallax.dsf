// Eye parallax: the iris sits behind the cornea, so it slides against the sclera as the head turns.
// That slide is most of what makes an anime eye read as an eye rather than as a decal.
//
// Refactor of the hand-written EyeUV node in M_EyeBase. Four things changed, and every one of them
// was visible:
//
//   * the offset is V.xy / V.z, not V.xy. Parallax is a tangent, not a sine: with no divide the
//     iris barely moves at exactly the grazing angles where its depth should be most obvious, so
//     the old node needed a large ParallaxScale and still read flat -- then swung too far in the
//     last few degrees, because a sine keeps growing where a tangent has already left the frame.
//   * the depth profile is a spherical cap, sqrt(1 - r^2), rather than the cone 1 - r/Edge. A cone
//     has a crease at its apex, and the apex is the middle of the iris: seen head-on the eye read
//     as a pyramid.
//   * that profile is shaped by pow(Profile, Curvature), whose old default was Curvature = 0 --
//     pow(x, 0) is 1, so the falloff the parameter existed to control was not applied at all. The
//     effect was uniform sliding of the whole eye, which is the one thing it must not be.
//   * the sample point is held inside the iris disc, so a hard turn can no longer drag one eye's
//     iris into the other eye's half of the texture.
//
// The old EdgeOffset / smoothstep rim mask is dropped rather than ported. With a spherical profile
// the offset already reaches zero at the rim; a second rim fade on top of it only fought the first,
// and its defaults (Edge = EdgeOffset = 1) attenuated the whole eye rather than its edge.

Function ToonEyeParallax(
	in float2 UV,
	in float3 TangentViewDir,
	in float4 IrisCenterRadius,
	in float Depth,
	in float Curvature,
	in float GrazingClamp,
	in float AtlasColumns,
	in float DebugMode,
	out float2 OutUV,
	out float4 Debug)
{
	// Both eyes normally share one texture side by side, so fold the atlas to a single eye before
	// anything is measured. This fold is what the old node's magic ParallaxRatio of 0.5 was
	// compensating for by hand, in a different space from the one it measured in.
	float Columns = max(AtlasColumns, 1.0);
	float2 LocalUV = float2(frac(UV.x * Columns), UV.y);

	// Iris space: the unit disc is the iris. Every control below is therefore in iris radii and
	// keeps its meaning when the texture layout changes.
	float2 IrisRadius = max(abs(IrisCenterRadius.zw), 1e-4);
	float2 P = (LocalUV - 0.5 - IrisCenterRadius.xy) / IrisRadius;
	float RadiusSq = dot(P, P);

	// A sphere, not a cone: full depth at the centre, exactly zero at the rim, no crease anywhere.
	float Profile = sqrt(saturate(1.0 - RadiusSq));
	Profile = pow(Profile, max(Curvature, 1e-3));

	// The perspective divide is the effect. Clamped because it runs to infinity edge-on, and an eye
	// seen edge-on should stop sliding rather than invert.
	// Named ViewDir, not View: `View` is the engine's own uniform buffer, and a local of that name
	// shadows it for the rest of the function body.
	float3 ViewDir = normalize(TangentViewDir);
	float CosView = max(abs(ViewDir.z), clamp(GrazingClamp, 0.05, 1.0));
	float2 Slide = (ViewDir.xy / CosView) * Depth;

	// Offset in iris space, then hold the sample inside the iris: past the rim is sclera, or worse,
	// the other eye.
	float2 SamplePoint = P - Slide * Profile;
	SamplePoint = SamplePoint / max(length(SamplePoint), 1.0);

	// Back to UV space. The fold compressed x by the column count, so undo exactly that much.
	float2 Offset = (P - SamplePoint) * IrisRadius / float2(Columns, 1.0);
	OutUV = UV - Offset;

	// ---- debug views -------------------------------------------------------------------------
	// Drawn from the values computed above rather than from a second copy of the maths. A debug
	// view with its own arithmetic stops telling the truth the first time one of the two is
	// edited, and this effect is exactly the kind that gets edited.
	//
	// Alpha is coverage, so a view can draw over the eye art (view 0) or replace it (the rest).
	float Radius01 = sqrt(RadiusSq);
	float Mode = floor(DebugMode + 0.5);
	Debug = float4(0.0, 0.0, 0.0, 0.0);

	if (Mode < 0.5)
	{
		// 0 -- where the iris is believed to be: ring at the radius, faint ring at half of it,
		// crosshair at the centre, over the real texture so the two can be lined up by eye. This
		// is the view that answers the Center/Radius guessing.
		// Widths are in screen pixels so they stay hairlines however far you zoom in.
#if PIXELSHADER
		float LinePx = fwidth(Radius01) * 1.5 + 1e-6;
		float CrossPxX = fwidth(P.x) * 1.5 + 1e-6;
		float CrossPxY = fwidth(P.y) * 1.5 + 1e-6;
#else
		float LinePx = 0.01;
		float CrossPxX = 0.01;
		float CrossPxY = 0.01;
#endif
		float Rim = 1.0 - smoothstep(0.0, LinePx, abs(Radius01 - 1.0));
		float MidRing = (1.0 - smoothstep(0.0, LinePx, abs(Radius01 - 0.5))) * 0.4;
		float Crosshair = max(1.0 - smoothstep(0.0, CrossPxX, abs(P.x)),
		                      1.0 - smoothstep(0.0, CrossPxY, abs(P.y))) * step(Radius01, 0.2);
		float3 Lines = float3(0.1, 1.0, 0.2) * (Rim + MidRing) + float3(1.0, 0.1, 0.1) * Crosshair;
		Debug = float4(Lines, saturate(Rim + MidRing + Crosshair));
	}
	else if (Mode < 1.5)
	{
		// 1 -- the depth profile, which is what Curvature reshapes. White at the centre, black at
		// the rim, and no crease anywhere unless something is wrong.
		Debug = float4(Profile, Profile, Profile, 1.0);
	}
	else if (Mode < 2.5)
	{
		// 2 -- how far the iris is travelling right now, in iris radii, and RED where the disc
		// clamp caught it. That red is the answer to "why has Depth stopped doing anything".
		float Travel = length(P - SamplePoint);
		float WasClamped = step(1.0, length(P - Slide * Profile));
		Debug = float4(lerp(float3(Travel, Travel, Travel), float3(1.0, 0.15, 0.0), WasClamped), 1.0);
	}
	else if (Mode < 3.5)
	{
		// 3 -- view angle against the grazing clamp. Bright facing the camera, dark edge-on, RED
		// once the clamp is holding it, which is the angle past which the slide stops responding.
		float Facing = abs(ViewDir.z);
		float Held = step(Facing, clamp(GrazingClamp, 0.05, 1.0));
		Debug = float4(lerp(float3(Facing, Facing, Facing), float3(1.0, 0.15, 0.0), Held), 1.0);
	}
	else
	{
		// 4 -- the atlas fold: one red-to-green ramp per eye. Two ramps across a single eye, or
		// one ramp spanning both, means Eye Atlas Columns is wrong -- and while it is wrong every
		// other view here is measuring the wrong space.
		Debug = float4(LocalUV.x, 1.0 - LocalUV.x, 0.0, 1.0);
	}
}

ShaderFunction(Name="MaterialFunctions/Shared/MF_ToonEyeParallax", Root="Plugin.MoonToon")
{
	Settings = {
		Description       = "Slides the iris against the sclera by view angle, measured in iris space.";
		ExposeToLibrary   = true;
		LibraryCategories = "MoonToon|Shared";
	}

	Inputs = {
		float2 UV [
			Description="The UV to offset -- normally the global UV, so every eye map moves together.";
		];
	}

	Outputs = {
		float2 UVOut;
		// rgb = the debug view, a = how much of it covers the material's own colour. Only ever
		// reached through "Enable Eye Parallax Debug" in the base input, so with that switch off
		// the node is culled and none of this reaches the shader.
		float4 DebugColor;
	}

	Properties = {
		ScalarParameter Eye_Parallax_Depth = 0.25 [
			ParameterName="Eye Parallax Depth";
			Group="06 - Eye Parallax";
			SortPriority=1;
			Description="虹膜在角膜之后多深, 单位是虹膜半径. 0 = 关闭, 0.2~0.4 是常用范围.\r\n这是唯一决定滑动幅度的参数: 它乘的是视线的正切, 所以头转得越偏, 位移增长越快 —— 真实的透视就是这个手感.\r\n\r\n\r\nHow far behind the cornea the iris sits, in iris radii. 0 disables it; 0.2-0.4 is the usual range.\r\nThis is the only control over how far the iris travels. It multiplies the tangent of the view angle, so the offset grows faster the further the head turns -- which is what real perspective feels like.";
		];
		VectorParameter Eye_Iris_Center_Radius = float4(0.0, 0.0, 0.5, 0.5) [
			ParameterName="Eye Iris Center and Radius";
			Group="06 - Eye Parallax";
			SortPriority=2;
			Description="xy = 虹膜中心相对单眼 UV 中心的偏移, zw = 虹膜半径(可以不等, 用来做椭圆眼).\r\n半径决定了效果的作用范围: 圆盘之外位移为零, 所以眼白和眼眶不会跟着动.\r\n\r\n\r\nxy offsets the iris centre from the middle of one eye's UV square; zw is its radius, per axis so an elliptical eye still works.\r\nThe radius is the extent of the whole effect: outside that disc the offset is zero, so the sclera and the lids stay put.";
		];
		ScalarParameter Eye_Parallax_Curvature = 1.0 [
			ParameterName="Eye Parallax Curvature";
			Group="06 - Eye Parallax";
			SortPriority=3;
			Description="球面深度曲线的指数. 1 = 真球面; 大于 1 把位移收紧到瞳孔附近(更像凸透镜), 小于 1 让整个虹膜一起滑.\r\n注意旧版这个参数默认 0, 而 pow(x, 0) 恒等于 1 —— 等于整只眼睛均匀滑动, 正是要避免的那种效果.\r\n\r\n\r\nExponent on the spherical depth profile. 1 is a true sphere; above 1 pulls the travel in towards the pupil (more lens-like), below 1 slides the whole iris together.\r\nThe old node defaulted this to 0, and pow(x, 0) is 1 -- uniform sliding of the entire eye, which is the one thing to avoid.";
		];
		ScalarParameter Eye_Parallax_Grazing_Clamp = 0.35 [
			ParameterName="Eye Parallax Grazing Clamp";
			Group="06 - Eye Parallax";
			SortPriority=4;
			Description="视线与眼球法线夹角的余弦下限. 掠射时正切趋于无穷, 这个值决定位移在哪里停住.\r\n0.35 约等于 70 度. 调小 = 侧脸时滑得更远(也更容易露馅), 调大 = 更早停住.\r\n\r\n\r\nLower bound on the cosine between the view and the eye's normal. The tangent runs away at grazing angles; this is where the travel stops instead.\r\n0.35 is about 70 degrees. Lower slides further on a profile view (and breaks sooner); higher stops earlier.";
		];
		ScalarParameter Eye_Atlas_Columns = 2.0 [
			ParameterName="Eye Atlas Columns";
			Group="06 - Eye Parallax";
			SortPriority=5;
			Description="一张贴图里横向排了几只眼睛. VRM / MMD 常见的左右眼并排就是 2, 单眼一张贴图填 1.\r\n填错的表现: 填 1 而实际是并排, 虹膜中心会落在两眼之间; 填 2 而实际是单眼, 眼睛中间会出现一条接缝.\r\n\r\n\r\nHow many eyes sit side by side across the texture. The VRM / MMD layout with both eyes in one map is 2; one eye per texture is 1.\r\nGetting it wrong shows: 1 on a side-by-side map puts the iris centre between the eyes, and 2 on a single-eye map puts a seam down the middle.";
		];
		ScalarParameter Eye_Parallax_Debug_View = 0.0 [
			ParameterName="Eye Parallax Debug View";
			Group="06 - Eye Parallax";
			SortPriority=10;
			Description="调试视图选择, 需要在基础输入里打开`Enable Eye Parallax Debug`才显示:\r\n\t0 = 虹膜圆盘(半径环 + 中心十字, 画在贴图之上) —— 对齐 Center/Radius 用这个\r\n\t1 = 深度剖面(白=中心, 黑=边缘) —— 看 Curvature 的形状\r\n\t2 = 当前实际位移量, 红色 = 被圆盘夹住了(Depth 加了没反应就是它)\r\n\t3 = 视角与掠射夹逼, 红色 = 已经被夹住, 再转也不会更远\r\n\t4 = 图集折叠(每只眼一条红→绿渐变) —— 先确认这个对, 否则上面几个量的都是错空间\r\n这是标量参数, 切视图不会重新编译着色器.\r\n\r\n\r\nWhich debug view to draw; needs `Enable Eye Parallax Debug` in the base input to be visible:\r\n\t0 = the iris disc (radius ring and centre crosshair, drawn over the art) -- the one for lining Center/Radius up\r\n\t1 = the depth profile, white at the centre -- what Curvature is shaping\r\n\t2 = how far the iris is travelling now; red where the disc clamp caught it\r\n\t3 = view angle against the grazing clamp; red once it is holding\r\n\t4 = the atlas fold, one red-to-green ramp per eye -- check this first, the others measure the wrong space while it is wrong\r\nA scalar, so switching views does not recompile.";
		];
	}

	Graph = {
		// Tangent space, so the effect follows the eye however the head is posed. It does mean the
		// eye geometry needs a sane tangent frame -- a VRM eye quad has one.
		float3 ViewWS = UE.CameraVectorWS();
		float3 ViewTS =
			UE.Expression(
				Class="Transform",
				OutputType="float3",
				Input=ViewWS,
				TransformSourceType="TRANSFORMSOURCE_World",
				TransformType="TRANSFORM_Tangent"
			);

		ToonEyeParallax(
			UV,
			ViewTS,
			Eye_Iris_Center_Radius,
			Eye_Parallax_Depth,
			Eye_Parallax_Curvature,
			Eye_Parallax_Grazing_Clamp,
			Eye_Atlas_Columns,
			Eye_Parallax_Debug_View,
			UVOut,
			DebugColor);
	}
}
