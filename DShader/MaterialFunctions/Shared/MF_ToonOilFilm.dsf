// Oil film, authored in the material (T30).
//
// It used to be a deferred modifier: a second, stylised GGX lobe the light pass added per light, with
// its colour looked up on the specular ramp by the view angle. That needed four payload bytes (RT4 /
// Data9), and those now carry the face SDF's extension (T24). Everything the look needs is already per
// pixel without them:
//
//   * the colour rings: the toon specular already indexes its ramp by "where in the highlight" -- U runs
//     from the lobe's edge (0) to its peak (1), the axis of Arknights: Endfield's spec ramp T4831. An
//     oil-film ramp (red -> yellow outside, pink -> cyan inside, T_ToonOilFilmSpecRamp) paints the rings.
//   * the flow: the per-pixel Specular Ramp UV Offset slides that ramp, and driving it from N.V makes
//     the rings move as the camera moves.
//   * optionally, real interference: UE's F_ThinFilm on a thickness map, as a tint on the toon
//     specular colour -- evaluated at the highlight's own peak, where V.H = N.V.
//
// What was given up: a separate second lobe (the film replaces the surface's highlight rather than
// adding one), the HighlightScale / FalloffPower sharpeners, and a roughness axis on the colour. The
// "half vector biased toward the camera" from Endfield is left for the next C++ batch.
//
// M_MoonToon applies the three outputs behind "Use Oil Film"; off, the specular pins are exactly what
// the base input authored.

import "Shared/ToonFunctions.dsh";

// F_ThinFilm (Engine/Shaders/Private/ThinFilmBSDF.ush) at the highlight peak, normalised into a tint so
// it changes the hue of the toon specular colour and not its level. Substrate.ush already includes the
// header; the include is for the legacy storage, and #pragma once makes it free otherwise.
Function float3 MoonToonOilFilmThinFilmTint(in float NoV, in float Thickness, in float Ior, in float Strength)
{
	#include "/Engine/Private/ThinFilmBSDF.ush"
	const float C = max(NoV, 0.02f);
	const float3 R = F_ThinFilm(C, C, C, float3(0.04f, 0.04f, 0.04f), float3(1.0f, 1.0f, 1.0f), max(Ior, 1.0f), max(Thickness, 0.0f));
	const float Peak = max(max(R.r, R.g), max(R.b, 1e-4f));
	return lerp(float3(1.0f, 1.0f, 1.0f), saturate(R / Peak), saturate(Strength));
}

ShaderFunction(Name="MaterialFunctions/Shared/MF_ToonOilFilm", Root="Plugin.MoonToon")
{
	Settings = {
		Description       = "Oil film as a specular ramp plus a view-driven ramp offset (T30), optionally tinted by UE thin-film interference.";
		ExposeToLibrary   = true;
		LibraryCategories = "MoonToon|Shared";
	}

	Inputs = {
		float3 NormalTS [
			Description="Tangent-space normal, the same one the surface ends up shading with.";
		];
	}

	Outputs = {
		// The specular atlas slice of Oil Film Ramp (the Specular Color Ramp Index pin).
		float RampIndex;
		// Added to the Specular Ramp UV Offset pin, which is 0.5-centred: +-0.5 here = the full
		// +-MoonSpecularColorRampUVOffsetMaxRange of the post-process volume (0.25 of U by default).
		float RampOffsetDelta;
		// Multiplies the toon specular colour. White unless "Use Oil Film Thin Film" is on.
		float3 SpecularTint;
	}

	Properties = {
		TextureObjectParameter Oil_Film_Ramp = Path(Plugins.MoonToon, "Textures/T_ToonOilFilmSpecRamp") [
			ParameterName="Oil Film Ramp";
			Group="45 - Oil Film";
			SortPriority=1;
			Description="油膜的高光 ramp: 横轴 0 = 高光斑边缘, 1 = 中心(和 Specular Color Ramp 同一个轴), 左端要黑(斑外没有高光). 默认是终末地 T4831 的取色: 外圈红->黄, 内圈粉->青. 自动注册进动态 Specular 图集, 不用手填 Index.\r\nThe film's specular ramp: U 0 = the highlight's edge, 1 = its centre (the Specular Color Ramp axis); keep the left end black. Default: Endfield T4831's colours, warm outer ring, cool inner ring. Registered into the dynamic specular atlas automatically. 颜色空间: 按贴图自身的 sRGB 设置解码后进动态图集(颜色 ramp, 通常 sRGB). Colour space: decoded per the texture's own sRGB setting before it enters the ramp atlas (a colour ramp, usually sRGB).";
		];
		ScalarParameter Oil_Film_Ramp_Row = -1.0 [
			ParameterName="Oil Film Ramp Row";
			Group="45 - Oil Film";
			SortPriority=2;
			Description="Oil Film Ramp 是多行图集时选第几行, 负数 = 垂直中心.\r\nRow of a multi-row Oil Film Ramp; negative = the vertical centre.";
			SliderMin=-1;
			SliderMax=63;
		];
		ScalarParameter Oil_Film_View_Shift = 0.6 [
			ParameterName="Oil Film View Shift";
			Group="45 - Oil Film";
			SortPriority=3;
			Description="色圈随视角滑动的幅度: 正视时 ramp 往一边偏, 掠射时往另一边偏, 镜头一动色圈就流动. 1 = 用满后处理体积的 Specular Ramp UV Offset Max Range(默认 U 的 0.25). 0 = 不随视角.\r\nHow far the rings slide with the view angle: face-on shifts the ramp one way, grazing the other, so the rings flow as the camera moves. 1 = the volume's full Specular Ramp UV Offset Max Range (0.25 of U by default). 0 = no view dependence.";
			SliderMin=0;
			SliderMax=1;
		];
		ScalarParameter Oil_Film_View_Power = 1.0 [
			ParameterName="Oil Film View Power";
			Group="45 - Oil Film";
			SortPriority=4;
			Description="视角项的幂: (1 - N.V)^Power. >1 让变化集中在边缘.\r\nPower on the view term (1 - N.V)^Power; above 1 the change gathers at the silhouette.";
			SliderMin=0.25;
			SliderMax=8;
		];
		ScalarParameter Oil_Film_Hue_Shift = 0.0 [
			ParameterName="Oil Film Hue Shift";
			Group="45 - Oil Film";
			SortPriority=5;
			Description="整体平移色圈, -1..1, 单位同 View Shift.\r\nShifts the rings as a whole, -1..1, in View Shift's units.";
			SliderMin=-1;
			SliderMax=1;
		];
		StaticSwitchParameter Use_Oil_Film_Thin_Film = false [
			ParameterName="Use Oil Film Thin Film";
			Group="45 - Oil Film|Thin Film";
			SortPriority=0;
			Description="再叠一层真实薄膜干涉(UE 的 F_ThinFilm): 按厚度贴图算出颜色, 乘到 toon 高光颜色上. 只改色相不改亮度.\r\nAdd real thin-film interference (UE's F_ThinFilm): a colour from the thickness map, multiplied into the toon specular colour. Hue only, not level.";
		];
		TextureObjectParameter Oil_Film_Thickness_Map = Path(Plugins.MoonToon, "Textures/T_White_Linear") [
			ParameterName="Oil Film Thickness Map";
			Group="45 - Oil Film|Thin Film";
			SortPriority=1;
			Description="膜厚贴图(R 通道, 关 sRGB), 0..1 映射到 Thickness Min..Max.\r\nFilm thickness (R, sRGB off), 0..1 -> Thickness Min..Max.";
		];
		ScalarParameter Oil_Film_Thickness_Min = 0.04 [
			ParameterName="Oil Film Thickness Min";
			Group="45 - Oil Film|Thin Film";
			SortPriority=2;
			Description="最薄处的膜厚, 用 F_ThinFilm 的单位(乘 10 才是光程, 微米). 0.03~0.15 是彩色区间, 再厚颜色会被冲淡成白.\r\nThinnest film in F_ThinFilm's unit (x10 = optical path, micrometres). 0.03-0.15 is the colourful range; thicker washes out to white.";
			SliderMin=0;
			SliderMax=0.3;
		];
		ScalarParameter Oil_Film_Thickness_Max = 0.12 [
			ParameterName="Oil Film Thickness Max";
			Group="45 - Oil Film|Thin Film";
			SortPriority=3;
			Description="最厚处的膜厚, 单位同上.\r\nThickest film, same unit.";
			SliderMin=0;
			SliderMax=0.3;
		];
		ScalarParameter Oil_Film_IOR = 1.45 [
			ParameterName="Oil Film IOR";
			Group="45 - Oil Film|Thin Film";
			SortPriority=4;
			Description="膜的折射率(油约 1.45).\r\nThe film's index of refraction (oil is about 1.45).";
			SliderMin=1;
			SliderMax=2.5;
		];
		ScalarParameter Oil_Film_Thin_Film_Strength = 1.0 [
			ParameterName="Oil Film Thin Film Strength";
			Group="45 - Oil Film|Thin Film";
			SortPriority=5;
			Description="薄膜色调的强度, 0 = 白(不改色).\r\nStrength of the thin-film tint; 0 = white.";
			SliderMin=0;
			SliderMax=1;
		];
	}

	Graph = {
		RampIndex =
			UE.Expression(
				Class="ToonRampAtlas",
				OutputType="float1",
				RampTexture=Oil_Film_Ramp,
				Row=Oil_Film_Ramp_Row,
				bSpecularRamp=true
			);

		float3 OilFilm_NormalWS = UE.Expression(Class="Transform", OutputType="float3", Input=NormalTS);
		float3 OilFilm_ViewWS = UE.Expression(Class="CameraVectorWS", OutputType="float3");
		float  OilFilm_NoV = saturate(dot(normalize(OilFilm_NormalWS), OilFilm_ViewWS));
		// -1 face-on, +1 grazing, then the hue shift; in pin units that is half of it.
		float  OilFilm_View = pow(1.0 - OilFilm_NoV, max(Oil_Film_View_Power, 0.01)) * 2.0 - 1.0;
		RampOffsetDelta = (OilFilm_View * Oil_Film_View_Shift + Oil_Film_Hue_Shift) * 0.5;

		float2 OilFilm_UV = UE.Expression(Class="TextureCoordinate", OutputType="float2", CoordinateIndex=0);
		float  OilFilm_Thickness = lerp(Oil_Film_Thickness_Min, Oil_Film_Thickness_Max, MF_ToonSampleLinear(Oil_Film_Thickness_Map, OilFilm_UV).r);
		SpecularTint = Use_Oil_Film_Thin_Film(
			True = MoonToonOilFilmThinFilmTint(OilFilm_NoV, OilFilm_Thickness, Oil_Film_IOR, Oil_Film_Thin_Film_Strength),
			False = float3(1.0, 1.0, 1.0));
	}
}
