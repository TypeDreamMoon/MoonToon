// The through-hair overlay, lifted out of MF_MoonToonBaseInput.
//
// The engine side of this is a forward re-draw (Moon_MeshPass_FaceOverlay) whose enrollment check is
// value-based: a material is in the pass only if FaceOverlayData is non-zero. That is why the switch
// collapses to a constant here rather than being read as a flag -- with it off the constant folds
// away and the material never enters the pass at all.
//
// Nine parameters and three packed float4s that nothing else in the base input touches.
//
// The mask exists because enrollment is per MATERIAL and eyes are not always their own section. A
// VRM whose face, brows and eyes share one material has no way to say "this half re-draws through
// hair and that half does not" -- the switch is all or nothing, and all of it is wrong. Masking the
// OPACITY gets there instead: the material is enrolled in the pass, and the pixels the mask zeroes
// write nothing when it runs. Per-pixel enrollment is not on the table; per-pixel opacity is the
// same thing where it lands.

import "Shared/ToonFunctions.dsh";

ShaderFunction(Name="MaterialFunctions/Shared/MF_ToonSeeThroughOverlay", Root="Plugin.MoonToon")
{
	Settings = {
		Description       = "Packs the through-hair overlay colour, its tuning and its occluder IDs.";
		ExposeToLibrary   = true;
		LibraryCategories = "MoonToon|Shared";
	}

	Inputs = {
		float3 BaseColor [
			Description="The material's final albedo, taken BEFORE any debug switch so debug views never leak into the overlay.";
		];
		opt float4 GlobalMaskA = float4(1.0, 1.0, 1.0, 1.0) [
			Description="The three packed mask maps the base input sampled, already resolved. Which one this feature reads is Through Hair Mask Source.";
		];
		opt float4 GlobalMaskB = float4(1.0, 1.0, 1.0, 1.0);
		opt float4 GlobalMaskC = float4(1.0, 1.0, 1.0, 1.0);
	}

	Outputs = {
		// rgb = through-hair overlay colour, a = opacity. Constant zero while the enable switch is
		// off, which keeps the material out of Moon_MeshPass_FaceOverlay entirely.
		float4 FaceOverlayData;
		// x = depth threshold cm (0 = global CVar), y = depth fade cm, z/w = view fade start/end.
		// Never affects pass enrollment; only read where FaceOverlayData survives.
		float4 FaceOverlayParams;
		// Extra accepted occluder CLASSES (1-255, -1 = unused), on top of the engine default
		// (r.MoonToon.FaceOverlay.HairStencil, 8). z/w reserved for two more slots. Since engine #10
		// these are FaceOverlay occluder classes, no longer CustomDepth stencil values.
		float4 FaceOverlayStencilIDs;
		// This material's own occluder class (engine #10): non-zero registers its meshes in the
		// FaceOverlay occluder layer (Moon_MeshPass_FaceOverlayOccluder). Constant zero while
		// 'Write Face Overlay Occluder' is off, which keeps the material out of that pass entirely.
		float FaceOverlayOccluderClass;
		// Which see-through group this material is in, for the per-character tier on
		// MoonToonActorComponent (Face Overlay Mode): 0 = auto (eyebrow-tagged = brow, else eye),
		// 1 = brow, 2 = eye. Appended last so every existing output index stays put.
		float FaceOverlayPart;
		// Hair-thickness falloff in cm for this material (0 = the engine default
		// r.MoonToon.FaceOverlay.Thickness, negative = none). Appended last, like Part.
		float FaceOverlayThickness;
	}

	Properties = {
		ScalarParameter Head_Forward_From_Baked_Face_UV_Flag = 0.0 [
			ParameterName="Head Forward From Baked Face UV";
			Group="21 - Face: See Through Overlay";
			SortPriority=18;
			Description="1 = 头朝前方向取自 MoonToon 烘焙的脸朝向(UV1.xy + UV2.x), 0 = 用 HeadForward 参数.\r\n以前是静态开关, 现在是标量(>= 0.5 算开): 不再多一套着色器排列. 现有实例的开关值已迁移过来.\r\n\r\n\r\n1 = the head forward comes from the MoonToon face-forward bake (UV1.xy + UV2.x), 0 = the HeadForward parameter.\r\nIt used to be a static switch; it is a scalar now (>= 0.5 counts as on), so it no longer costs a shader permutation. Existing instances' switch values were migrated.";
			SliderMin=0;
			SliderMax=1;
		];
		ScalarParameter Through_Hair_Opacity = 0.5 [
			ParameterName="Through Hair Opacity";
			Group="21 - Face: See Through Overlay";
			SortPriority=4;
			Description="(配合 Enable See Through Overlay) 眉毛/眼睛的描边被前发挡住时, 以这个不透明度透到头发上面, 跟眉眼本体一起透. 一般和对应眉眼材质的 Through Hair Opacity 设成一样.\r\n(With Enable See Through Overlay) the opacity this brow / eye outline re-blends with where front hair covers it, so the line reads through together with the part it outlines.";
			SliderMin=0;
			SliderMax=2;
		];
		VectorParameter Through_Hair_Tint = float4(1.0, 1.0, 1.0, 1.0) [
			ParameterName="Through Hair Tint";
			Group="21 - Face: See Through Overlay";
			SortPriority=5;
			Description="眉透/瞳透重画时乘在底色上的颜色. \r\nMultiplied with the material BaseColor for the through-hair re-blend only.";
		];
		ScalarParameter Through_Hair_Depth_Threshold = 0.0 [
			ParameterName="Through Hair Depth Threshold";
			Group="21 - Face: See Through Overlay";
			SortPriority=8;
			Description="重画允许的最大遮挡距离, cm. 0 = 用全局 r.MoonToon.FaceOverlay.DepthThreshold. \r\nMax occluder distance in cm for the re-blend. 0 = use the global r.MoonToon.FaceOverlay.DepthThreshold.";
			SliderMin=0;
			SliderMax=50;
		];
		ScalarParameter Through_Hair_Depth_Fade = 0.0 [
			ParameterName="Through Hair Depth Fade";
			Group="21 - Face: See Through Overlay";
			SortPriority=9;
			Description="阈值前最后 N cm 内逐渐淡出. 只在 Depth Threshold 大于 0 时用. \r\nOpacity feathers to zero over the last N cm before the threshold. Only used when Depth Threshold > 0; 0 with an overridden threshold = hard cutoff.";
			SliderMin=0;
			SliderMax=20;
		];
		ScalarParameter Through_Hair_View_Fade_Start = 0.02 [
			ParameterName="Through Hair View Fade Start";
			Group="21 - Face: See Through Overlay";
			SortPriority=10;
			Description="N dot V 低于这个值时完全不透(去掉几乎侧对的睫毛片). \r\nN dot V below which the re-blend is fully gone; only meant to remove near edge-on slivers such as a lash card seen side-on.";
			SliderMin=0;
			SliderMax=1;
		];
		ScalarParameter Through_Hair_View_Fade_End = 0.15 [
			ParameterName="Through Hair View Fade End";
			Group="21 - Face: See Through Overlay";
			SortPriority=11;
			Description="N dot V 高于这个值时全强度(正面). \r\nN dot V above which the re-blend is at full strength (frontal views).";
			SliderMin=0;
			SliderMax=1;
		];
		ScalarParameter Through_Hair_Occluder_ID_A = -1.0 [
			ParameterName="Through Hair Occluder ID A";
			Group="21 - Face: See Through Overlay";
			SortPriority=15;
			Description="Extra occluder to show through, named by its FaceOverlay occluder CLASS (1-255) -- the 'Face Overlay Occluder Class' the occluder's material sets with 'Write Face Overlay Occluder' on. Use for occluders other than front hair: hat brims, hair accessories, glasses frames. -1 = unused. (Engine #10: no longer a CustomDepth stencil value; the occluder needs no custom depth.)\r\n额外可透的遮挡物, 按它的眉透遮挡类别(1-255)指定: 帽檐、发饰、眼镜等不是前发的遮挡物用这个. -1 = 不用.";
			SliderMin=-1;
			SliderMax=255;
		];
		ScalarParameter Through_Hair_Occluder_ID_B = -1.0 [
			ParameterName="Through Hair Occluder ID B";
			Group="21 - Face: See Through Overlay";
			SortPriority=16;
			Description="Second accepted occluder class. -1 = unused.\r\n第二个可透的遮挡类别. -1 = 不用.";
			SliderMin=-1;
			SliderMax=255;
		];
		// --- Front-hair depth gate (verbatim port of Game DShader/Functions/MF_TransparentFrontHair) ---
		// Requires the CustomDepth stencil convention (eye/brow=1, face=2, hair=8, authored per
		// material via the Material Stencil Value override + Render CustomDepth Pass on the mesh).
		// Off by default: with no custom depth authored the IsHair test reads the far-plane dummy
		// and would zero the overlay everywhere.
		ScalarParameter Hair_Stencil_Value = 8.0 [
			ParameterName="Front Hair Gate Stencil";
			Group="21 - Face: See Through Overlay";
			SortPriority=19;
			Description="算作前发的 CustomDepth 模板值(项目约定: 眉眼 1, 脸 2, 头发 8). \r\nCustomDepth stencil value that counts as front hair (project convention: eye/brow=1, face=2, hair=8).";
			SliderMin=0;
			SliderMax=255;
		];
		ScalarParameter Front_Depth_Threshold = 0.01 [
			ParameterName="Front Hair Gate Depth Threshold";
			Group="21 - Face: See Through Overlay";
			SortPriority=20;
			Description="眼睛到遮挡物的最小深度差, cm. \r\nMinimum positive eye-to-occluder depth gap in centimeters.";
			SliderMin=0;
			SliderMax=5;
		];
		ScalarParameter Front_View_Fade_Start = 0.3 [
			ParameterName="Front Hair Gate View Fade Start";
			Group="21 - Face: See Through Overlay";
			SortPriority=21;
			Description="头朝向对齐度在这里开始出现透视. \r\nHead-forward alignment where the overlay starts to appear.";
			SliderMin=0;
			SliderMax=1;
		];
		ScalarParameter Front_View_Fade_End = 0.7 [
			ParameterName="Front Hair Gate View Fade End";
			Group="21 - Face: See Through Overlay";
			SortPriority=22;
			Description="头朝向对齐度在这里达到全强度. \r\nHead-forward alignment where the overlay reaches full strength.";
			SliderMin=0;
			SliderMax=1;
		];
		VectorParameter Head_Forward = float4(0.0, 0.0, 0.0, 0.0) [
			ParameterName="HeadForward";
			Group="21 - Face: See Through Overlay";
			SortPriority=23;
			Description="世界空间的头朝前方向(和 MF_HeadVector 同名, 角色蓝图驱动 HeadForward 时这里也收到). 0 = 关掉视角淡出. 打开 Head Forward From Baked Face UV 时忽略. \r\nWorld-space head forward, the same parameter name MF_HeadVector binds, so a character BP driving 'HeadForward' feeds this too. Zero disables the view fade. Ignored when 'Head Forward From Baked Face UV' is on.";
		];

		// --- Registered occluder (engine #10) ---
		// Set on the OCCLUDER's material (front hair, a hat brim...), not on the eye / brow: the
		// FaceOverlay pass reads a dedicated occluder layer these materials write, instead of
		// CustomDepth / CustomStencil, which stay free for the project.
		ScalarParameter Face_Overlay_Occluder_Class = 8.0 [
			ParameterName="Face Overlay Occluder Class";
			Group="21 - Face: See Through Overlay";
			SortPriority=7;
			Description="(配合 Is Face Overlay Occluder 开关) 把这个材质登记为眉透/瞳透的遮挡物(通常是前发), 写入 FaceOverlay 专用遮挡层, 不再需要 CustomDepth / CustomStencil. 遮挡类别(1-255). 默认 8 = 引擎默认接受的'前发'类别(r.MoonToon.FaceOverlay.HairStencil). 帽檐/发饰等可用其他类别, 再在眉眼材质的 Through Hair Occluder ID A/B 里接受它.\r\n(With the Is Face Overlay Occluder switch) registers this material as a see-through occluder, usually front hair, in the FaceOverlay occluder layer -- no CustomDepth / CustomStencil needed. Occluder class (1-255). 8 is the class the engine accepts as front hair by default; give hat brims / accessories another class and accept it on the brow / eye material's Occluder ID A/B.";
			SliderMin=1;
			SliderMax=255;
		];

		ScalarParameter Through_Hair_Part = 0.0 [
			ParameterName="Through Hair Part";
			Group="21 - Face: See Through Overlay";
			SortPriority=3;
			Description="这个材质在角色'眉眼透视档位'(MoonToonActorComponent 的 Face Overlay Mode: 不透/仅透眉/半透/全透)里算眉还是算眼: 0 = 自动(标了眉毛特性的算眉, 其余算眼), 1 = 眉, 2 = 眼(瞳孔/睫毛/眼白/高光). 睫毛卡片用普通 toon 着色时请手动设 2.\r\nWhich see-through group the per-character tier (Face Overlay Mode on MoonToonActorComponent: none / brows only / half / full) treats this material as: 0 = auto (eyebrow-tagged is a brow, everything else an eye), 1 = brow, 2 = eye (iris, lashes, eye white, highlights).";
			SliderMin=0;
			SliderMax=2;
		];
		ScalarParameter Through_Hair_Thickness = 0.0 [
			ParameterName="Through Hair Thickness";
			Group="21 - Face: See Through Overlay";
			SortPriority=12;
			Description="头发厚度感: 头发离这个部件每远 N cm, 透出强度减半. 刘海贴着眉毛时透得明显, 侧面隔着厚厚的侧发只剩淡淡的影子, 两侧被不同发片盖住时强度也自然不同. 0 = 用引擎默认值 r.MoonToon.FaceOverlay.Thickness(6 cm), 负数 = 不衰减. 想让侧面也透得更清楚就调大, 想让只有贴得很近的刘海才透就调小.\r\nHair-thickness falloff: the re-blend halves for every N cm between the hair in front and this part. 0 = the engine default (r.MoonToon.FaceOverlay.Thickness, 6 cm), negative = no falloff.";
			SliderMin=-1;
			SliderMax=30;
		];
		ScalarParameter Through_Hair_Top_View_Fade_Start = 35.0 [
			ParameterName="Through Hair Top View Fade Start";
			Group="21 - Face: See Through Overlay";
			SortPriority=13;
			Description="俯视淡出起点(度): 视线高出头部水平面这么多度时开始变淡. 从上往下看时刘海是顺着视线盖在眉眼上的, 透出来像五官浮在头发上面. 按头部坐标算(有脸朝前方向时去掉它的分量), 低头也算俯视, 左右转头/侧面不受影响; 没有朝向来源时用世界上方向. 设成 90 或以上 = 关闭.\r\nTop-down fade start, degrees of camera elevation above the head's horizontal plane. Seen from above, the fringe lies over the brows / eyes along the view and a re-blend reads as features floating on the hair. Head-relative when a head-forward source exists (a nodding head counts too; yaw / profiles never do), world up otherwise. 90 or more turns it off.";
			SliderMin=0;
			SliderMax=90;
		];
		ScalarParameter Through_Hair_Top_View_Fade_End = 55.0 [
			ParameterName="Through Hair Top View Fade End";
			Group="21 - Face: See Through Overlay";
			SortPriority=14;
			Description="俯视淡出终点(度): 高于这个仰角完全不透. 要大于起点.\r\nTop-down fade end, degrees: above this elevation the part no longer reads through. Must be greater than Start.";
			SliderMin=0;
			SliderMax=90;
		];
		ScalarParameter Through_Hair_Mask_Source = 0.0 [
			ParameterName="Through Hair Mask Source";
			Group="21 - Face: See Through Overlay";
			SortPriority=1;
			Description="哪些像素参与眉透/瞳透, 读哪张打包遮罩图: 0 = 不遮罩(整个材质都参与), 1/2/3 = Global Mask Map 1/2/3, 通道由下面的选择器决定.\r\n为的是眼睛/眉毛和别的东西共用一个材质的情况(单 Section 的脸): 入列是按材质判定的, 开关一刀切, 这个遮罩才能在材质内部把范围划出来.\r\n注意它不是省下一次采样 —— 打包图本来就只采样一次, 这里只是从已有结果里挑一个通道. 相比自带一张贴图, 省下的是一次取样和一个贴图参数.\r\n\r\n\r\nWhich pixels take part in the through-hair re-draw, and which packed mask map to read: 0 is no mask (the whole material takes part), 1/2/3 are Global Mask Map 1/2/3, with the channel picked below.\r\nFor the case where eyes or brows share one material with everything else (a single-section face): enrollment is decided per material and the switch is all-or-nothing, so this is what draws the line inside it.\r\nNote this does not save a sample -- the packed map is sampled once anyway. What it saves against carrying its own texture is a fetch and a texture parameter.";
			SliderMin=0;
			SliderMax=3;
		];
		ChannelMaskParameter Through_Hair_Mask_Channel = float4(1.0, 0.0, 0.0, 0.0) [
			ParameterName="Through Hair Mask Channel";
			Group="21 - Face: See Through Overlay";
			SortPriority=2;
			MaskChannel=Red;
			Description="眉透/瞳透遮罩用哪个通道. 选通道(R/G/B/A). Picks the channel (R/G/B/A). ";
		];
	}

	Graph = {
		#Region "See Through Overlay"
		// No texture of its own: the packed maps were sampled once by the base input, and Source 0
		// resolves to white so a material that never configured this multiplies by 1.
		// Initialised rather than declared bare: a Graph local passed as an out argument is a shape
		// this file has not proven, and white is the value that means "no mask" if it ever slipped.
		float4 Through_Hair_Mask_Packed = float4(1.0, 1.0, 1.0, 1.0);
		SelectGlobalMaskMap(GlobalMaskA, GlobalMaskB, GlobalMaskC, Through_Hair_Mask_Source, Through_Hair_Mask_Packed);
		float Through_Hair_Mask_Value = Through_Hair_Mask_Channel(Input = Through_Hair_Mask_Packed);
		#EndRegion

		#Region "Front Hair Depth Gate"
		// Verbatim port of MF_TransparentFrontHair (Game DShader), applied to the OPACITY like the
		// mask above. The gates that reference the scene rather than the occluder registry --
		// scene-depth distance and the occlusion test itself -- stay engine-side (the overlay pass
		// only ever shades occluded fragments, gated by Through Hair Depth Threshold), and the
		// EyeBackWhiteMask cull is what Through Hair Mask Source already does; what the reference
		// adds is the three tests below.
		float4 FrontHair_CustomStencil = UE.Expression(
			Class="SceneTexture",
			OutputType="float4",
			SceneTextureId="PPI_CustomStencil"
		);
		float4 FrontHair_CustomDepth = UE.Expression(
			Class="SceneTexture",
			OutputType="float4",
			SceneTextureId="PPI_CustomDepth"
		);
		float FrontHair_PixelDepth = UE.Expression(Class="PixelDepth", OutputType="float");

		// Nearest custom-depth surface must BE hair...
		float FrontHair_IsHair = 1.0 - step(0.5, abs(FrontHair_CustomStencil.r - Hair_Stencil_Value));
		// ...and sit in FRONT of this fragment. Keep the signed difference: back hair goes negative
		// and must fail.
		float FrontHair_InFront = step(Front_Depth_Threshold, FrontHair_PixelDepth - FrontHair_CustomDepth.r);

		// Head-forward source. Preferred: the MoonToon "Bake Face Forward" data -- a tangent-space
		// direction remapped to [0,1] in UV1.xy + UV2.x, the exact channels and decode the SDF face
		// shadow reads in MF_MoonToonBaseInput -- because it rides the skin bind and follows the
		// head BONE with nothing driving it. The switch exists because an UNBAKED mesh's UV1/UV2
		// hold import residue that would decode to a garbage direction; leave it off and the
		// HeadForward parameter (BP-driven or hand-set) is used instead, and a zero parameter
		// disables just the view-fade term rather than killing the overlay.
		float2 FrontHair_BakeUV1 = UE.Expression(Class="TextureCoordinate", OutputType="float2", CoordinateIndex=1);
		float2 FrontHair_BakeUV2 = UE.Expression(Class="TextureCoordinate", OutputType="float2", CoordinateIndex=2);
		float3 FrontHair_BakedTS = (float3(FrontHair_BakeUV1.rg, FrontHair_BakeUV2.r) * 2.0) + -1.0;
		float3 FrontHair_BakedWS = normalize(UE.Expression(Class="Transform", OutputType="float3", Input=FrontHair_BakedTS));
		float3 FrontHair_HeadSource = UE.Expression(Class="If", OutputType="float3", A=Head_Forward_From_Baked_Face_UV_Flag, B=0.5, AGreaterThanB=FrontHair_BakedWS, AEqualsB=FrontHair_BakedWS, ALessThanB=Head_Forward.rgb, EqualsThreshold=0.0);

		float3 FrontHair_ViewDir = normalize(UE.CameraVectorWS());
		float FrontHair_HeadLen = length(FrontHair_HeadSource);
		float FrontHair_Align = saturate(dot(FrontHair_ViewDir, FrontHair_HeadSource / max(FrontHair_HeadLen, 0.001)));
		float FrontHair_ViewMask = lerp(1.0,
			smoothstep(Front_View_Fade_Start, Front_View_Fade_End, FrontHair_Align),
			step(0.001, FrontHair_HeadLen));

		float FrontHair_Mask = FrontHair_IsHair * FrontHair_InFront * FrontHair_ViewMask;

		// Top-down fade. Independent of the gate above (always on unless Start >= 90). The head's up is
		// world Z with the head-forward component removed, so a head tipped forward under a level camera
		// counts as seen from above while turning the head (profiles) never does; with no head-forward
		// source the forward is zero and this is plain world Z. Pre-tier (folded into the alpha), so it
		// also drops enrollment once the elevation passes End.
		float3 TopView_WorldUp = float3(0.0, 0.0, 1.0);
		float3 TopView_HeadF = FrontHair_HeadSource / max(FrontHair_HeadLen, 0.001);
		float3 TopView_UpRaw = TopView_WorldUp - TopView_HeadF * dot(TopView_WorldUp, TopView_HeadF);
		float TopView_UpLen = length(TopView_UpRaw);
		float3 TopView_Up = lerp(TopView_WorldUp, TopView_UpRaw / max(TopView_UpLen, 0.001),
			step(0.001, FrontHair_HeadLen) * step(0.1, TopView_UpLen));
		float TopView_ElevationDeg = asin(clamp(dot(FrontHair_ViewDir, TopView_Up), -1.0, 1.0)) * 57.29578;
		float TopView_Fade = lerp(
			1.0 - smoothstep(Through_Hair_Top_View_Fade_Start, Through_Hair_Top_View_Fade_End, TopView_ElevationDeg),
			1.0,
			step(90.0, Through_Hair_Top_View_Fade_Start));
		float FrontHair_Gate = UE.Expression(
			Class="StaticSwitchParameter",
			OutputType="float",
			True=FrontHair_Mask,
			False=1.0,
			Group="21 - Face: See Through Overlay",
			SortPriority=17,
			ParameterName="Use Front Hair Depth Gate",
			Desc="开 = 眉透/瞳透只在前发真的挡在前面时出现(读 CustomDepth / Stencil). \r\nOn = see-through only where front hair is really in front (reads CustomDepth / Stencil)."
		);
		#EndRegion

		float3 Multiply_Overlay = (BaseColor * Through_Hair_Tint.rgb);
		// The mask multiplies the OPACITY, which is also what carries enrollment: a masked-out pixel
		// leaves the alpha at zero and the re-draw writes nothing there.
		FaceOverlayData =
			UE.Expression(
				Class="StaticSwitchParameter",
				OutputType="float4",
				True=float4(Multiply_Overlay, (Through_Hair_Opacity * Through_Hair_Mask_Value * FrontHair_Gate * TopView_Fade)),
				False=float4(0.0, 0.0, 0.0, 0.0),
				Group="21 - Face: See Through Overlay",
				SortPriority=0,
				ParameterName="Enable See Through Overlay",
				Desc="开 = 这个部件(眉/眼)被前发挡住时透出来. \r\nOn = this part (brow / eye) shows through the front hair that covers it."
			);
		FaceOverlayParams = float4(Through_Hair_Depth_Threshold, Through_Hair_Depth_Fade, Through_Hair_View_Fade_Start, Through_Hair_View_Fade_End);
		FaceOverlayStencilIDs = float4(Through_Hair_Occluder_ID_A, Through_Hair_Occluder_ID_B, -1.0, -1.0);
		FaceOverlayOccluderClass =
			UE.Expression(
				Class="StaticSwitchParameter",
				OutputType="float",
				True=Face_Overlay_Occluder_Class,
				False=0.0,
				Group="21 - Face: See Through Overlay",
				SortPriority=6,
				ParameterName="Write Face Overlay Occluder",
				Desc="开 = 这个材质是眉透/瞳透的遮挡物(通常是前发), 写入专用遮挡层. \r\nOn = this material is a see-through occluder (usually front hair) and writes the overlay occluder layer."
			);
		FaceOverlayPart = Through_Hair_Part;
		FaceOverlayThickness = Through_Hair_Thickness;
	}
}
