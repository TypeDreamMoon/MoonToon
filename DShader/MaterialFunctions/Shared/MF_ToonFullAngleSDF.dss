// MF_ToonFullAngleSDF -- the full-angle face SDF evaluated in the material (task T18, gap G26).
//
// The atlas comes from Tools/SDF360 (bake_sdf360.py): a theta x phi grid of signed distance fields,
// one per light direction in the head frame. This function finds the four cells around the light
// direction, samples each at the face UV, interpolates the SIGNED DISTANCE and returns
//
//     SdfLeft = saturate(0.5 + s * Gain),    s > 0 = lit,    Gain = SpreadTexels / (2 * SoftTexels)
//
// which goes into the Skin closure's Facial Shadow SDF Left pin with "Facial Shadow SDF Pre-Evaluated"
// set on the node: the trunk then thresholds it at 0.5 for the main light and stops doing its own
// azimuth split and elevation lift (both are in the bake). M_MoonToon's "Use Full Angle SDF" does that.
//
// The grid values MUST be copied from the bake's sdf360.json (grid / atlas / encoding). The lookup is
// Tools/SDF360/sdf360_sample.hlsl's, unchanged.

/// @asset /MoonToon/MaterialFunctions/MF_MoonMainLightDirection
extern float3 MF_MoonMainLightDirection();

/// @name Full Angle SDF Atlas   @group 20 - Face: SDF Shadow|Full Angle   @sort 1   @sampler LinearColor
/// @default /MoonToon/Textures/T_White_Linear
/// @desc 全角度 SDF 图集(Tools/SDF360 烘焙, 关 sRGB, 不要 mip, Clamp). Full-angle SDF atlas from Tools/SDF360 (sRGB off, no mips, clamp).
uniform Texture2D Full_Angle_SDF_Atlas;

/// @name Full Angle SDF Theta Count   @group 20 - Face: SDF Shadow|Full Angle   @sort 2   @slider 2 36
/// @desc 全角度 SDF 图集的水平角数(sdf360.json grid.theta_count). Number of horizontal angles in the atlas, from sdf360.json grid.theta_count.
uniform float Full_Angle_SDF_Theta_Count = 8.0;

/// @name Full Angle SDF Phi Count   @group 20 - Face: SDF Shadow|Full Angle   @sort 3   @slider 1 19
/// @desc 全角度 SDF 图集的仰角数(grid.phi_count). Number of elevation angles in the atlas, from grid.phi_count.
uniform float Full_Angle_SDF_Phi_Count = 7.0;

/// @name Full Angle SDF Phi Min   @group 20 - Face: SDF Shadow|Full Angle   @sort 4   @slider -90 90
/// @desc 最低仰角, 度(grid.phi_min). Lowest elevation in degrees, from grid.phi_min.
uniform float Full_Angle_SDF_Phi_Min = -90.0;

/// @name Full Angle SDF Phi Max   @group 20 - Face: SDF Shadow|Full Angle   @sort 5   @slider -90 90
/// @desc 最高仰角, 度(grid.phi_max). Highest elevation in degrees, from grid.phi_max.
uniform float Full_Angle_SDF_Phi_Max = 90.0;

/// @name Full Angle SDF Cell Size   @group 20 - Face: SDF Shadow|Full Angle   @sort 6
/// @desc 单元格尺寸, 像素(x 宽 y 高, atlas.cell_size). Cell size in texels, x width and y height, from atlas.cell_size.
uniform float4 Full_Angle_SDF_Cell_Size = float4(256.0, 256.0, 0.0, 0.0);

/// @name Full Angle SDF Padding   @group 20 - Face: SDF Shadow|Full Angle   @sort 7   @slider 0 16
/// @desc 单元格留边, 像素(atlas.padding). Padding around each cell in texels, from atlas.padding.
uniform float Full_Angle_SDF_Padding = 4.0;

/// @name Full Angle SDF Mirror   @group 20 - Face: SDF Shadow|Full Angle   @sort 8   @slider 0 1
/// @desc sdf360.json grid.mirror: 1 = 只烘了 0..180 度, 另一半镜像脸 UV. 1 = only 0..180 baked, the other half mirrors the face UV.
uniform float Full_Angle_SDF_Mirror = 0.0;

/// @name Full Angle SDF Spread Texels   @group 20 - Face: SDF Shadow|Full Angle   @sort 9   @slider 1 64
/// @desc SDF 编码跨度, 像素(encoding.spread_texels). Encoding spread in texels, from encoding.spread_texels.
uniform float Full_Angle_SDF_Spread_Texels = 8.0;

/// @name Full Angle SDF Soft Texels   @group 20 - Face: SDF Shadow|Full Angle   @sort 10   @slider 0.1 16
/// @desc 明暗交界软化宽度(格子像素). How many cell texels the terminator softens over.
uniform float Full_Angle_SDF_Soft_Texels = 1.5;

/// @custom
float MoonSdf360Evaluate(Texture2D Atlas, float2 FaceUv, float3 Light, float3 Fwd, float3 HeadUp, float4 Grid, float4 Layout)
{
	// Grid = (ThetaCount, PhiCount, PhiMin, PhiMax), Layout = (CellW, CellH, Padding, Mirror).
	const float Nt = max(Grid.x, 1.0);
	const float Np = max(Grid.y, 1.0);
	const float2 Cell = Layout.xy;
	const float Pad = Layout.z;
	const float3 U = normalize(HeadUp);
	const float3 F = normalize(Fwd - U * dot(Fwd, U));
	const float3 R = cross(U, F);
	const float3 Ln = normalize(Light);
	const float X = dot(Ln, F);
	const float Y = dot(Ln, R);
	const float Theta = (X * X + Y * Y) < 1e-12 ? 0.0 : degrees(atan2(Y, X));
	const float Phi = degrees(asin(clamp(dot(Ln, U), -1.0, 1.0)));
	float I0, I1, J0, J1, Tt, Tp, Flip;
	if (Layout.w > 0.5)
	{
		Flip = Theta < 0.0 ? 1.0 : 0.0;
		const float Step = 180.0 / max(Nt - 1.0, 1.0);
		const float Uu = clamp(abs(Theta) / Step, 0.0, Nt - 1.0);
		I0 = min(floor(Uu), max(Nt - 2.0, 0.0));
		Tt = Uu - I0;
		I1 = min(I0 + 1.0, Nt - 1.0);
	}
	else
	{
		Flip = 0.0;
		const float Step = 360.0 / Nt;
		const float Uu = (Theta + 180.0) / Step;
		const float F0 = floor(Uu);
		Tt = Uu - F0;
		I0 = F0 - Nt * floor(F0 / Nt);
		I1 = I0 + 1.0;
		if (I1 >= Nt) { I1 -= Nt; }
	}
	if (Np > 1.5)
	{
		const float Step = (Grid.w - Grid.z) / (Np - 1.0);
		const float V = clamp((Phi - Grid.z) / Step, 0.0, Np - 1.0);
		J0 = min(floor(V), Np - 2.0);
		Tp = V - J0;
		J1 = J0 + 1.0;
	}
	else
	{
		J0 = 0.0; J1 = 0.0; Tp = 0.0;
	}
	float2 Uv = saturate(FaceUv);
	if (Flip > 0.5) { Uv.x = 1.0 - Uv.x; }
	const float2 Stride = Cell + 2.0 * Pad;
	const float2 AtlasSize = float2(Nt, Np) * Stride;
	const float S00 = (Atlas.SampleLevel(AtlasSampler, (float2(I0, J0) * Stride + Pad + Uv * Cell) / AtlasSize, 0).r - 0.5) * 2.0;
	const float S10 = (Atlas.SampleLevel(AtlasSampler, (float2(I1, J0) * Stride + Pad + Uv * Cell) / AtlasSize, 0).r - 0.5) * 2.0;
	const float S01 = (Atlas.SampleLevel(AtlasSampler, (float2(I0, J1) * Stride + Pad + Uv * Cell) / AtlasSize, 0).r - 0.5) * 2.0;
	const float S11 = (Atlas.SampleLevel(AtlasSampler, (float2(I1, J1) * Stride + Pad + Uv * Cell) / AtlasSize, 0).r - 0.5) * 2.0;
	return lerp(lerp(S00, S10, Tt), lerp(S01, S11, Tt), Tp);
}

// The view's style preset, face group (G26, R2b): the terminator's half-width in normalised SDF units,
// or -1 when the preset did not change the group (MOONTOON_STYLE_FLAG_FACE) -- then the material's own
// Soft Texels stand and nothing below changes.
/// @custom
float MoonToonStyleFaceSoftness()
{
#include "/Engine/Shared/MoonToonStyleDefinitions.h"
	const uint StyleFlags = (uint)max(Scene.ZMoonToon.StyleBuffer[MOONTOON_STYLE_SLOT_FLAGS].x, 0.0f);
	if ((StyleFlags & MOONTOON_STYLE_FLAG_ENABLE) == 0u || (StyleFlags & MOONTOON_STYLE_FLAG_FACE) == 0u)
	{
		return -1.0f;
	}
	return max(Scene.ZMoonToon.StyleBuffer[MOONTOON_STYLE_SLOT_FACE].x, 0.0f);
}

float3 FullAngleSdfSafeNormalize(float3 V, float3 Fallback)
{
	float L = length(V);
	return L > 0.0001 ? V / L : Fallback;
}

/// @library MoonToon|Shared
/// @param FaceUV      The face UV the atlas was baked in (the face texture's UV).
/// @param LightDirWS  The key light, toward the light. Unconnected (zero) = MF_MoonMainLightDirection.
/// @param ForwardWS   Head forward, world (the baked face-forward vector, or the light rig's head frame).
/// @param UpWS        Head up, world. Unconnected (zero) = the object's up axis.
/// @return            SdfLeft for the Skin closure: 0.5 = the terminator, lit above.
export float MF_ToonFullAngleSDF(float2 FaceUV, float3 LightDirWS, float3 ForwardWS, float3 UpWS)
{
	float3 L = FullAngleSdfSafeNormalize(LightDirWS, MF_MoonMainLightDirection());
	float3 Up = FullAngleSdfSafeNormalize(UpWS, UE.Expression(Class = "ObjectOrientation"));
	float3 Fwd = FullAngleSdfSafeNormalize(ForwardWS, float3(1.0, 0.0, 0.0));
	float4 Grid = float4(Full_Angle_SDF_Theta_Count, Full_Angle_SDF_Phi_Count, Full_Angle_SDF_Phi_Min, Full_Angle_SDF_Phi_Max);
	float4 Layout = float4(Full_Angle_SDF_Cell_Size.x, Full_Angle_SDF_Cell_Size.y, Full_Angle_SDF_Padding, Full_Angle_SDF_Mirror);
	float S = MoonSdf360Evaluate(Full_Angle_SDF_Atlas, FaceUV, L, Fwd, Up, Grid, Layout);
	float Gain = Full_Angle_SDF_Spread_Texels / (2.0 * max(Full_Angle_SDF_Soft_Texels, 0.001));
	// A preset's Facial Shadow Softness h replaces it: 0..1 over S in [-h, h].
	float StyleSoftness = MoonToonStyleFaceSoftness();
	Gain = lerp(Gain, 1.0 / (2.0 * max(StyleSoftness, 0.001)), step(0.0, StyleSoftness));
	return saturate(0.5 + S * Gain);
}
