// Hair highlight mask, called by MF_ToonFeature_HairHighlightMask -- not by the base input.
//
// The mask is sampled through a UV whose V is pushed up and down by the main light's elevation, so
// the highlight band travels across the hair as the light moves rather than staying painted on.
//
// Everything declared here is therefore a parameter OF THAT FEATURE: reachable only through the
// taken side of Is HairHighlightMask, so a material that selected another feature neither shows
// these rows nor pays for the fetch. That is also why every Group string now reads
// "33 - Feature: Hair Highlight Mask", including the nine light-elevation offsets (AddOffset,
// DynMin, DynMax, ElevMin, ElevMax, Curve, ClampMin, ClampMax, VSign). Those were filed under
// "02 - Distance Field Facial Shadow" for historical reasons, which was already wrong -- the SDF
// facial shadow samples use a plain mirrored texture coordinate and never see this UV -- and would
// have become visibly wrong once they started appearing and disappearing with a hair feature.

import "Shared/ToonFunctions.dsh";

ShaderFunction(Name="MaterialFunctions/Shared/MF_ToonHairHighlightMask", Root="Plugin.MoonToon")
{
	Settings = {
		Description       = "Samples the hair highlight mask through a light-elevation driven UV offset.";
		ExposeToLibrary   = true;
		LibraryCategories = "MoonToon|Shared";
	}

	Inputs = {
		opt float4 GlobalMaskA = float4(1.0, 1.0, 1.0, 1.0) [
			Description="The three packed mask maps the base input sampled, already resolved. Which one this feature reads is Hair Highlight Mask Source, and only while Hair Highlight Mask From Global Map is on.";
		];
		opt float4 GlobalMaskB = float4(1.0, 1.0, 1.0, 1.0);
		opt float4 GlobalMaskC = float4(1.0, 1.0, 1.0, 1.0);
	}

	Outputs = {
		float HairHighlightMask;
	}

	Properties = {
		ChannelMaskParameter Hair_Highlight_Mask_Channel = float4(1.0, 0.0, 0.0, 0.0) [
			ParameterName="Hair Highlight Mask Channel";
			Group="35 - Feature: Hair Highlight Mask";
			SortPriority=103;
			MaskChannel=Red;
			Description="发丝高光遮罩用哪个通道. 选通道(R/G/B/A). Picks the channel (R/G/B/A). ";
		];
		ScalarParameter Hair_Highlight_Mask_Source = 1.0 [
			ParameterName="Hair Highlight Mask Source";
			Group="35 - Feature: Hair Highlight Mask";
			SortPriority=101;
			Description="读哪张打包遮罩图: 1/2/3 = Global Mask Map 1/2/3, 通道由 Hair Highlight Mask Channel 决定. 0 = 全白(等于没有高光带).\r\n只在`Hair Highlight Mask From Global Map`打开时参与; 关着的时候读的是本函数自带的 Hair Highlight Mask 贴图.\r\n\r\n注意一个取舍: 共享的是基础输入那一次采样, 而那次采样用的是 Global Mask Map UV, 不带这里的光照仰角 V 偏移. 也就是说走共享图的时候高光带不再跟着光上下移动, 上面那九个仰角参数对它失效 —— 换来的是不用再为它单独带一张贴图和一次取样.\r\n要保留移动就把开关关掉, 用自带贴图.\r\n\r\n\r\nWhich packed mask map to read: 1/2/3 are Global Mask Map 1/2/3, with the channel picked by Hair Highlight Mask Channel. 0 is white, i.e. no highlight band at all.\r\nOnly used while `Hair Highlight Mask From Global Map` is on; with it off this function samples its own Hair Highlight Mask texture as before.\r\n\r\nMind the trade: what is shared is the base input's single sample, and that sample is taken through Global Mask Map UV, without the light-elevation V offset applied here. On the shared path the highlight band therefore stops travelling with the light and the nine elevation parameters do nothing for it -- in exchange for not carrying a texture and a fetch of its own.\r\nTurn the switch off to keep the travel.";
			SliderMin=0;
			SliderMax=3;
		];
		ScalarParameter AddOffset = 0.0 [Group="35 - Feature: Hair Highlight Mask"; SortPriority=104; SliderMin=-0.1; SliderMax=0.1; Description="高光遮罩 UV 的固定纵向偏移. \r\nFixed vertical offset of the highlight mask UV."];
		ScalarParameter DynMin = -0.01 [Group="35 - Feature: Hair Highlight Mask"; SortPriority=105; SliderMin=-0.1; SliderMax=0.1; Description="主光最低时的动态纵向偏移. \r\nDynamic vertical offset at the lowest light elevation."];
		ScalarParameter DynMax = 0.01 [Group="35 - Feature: Hair Highlight Mask"; SortPriority=106; SliderMin=-0.1; SliderMax=0.1; Description="主光最高时的动态纵向偏移. \r\nDynamic vertical offset at the highest light elevation."];
		ScalarParameter ElevMin = -0.6 [Group="35 - Feature: Hair Highlight Mask"; SortPriority=107; SliderMin=-1; SliderMax=1; Description="映射起点: 主光仰角(与上方向的点积)在这里算 0. \r\nMapping start: the light elevation (dot with up) that maps to 0."];
		ScalarParameter ElevMax = 0.6 [Group="35 - Feature: Hair Highlight Mask"; SortPriority=108; SliderMin=-1; SliderMax=1; Description="映射终点: 主光仰角在这里算 1; 小于 ElevMin 时反向. \r\nMapping end: the light elevation that maps to 1; below ElevMin it inverts."];
		ScalarParameter Curve = 1.2 [Group="35 - Feature: Hair Highlight Mask"; SortPriority=109; SliderMin=0.1; SliderMax=4; Description="仰角映射的曲线幂. \r\nPower curve on the elevation mapping."];
		ScalarParameter ClampMin = -0.03 [Group="35 - Feature: Hair Highlight Mask"; SortPriority=110; SliderMin=-0.2; SliderMax=0.2; Description="总偏移下限. \r\nLower clamp of the total offset."];
		ScalarParameter ClampMax = 0.03 [Group="35 - Feature: Hair Highlight Mask"; SortPriority=111; SliderMin=-0.2; SliderMax=0.2; Description="总偏移上限. \r\nUpper clamp of the total offset."];
		ScalarParameter VSign = 1.0 [Group="35 - Feature: Hair Highlight Mask"; SortPriority=112; SliderMin=-1; SliderMax=1; Description="动态偏移的方向, 1 或 -1(UV 朝上还是朝下). \r\nDirection of the dynamic offset, 1 or -1 (UV up or down)."];
	}

	Graph = {
		float2 MaterialExpressionTextureCoordinate_3 = UE.Expression(Class="TextureCoordinate", OutputType="float2");
		float3 MF_MoonMainLightDirection = MF_MoonMainLightDirection();
		float2 Custom =
			UE.Expression(
				Class="Custom",
				OutputType="float2",
				Code="float3 L = normalize(MainLightDirWS);\r\nfloat3 U = normalize(WorldUpWS);\r\n\r\n// 主光“上下”量（仰角）\r\nfloat elev = dot(L, U); // [-1,1]\r\n\r\n// 映射到自定义区间\r\nfloat a = min(ElevMin, ElevMax);\r\nfloat b = max(ElevMin, ElevMax);\r\nfloat t = saturate((elev - a) / max(1e-4, b - a));\r\nif (ElevMin > ElevMax) t = 1.0 - t;\r\n\r\n// 曲线\r\nt = pow(t, max(1e-3, Curve));\r\n\r\n// 动态偏移 + 手动偏移 + 总区间限制\r\nfloat dyn = lerp(DynMin, DynMax, t) * VSign;\r\nfloat offsetV = clamp(AddOffset + dyn, ClampMin, ClampMax);\r\n\r\nreturn UV + float2(0.0, offsetV);",
				Description="Custom",
				UV=MaterialExpressionTextureCoordinate_3,
				MainLightDirWS=MF_MoonMainLightDirection,
				WorldUpWS=float3(0.0, 0.0, 1.0),
				AddOffset=AddOffset,
				DynMin=DynMin,
				DynMax=DynMax,
				ElevMin=ElevMin,
				ElevMax=ElevMax,
				Curve=Curve,
				ClampMin=ClampMin,
				ClampMax=ClampMax,
				VSign=VSign
			);
		#Region "Texture Sample"
		float4 Hair_Highlight_Mask =
			UE.Expression(
				Class="TextureSampleParameter2D",
				OutputType="float4",
				OutputIndex=5,
				ParameterName="Hair Highlight Mask",
				Group="35 - Feature: Hair Highlight Mask",
				SortPriority=102,
				Coordinates=Custom,
				Texture=Path(Engine, "EngineResources/Black"),
				SamplerType="SAMPLERTYPE_Color",
				Desc="发丝高光(天使环)遮罩贴图, 通道由 Hair Highlight Mask Channel 选. \r\nHair highlight (angel ring) mask map; Hair Highlight Mask Channel picks the channel. 颜色空间: sRGB(颜色贴图). Colour space: sRGB, a colour texture."
			);
		#EndRegion

		#Region "Hair Highlight Mask"
		// Either its own texture, or a channel of a packed map the base input already sampled.
		//
		// The choice is a STATIC switch and not a source scalar like the see-through overlay's,
		// because here the alternative is a texture fetch: a scalar select would leave that fetch in
		// the shader on both paths, and not paying for it is the entire reason to read a shared map.
		// With the switch on, the sample above is culled at translation; with it off, everything
		// below it is.
		//
		// What the shared path gives up is the light-elevation UV: the base input samples the packed
		// maps through Global Mask Map UV, so the band no longer travels with the light. That is
		// documented on Hair Highlight Mask Source, and it is why this is a choice rather than a
		// replacement.
		float4 Global_Mask_Selected = float4(1.0, 1.0, 1.0, 1.0);
		SelectGlobalMaskMap(GlobalMaskA, GlobalMaskB, GlobalMaskC, Hair_Highlight_Mask_Source, Global_Mask_Selected);
		float4 Hair_Highlight_Mask_Packed =
			UE.Expression(
				Class="StaticSwitchParameter",
				OutputType="float4",
				True=Global_Mask_Selected,
				False=Hair_Highlight_Mask,
				Group="35 - Feature: Hair Highlight Mask",
				SortPriority=100,
				ParameterName="Hair Highlight Mask From Global Map",
				DefaultValue=false,
				Desc="开 = 发丝高光遮罩取自打包遮罩图(Global Mask Map, 由对应的 Mask Source 选第几张), 关 = 读它自己的贴图. \r\nOn = the hair highlight mask comes from the packed Global Mask Map (the matching Mask Source picks which); off = its own map."
			);
		#EndRegion

		// Fed the full float4 rather than .rgb, so a mask packed into the alpha channel is reachable
		// on both paths. Identical for the R/G/B selections every existing instance uses.
		HairHighlightMask = Hair_Highlight_Mask_Channel(Input = Hair_Highlight_Mask_Packed);
	}
}
