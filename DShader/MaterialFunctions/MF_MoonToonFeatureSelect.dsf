		StaticSwitchParameter Is_ToonMetal = false [ParameterName="Is ToonMetal"; Group="30 - Shading Feature (pick one)"; SortPriority=9; Description="启用 Metal 着色特征. 只应勾选一个; 若勾了多个, 本文件中靠前的胜出. 一个都不勾 = 普通 toon. 勾选后, 未选中特征的参数会从材质实例面板里消失(静态开关会裁掉未走的分支)."];
