		float4 StaticSwitchParameter_47 =
			UE.Expression(
				Class="StaticSwitchParameter",
				OutputType="float4",
				True=Diffuse_Ramp_Offset_Map.rgba,
				False=Diffuse_Ramp_Offset_Map_1.rgba,
				Group="00 - Global Settings",
				SortPriority=32,
				ParameterName="Enable Per Texture Sampler"
