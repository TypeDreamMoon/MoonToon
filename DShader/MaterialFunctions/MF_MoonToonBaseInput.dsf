// MoonToon base input.
//
// Rebased onto a faithful decompile of /MooaToon/MaterialFunctions/MF_MooaToonBaseInput
// (after the ChannelMaskParameter decompiler fix). Intended deltas from the original:
//   * lives in the MoonToon plugin
//   * calls MF_MoonToonBuffer with ShadingFeatureID actually wired (the original calls
//     MF_MoonToonBufferInput whose internal ShadingFeatureID parameter is stuck at 0)
//   * UVChannelSwitch + default textures point at MoonToon's own copies
// Regenerate the baseline with: dsc.ps1 decompile /MooaToon/MaterialFunctions/MF_MooaToonBaseInput
// Warning: Exported 'MaterialExpressionVertexTangentWS' as UE.Expression; review reflected literal properties if the node has editor-only state.
// Warning: Exported 'MaterialExpressionTransform' as UE.Expression; review reflected literal properties if the node has editor-only state.
// Warning: Exported 'MaterialExpressionMoonEncodeToonAttributes' as UE.Expression; review reflected literal properties if the node has editor-only state.
// Warning: Exported 'MaterialExpressionIf' as UE.Expression; review reflected literal properties if the node has editor-only state.

VirtualFunction(Name="MF_MoonToonFeatureSelect")
{
	Options = {
		Asset = Path(Plugins.MoonToon, "MaterialFunctions/MF_MoonToonFeatureSelect");
		Description = "Static toon feature selection; see Tools/gen_feature_functions.py.";
	}

	Inputs = {
		opt float InToonKajiyaSecondaryStrandShift = 0.0;
		opt float InToonKajiyaPrimaryStrandShift = 0.0;
		opt float InHairHighlightMask = 0.0;
		opt float3 InStockingsBodyColor = float3(0.0, 0.0, 0.0);
	}

	Outputs = {
		float4 ToonBufferA;
		float4 ToonBufferB;
		float4 ToonBufferC;
		float ShadingFeatureID;
		float4 DebugColor;
	}
}
VirtualFunction(Name="AppendMany")
{
	Options = {
		Asset = Path(Engine, "Functions/Engine_MaterialFunctions02/Utility/AppendMany");
		Description = "Generated from /Engine/Functions/Engine_MaterialFunctions02/Utility/AppendMany.AppendMany";
	}

	Inputs = {
		opt float R = 0.0;
		opt float G = 0.0;
		opt float B = 0.0;
		opt float A = 0.0;
	}

	Outputs = {
		float2 RG;
		float3 RGB;
		float4 RGBA;
	}
}
VirtualFunction(Name="MF_UVChannelSwitch")
{
	Options = {
		Asset = Path(Plugins.MoonToon, "MaterialFunctions/Utils/MF_UVChannelSwitch");
		Description = "Generated from /MoonToon/MaterialFunctions/Utils/MF_UVChannelSwitch.MF_UVChannelSwitch";
	}

	Inputs = {
		float UVChannelIndex [
			Description="The UV channel index to output.";
			SortPriority=100;
		];
	}

	Outputs = {
		float2 Result;
	}
}
VirtualFunction(Name="MF_MoonMainLightDirection")
{
	Options = {
		Asset = Path(Plugins.MoonToon, "MaterialFunctions/MF_MoonMainLightDirection");
		Description = "Generated from /MooaToon/MaterialFunctions/MF_MoonMainLightDirection.MF_MoonMainLightDirection";
	}

	Inputs = {
	}

	Outputs = {
		float3 Result;
	}
}
VirtualFunction(Name="FlattenNormal")
{
	Options = {
		Asset = Path(Engine, "Functions/Engine_MaterialFunctions01/Texturing/FlattenNormal");
		Description = "Generated from /Engine/Functions/Engine_MaterialFunctions01/Texturing/FlattenNormal.FlattenNormal";
	}

	Inputs = {
		opt float3 Normal = float3(0, 0, 1);
		opt float Flatness = 0.0;
	}

	Outputs = {
		float3 Result;
	}
}
VirtualFunction(Name="MF_ToonUV")
{
	Options = {
		Asset = Path(Plugins.MoonToon, "MaterialFunctions/Shared/MF_ToonUV");
	}

	Inputs = {
		opt float UVChannel = 0.0;
		opt float4 ScaleOffset = float4(1.0, 1.0, 0.0, 0.0);
	}

	Outputs = {
		float2 UV;
	}
}
ShaderFunction(Name="MaterialFunctions/MF_MoonToonBaseInput", Root="Plugin.MoonToon")
{
	Settings = {
		Description       = "MoonToon base input. Packs the toon shading inputs into MaterialAttributes plus the three toon buffers.";
		ExposeToLibrary   = true;
		LibraryCategories = "MoonToon";
	}

	Properties = {
		// Feature selection used to be a runtime ScalarParameter with an enum dropdown, plus a
		// second one for a dual-feature mask that was wired to the constant 1.0 and so could never
		// fire. Both are gone: the choice is now the static switches in MF_MoonToonFeatureSelect,
		// which is what lets a material instance hide the ~69 parameters belonging to features it
		// did not pick. A runtime scalar cannot drive a shader permutation, so it could not.
		// Per-material multiplier on the screen-space depth-test hair shadow (receiver side, on top
		// of the global post-process intensity). 3-bit in the GBuffer -> 8 usable steps.
		ScalarParameter Screen_Space_Hair_Shadow_Intensity = 1.0 [
			ParameterName="Screen Space Hair Shadow Intensity";
			Group="13 - Ray Tracing Shadow";
			SortPriority=62;
			Description="屏幕空间发影强度的每实例乘数(叠加在后处理体积的全局强度上). 0=关闭, 1=全强度. GBuffer中以3bit存储(8档).\r\n\r\nPer-instance multiplier on the screen-space depth-test hair shadow, applied on top of the post-process volume's global intensity. 0 = off, 1 = full strength. Stored as 3 bits (8 steps) in the GBuffer.";
		];
		ChannelMaskParameter KajiyaSecondaryMaskChannel = float4(1.0, 0.0, 0.0, 0.0) [
			Group="04 - Kajiya Kay";
			MaskChannel=Red
		];
		VectorParameter Global_Mask_Map_UV_Scale_Offset = float4(1.0, 1.0, 0.0, 0.0) [
			ParameterName="Global Mask Map UV Scale/Offset";
			Group="01 - Global Mask Map";
			SortPriority=33;
			Description="xy scales the UV, zw is added afterwards. Replaces the four separate Scale X/Y and Offset X/Y scalars.";
		];
		ScalarParameter Global_Mask_Map_UV_Channel = 0.0 [
			ParameterName="Global Mask Map UV Channel";
			Group="01 - Global Mask Map";
		];
		TextureSampleParameter2D BodyBaseColor = Path(Engine, "EngineResources/DefaultTexture") [
			SamplerType="SAMPLERTYPE_Color";
			Group="05 - Stockings";
		];
		ChannelMaskParameter Hair_Highlight_Mask_Channel = float4(1.0, 0.0, 0.0, 0.0) [
			ParameterName="Hair Highlight Mask Channel";
			Group="03 - Hair Highlight Mask";
			MaskChannel=Red
		];
		ScalarParameter AddOffset = 0.0 [Group="02 - Distance Field Facial Shadow"; SortPriority=60];
		ScalarParameter DynMin = -0.01 [Group="02 - Distance Field Facial Shadow"; SortPriority=61];
		ScalarParameter DynMax = 0.01 [Group="02 - Distance Field Facial Shadow"; SortPriority=62];
		ScalarParameter ElevMin = -0.6 [Group="02 - Distance Field Facial Shadow"; SortPriority=63];
		ScalarParameter ElevMax = 0.6 [Group="02 - Distance Field Facial Shadow"; SortPriority=64];
		ScalarParameter Curve = 1.2 [Group="02 - Distance Field Facial Shadow"; SortPriority=65];
		ScalarParameter ClampMin = -0.03 [Group="02 - Distance Field Facial Shadow"; SortPriority=66];
		ScalarParameter ClampMax = 0.03 [Group="02 - Distance Field Facial Shadow"; SortPriority=67];
		ScalarParameter VSign = 1.0 [Group="02 - Distance Field Facial Shadow"; SortPriority=68];
		// See Through Overlay (眉透/瞳透): when enabled, the renderer re-draws this material after
		// lighting wherever it is occluded by same-actor toon hair, blending
		// BaseColor * Tint at Through Hair Opacity over the lit hair (Moon_MeshPass_FaceOverlay).
		ScalarParameter Through_Hair_Opacity = 0.5 [
			ParameterName="Through Hair Opacity";
			Group="24 - See Through Overlay";
			SortPriority=10;
			Description="Opacity of the re-blend where hair covers this material. 眉毛/睫毛建议 0.5~0.7, 瞳孔建议 0.35~0.55.";
		];
		VectorParameter Through_Hair_Tint = float4(1.0, 1.0, 1.0, 1.0) [
			ParameterName="Through Hair Tint";
			Group="24 - See Through Overlay";
			SortPriority=20;
			Description="Multiplied with the material BaseColor for the through-hair re-blend only.";
		];
		ScalarParameter Through_Hair_Depth_Threshold = 0.0 [
			ParameterName="Through Hair Depth Threshold";
			Group="24 - See Through Overlay";
			SortPriority=30;
			Description="Max occluder distance in cm for the re-blend. 0 = use the global r.MoonToon.FaceOverlay.DepthThreshold.";
		];
		ScalarParameter Through_Hair_Depth_Fade = 0.0 [
			ParameterName="Through Hair Depth Fade";
			Group="24 - See Through Overlay";
			SortPriority=31;
			Description="Opacity feathers to zero over the last N cm before the threshold. Only used when Depth Threshold > 0; 0 with an overridden threshold = hard cutoff.";
		];
		ScalarParameter Through_Hair_View_Fade_Start = 0.12 [
			ParameterName="Through Hair View Fade Start";
			Group="24 - See Through Overlay";
			SortPriority=32;
			Description="N dot V below which the re-blend is fully gone (profile views). Start < End required; equal values fall back to the engine curve 0.12-0.40.";
		];
		ScalarParameter Through_Hair_View_Fade_End = 0.40 [
			ParameterName="Through Hair View Fade End";
			Group="24 - See Through Overlay";
			SortPriority=33;
			Description="N dot V above which the re-blend is at full strength (frontal views).";
		];
		ScalarParameter Through_Hair_Occluder_ID_A = -1.0 [
			ParameterName="Through Hair Occluder ID A";
			Group="24 - See Through Overlay";
			SortPriority=40;
			Description="Extra occluder to show through, named by its CustomDepth stencil value (0-255) -- i.e. the occluder material's 'Material Stencil Value' override. The occluder's mesh also needs 'Render CustomDepth Pass' enabled. Use for occluders that are NOT hair-shaded: hat brims, hair accessories, glasses frames. -1 = unused. Hair shading features (2/4/5) always pass regardless of this.";
		];
		ScalarParameter Through_Hair_Occluder_ID_B = -1.0 [
			ParameterName="Through Hair Occluder ID B";
			Group="24 - See Through Overlay";
			SortPriority=41;
			Description="Second accepted occluder CustomDepth stencil value. -1 = unused.";
		];
		VectorParameter Inner_Outline_Color = float4(0.0, 0.0, 0.0, 1.0) [
			ParameterName="Inner Outline Color";
			Group="22 - Inner Outline";
			SortPriority=40;
		];
		ChannelMaskParameter Inner_Outline_Channel = float4(0.0, 1.0, 0.0, 0.0) [
			ParameterName="Inner Outline Channel";
			Group="22 - Inner Outline";
			SortPriority=34;
			MaskChannel=Green
		];
		ScalarParameter Inner_Outline_Map_UV_Channel = 0.0 [
			ParameterName="Inner Outline Map UV Channel";
			Group="22 - Inner Outline";
			SortPriority=33;
		];
		VectorParameter Global_UV_Scale_Offset = float4(1.0, 1.0, 0.0, 0.0) [
			ParameterName="Global UV Scale/Offset";
			Group="00 - Global Settings";
			SortPriority=101;
			Description="xy scales the UV, zw is added afterwards. Replaces the four separate Scale X/Y and Offset X/Y scalars.";
		];
		ScalarParameter Global_UV_Channel = 0.0 [
			ParameterName="Global UV Channel";
			Group="00 - Global Settings";
			SortPriority=100;
		];
		VectorParameter Base_Color = float4(1.0, 1.0, 1.0, 1.0) [
			ParameterName="Base Color";
			Group="10 - Diffuse";
			SortPriority=4;
		];
		ScalarParameter Metallic = 0.0 [
			Group="11 - Specular";
			SortPriority=53;
		];
		ChannelMaskParameter Metallic_Channel = float4(0.0, 1.0, 0.0, 0.0) [
			ParameterName="Metallic Channel";
			Group="11 - Specular";
			SortPriority=52;
			MaskChannel=Green
		];
		ScalarParameter Specular = 0.0 [
			Group="11 - Specular";
			SortPriority=1;
		];
		ScalarParameter Roughness = 1.0 [
			Group="11 - Specular";
			SortPriority=44;
		];
		ChannelMaskParameter Roughness_Channel = float4(1.0, 0.0, 0.0, 0.0) [
			ParameterName="Roughness Channel";
			Group="11 - Specular";
			SortPriority=42;
			MaskChannel=Red
		];
		ScalarParameter Anisotropy = 0.0 [
			Group="11 - Specular";
			SortPriority=3;
		];
		ScalarParameter Emissive_Intensity = 1.0 [
			ParameterName="Emissive Intensity";
			Group="23 - Emissive";
			SortPriority=40;
		];
		ChannelMaskParameter Opacity_Channel = float4(0.0, 0.0, 0.0, 1.0) [
			ParameterName="Opacity Channel";
			Group="21 - Translucency";
			SortPriority=33;
			MaskChannel=Alpha
		];
		ScalarParameter Opacity = 1.0 [
			Group="21 - Translucency";
			SortPriority=40;
			Description="不透明度\r\n当材质混合模式为已遮罩时, 使用Dither模拟半透明, 不会有排序问题.\r\n当材质混合模式为半透明时, 使用透明度混合半透明, 可能出现排序问题.\r\n\r\nOpacity\r\nWhen the material Blend Mode is Masked, Dither is used to simulate translucency, and there will be no ordering problems.\r\nWhen the material Blend Mode is Translucent, use Alpha Blend transparency, and there may be ordering problems.";
		];
		ScalarParameter Shadow_Opacity = 1.0 [
			ParameterName="Shadow Opacity";
			Group="21 - Translucency";
			SortPriority=41;
		];
		ScalarParameter Apply_Opacity_to_Shadow = 1.0 [
			ParameterName="Apply Opacity to Shadow";
			Group="21 - Translucency";
			SortPriority=42;
		];
		ChannelMaskParameter AO_Channel = float4(0.0, 0.0, 0.0, 1.0) [
			ParameterName="AO Channel";
			Group="10 - Diffuse";
			SortPriority=34;
			MaskChannel=Alpha
		];
		ScalarParameter AO_Intensity = 1.0 [
			ParameterName="AO Intensity";
			Group="10 - Diffuse";
			SortPriority=35;
			Description="通过AO可以使某些区域始终处于阴影中.\r\n\r\nAO Map: 0为被遮挡, 1为被照亮. 默认为1.\r\n颜色空间: 线性.\r\n\r\n\r\nAO allows certain areas to be always in shadow.\r\n\r\nAO Map: 0 means occluded, 1 means illuminated. Default is 1.\r\nColor space: linear.";
		];
		VectorParameter Normal_Map_UV_Scale_Offset = float4(1.0, 1.0, 0.0, 0.0) [
			ParameterName="Normal Map UV Scale/Offset";
			Group="20 - Normal";
			SortPriority=101;
			Description="xy scales the UV, zw is added afterwards. Replaces the four separate Scale X/Y and Offset X/Y scalars.";
		];
		ScalarParameter Normal_Map_UV_Channel = 0.0 [
			ParameterName="Normal Map UV Channel";
			Group="20 - Normal";
			SortPriority=100;
		];
		ScalarParameter Normal_Scale = 1.0 [
			ParameterName="Normal Scale";
			Group="20 - Normal";
		];
		ScalarParameter ID_Offset = 0.0 [
			ParameterName="ID Offset";
			Group="13 - Ray Tracing Shadow";
			SortPriority=50;
			Description="可以在没有ID Map或顶点色输入的情况下使用ID偏移来指定整个材质的ID.\r\n\r\nMooaToon使用ID来区分同角色的不同部位, 以精确控制每个部位是否投射阴影.\r\n或者用不同ID区分不同角色, 以实现同角色的模型之间没有自阴影, 但不同角色之间可以相互投影.\r\n\r\n\r\nID offsets can be used to specify IDs for the entire material without ID Map or vertex color input.\r\n\r\nMooaToon uses ID to distinguish different parts of the same character to precisely control whether each part casts a shadow.\r\nOr use different IDs to distinguish different characters, so that there is no self-shadowing between models of the same character, but different characters can cast shadows each other.";
		];
		ChannelMaskParameter ID_Channel = float4(1.0, 0.0, 0.0, 0.0) [
			ParameterName="ID Channel";
			Group="13 - Ray Tracing Shadow";
			SortPriority=34;
			MaskChannel=Red
		];
		ScalarParameter ID_Map_UV_Channel = 0.0 [
			ParameterName="ID Map UV Channel";
			Group="13 - Ray Tracing Shadow";
			SortPriority=33;
		];
		VectorParameter Shadow_Color = float4(0.5, 0.5, 0.5, 1.0) [
			ParameterName="Shadow Color";
			Group="10 - Diffuse";
			SortPriority=10;
		];
		ScalarParameter Diffuse_Color_Ramp_Index = 1.0 [
			ParameterName="Diffuse Color Ramp Index";
			Group="10 - Diffuse";
			SortPriority=0;
			Description="选择使用那个Diffuse Color Ramp.\r\nRamp的横轴是光照方向和表面法线的角度(N dot L), 0为背光面, 0.5为明暗交界线, 1为正光面.\r\nRGB通道为漫反射颜色.\r\nA通道为阴影衰减, 1为被照亮, 0为被遮挡. 用于区分Base Color和Shadow Color.\r\n\r\n现在MooaToon使用Global Diffuse/Specular Color Ramps来描述表面的多光源着色结果, 这意味着使用同一套输入你既可以实现基于物理的着色, 也可以实现完全自定义的风格化着色.\r\n你可以在Project Settings > Engine > MooaToon中找到默认的Ramp Atlas, 其中存放了所有可供选择的Ramp, 要使用某个Ramp你需要在这里输入其Index.\r\n如果要添加新的Ramp, 请先将默认的Ramp Atlas复制一份, 然后在Project Settings中修改Ramp Atlas为复制的, 以避免在更新MooaToon的时候产生冲突.\r\n\r\n\r\nChoose which Diffuse Color Ramp to use.\r\nThe horizontal axis of Ramp is the angle between light direction and surface normal (N dot L), 0 is the backlight surface, 0.5 is the boundary between light and dark, and 1 is the front light surface.\r\nThe RGB channel is the diffuse color.\r\nThe A channel is shadow attenuation, 1 means illuminated, 0 means occluded. Used to distinguish Base Color and Shadow Color.\r\n\r\nMooaToon now uses Global Diffuse/Specular Color Ramps to describe the multi-light shading results of the surface, which means that using the same set of inputs you can achieve both physically based shading and completely customized stylized shading.\r\nYou can find the default Ramp Atlas in Project Settings > Engine > MooaToon, which stores all available Ramps. To use a Ramp, you need to enter its Index here.\r\nIf you want to add a new Ramp, please first copy the default Ramp Atlas, and then modify the Ramp Atlas to be copied in Project Settings to avoid conflicts when updating MooaToon.";
		];
		ChannelMaskParameter Diffuse_Ramp_Offset_Channel = float4(0.0, 0.0, 1.0, 0.0) [
			ParameterName="Diffuse Ramp Offset Channel";
			Group="10 - Diffuse";
			SortPriority=37;
			MaskChannel=Blue
		];
		ScalarParameter Diffuse_Ramp_Offset_Intensity = 0.0 [
			ParameterName="Diffuse Ramp Offset Intensity";
			Group="10 - Diffuse";
			SortPriority=38;
			Description="Diffuse Ramp Offset Map通过偏移Diffuse Ramp A通道的横轴来精细控制法线阴影的形状.\r\n贴图的值:\r\n  - 越接近0越容易进入暗面范围\r\n  - 为0.5时没有影响\r\n  - 越接近1越容易进入亮面范围\r\n颜色空间: 线性.\r\n\r\n受限于GBuffer位深, 在`Diffuse Ramp Offset Intensity`较小时阴影边缘可能出现锯齿.\r\n建议将`Diffuse Ramp Offset Intensity`设为1, 然后以下方式之一:\r\n  - 控制台变量`r.Mooa.DiffuseColorRamp.UVOffsetMaxRange`\r\n  - `BP_MooaLookDevTool > Shading Settings > Diffuse Ramp UV Offset Max Range`\r\n调整最大偏移范围.\r\n\r\n\r\nThe Diffuse Ramp Offset Map provides fine control over the shape of the normal shadow by offsetting the horizontal axis of the Diffuse Ramp A channel.\r\nThe value of the map:\r\n  - The closer it is to 0, the easier it is to enter the dark side range\r\n  - It has no effect when it is 0.5\r\n  - The closer it is to 1, the easier it is to enter the light side range\r\nColor space: linear.\r\n\r\nLimited by the GBuffer bit depth, the shadow edges may appear jagged when `Diffuse Ramp Offset Intensity` is small.\r\nIt is recommended to set `Diffuse Ramp Offset Intensity` to 1, and then use one of the following methods:\r\n  - Console variable `r.Mooa.DiffuseColorRamp.UVOffsetMaxRange`\r\n  - `BP_MooaLookDevTool > Shading Settings > Diffuse Ramp UV Offset Max Range`\r\nto adjust the maximum offset range.";
		];
		VectorParameter Specular_Color = float4(1.0, 1.0, 1.0, 1.0) [
			ParameterName="Specular Color";
			Group="11 - Specular";
			SortPriority=4;
		];
		ScalarParameter Specular_Color_Ramp_Index = 0.0 [
			ParameterName="Specular Color Ramp Index";
			Group="11 - Specular";
			SortPriority=0;
			Description="选择使用哪个Specular Color Ramp.\r\n横坐标是根据经验归一化后的高光强度:\r\n\t- 0对应高光点边缘\r\n\t- 1对应高光点中心\r\nRGB通道的值为Specular Color.\r\n\r\n现在MooaToon使用Global Diffuse/Specular Color Ramps来描述表面的多光源着色结果, 这意味着使用同一套输入你既可以实现基于物理的着色, 也可以实现完全自定义的风格化着色.\r\n你可以在Project Settings > Engine > MooaToon中找到默认的Ramp Atlas, 其中存放了所有可供选择的Ramp, 要使用某个Ramp你需要在这里输入其Index.\r\n如果要添加新的Ramp, 请先将默认的Ramp Atlas复制一份, 然后在Project Settings中修改Ramp Atlas为复制的, 以避免在更新MooaToon的时候产生冲突.\r\n\r\n\r\nChoose which Specular Color Ramp to use.\r\nThe horizontal coordinate is the empirically normalized highlight intensity.\r\n\t- 0 is the edge of the highlight point.\r\n\t- 1 is the center of the highlight.\r\nThe value of the RGB channel is Specular Color.\r\n\r\nMooaToon now uses Global Diffuse/Specular Color Ramps to describe the multi-light shading results of the surface, which means that using the same set of inputs you can achieve both physically based shading and completely customized stylized shading.\r\nYou can find the default Ramp Atlas in Project Settings > Engine > MooaToon, which stores all available Ramps. To use a Ramp, you need to enter its Index here.\r\nIf you want to add a new Ramp, please first copy the default Ramp Atlas, and then modify the Ramp Atlas to be copied in Project Settings to avoid conflicts when updating MooaToon.";
		];
		ChannelMaskParameter Specular_Ramp_Offset_Channel = float4(0.0, 0.0, 1.0, 0.0) [
			ParameterName="Specular Ramp Offset Channel";
			Group="11 - Specular";
			SortPriority=62;
			MaskChannel=Blue
		];
		ScalarParameter Specular_Ramp_Offset_Intensity = 0.0 [
			ParameterName="Specular Ramp Offset Intensity";
			Group="11 - Specular";
			SortPriority=63;
			Description="Specular Ramp Offset Map通过偏移Specular Ramp RGB通道的横轴来精细控制Specular的形状.\r\n贴图的值:\r\n\t- 越接近0越难以进入Specular范围\r\n\t- 为0.5时没有影响\r\n\t- 越接近1越容易进入Specular范围\r\n颜色空间: 线性.\r\n\r\n受限于GBuffer位深, 在`Specular Ramp Offset Intensity`较小时Specular边缘可能出现锯齿.\r\n建议将`Specular Ramp Offset Intensity`设为1, 然后以下方式之一:\r\n  - 控制台变量`r.Mooa.SpecularColorRamp.UVOffsetMaxRange`\r\n  - `BP_MooaLookDevTool > Shading Settings > Specular Ramp UV Offset Max Range`\r\n调整最大偏移范围.\r\n\r\n\r\nThe Specular Ramp Offset Map provides fine control over the shape of the Specular by offsetting the horizontal axis of the Specular Ramp RGB channel.\r\nTexture value:\r\n\t- The closer it is to 0, the harder it is to enter the Specular range\r\n\t- has no effect at 0.5\r\n\t- the closer to 1, the easier it is to enter the Specular range\r\nColor space: linear.\r\n\r\nLimited by the GBuffer bit depth, Specular edges may appear jagged when `Specular Ramp Offset Intensity` is small.\r\nIt is recommended to set `Specular Ramp Offset Intensity` to 1, and then use one of the following methods:\r\n  - console variable `r.Mooa.SpecularColorRamp.UVOffsetMaxRange`\r\n  - `BP_MooaLookDevTool > Shading Settings > Specular Ramp UV Offset Max Range`\r\nto adjust the maximum offset range.";
		];
		ScalarParameter Reflection = 0.0 [
			Group="11 - Specular";
			SortPriority=2;
		];
		ScalarParameter Rim_Light_Intensity = 0.5 [
			ParameterName="Rim Light Intensity";
			Group="12 - Rim Light";
			SortPriority=40;
			Description="屏幕空间深度测试边缘光强度.\r\n与传统的基于法线方向与视线方向的角度(N dot V)的边缘光不同, 屏幕空间边缘光的宽度与表面曲率无关, 看起来更加扁平化.\r\n可以用控制台命令调整更多全局参数.\r\n\r\n\r\nScreen Space Depth Test Rim Light Intensity.\r\nDifferent from the traditional rim light based on the angle between the normal direction and the view direction (N dot V), the width of the screen space rim light has nothing to do with the surface curvature and looks flatter.\r\nMore global parameters can be adjusted using console variables.";
		];
		ChannelMaskParameter Rim_Light_Width_Channel = float4(0.0, 0.0, 1.0, 0.0) [
			ParameterName="Rim Light Width Channel";
			Group="12 - Rim Light";
			SortPriority=34;
			MaskChannel=Blue
		];
		ChannelMaskParameter Rim_Light_Width_Channel_1 = float4(0.0, 0.0, 1.0, 0.0) [
			ParameterName="Rim Light Width Channel";
			Group="12 - Rim Light";
			SortPriority=34;
			MaskChannel=Blue
		];
		ScalarParameter Rim_Light_Width = 0.5 [
			ParameterName="Rim Light Width";
			Group="12 - Rim Light";
			SortPriority=35;
			Description="屏幕空间深度测试边缘光宽度.\r\n与传统的基于法线方向与视线方向的角度(N dot V)的边缘光不同, 屏幕空间边缘光的宽度与表面曲率无关, 看起来更加扁平化.\r\n可以用控制台命令调整更多全局参数.\r\n\r\n\r\nScreen Space Depth Test Rim Light Width.\r\nDifferent from the traditional rim light based on the angle between the normal direction and the view direction (N dot V), the width of the screen space rim light has nothing to do with the surface curvature and looks flatter.\r\nMore global parameters can be adjusted using console variables.";
		];
		ChannelMaskParameter Distance_Field_Facial_Shadow_Map_Channel = float4(1.0, 0.0, 0.0, 0.0) [
			ParameterName="Distance Field Facial Shadow Map Channel";
			Group="02 - Distance Field Facial Shadow";
			MaskChannel=Red
		];
		ChannelMaskParameter Distance_Field_Facial_Shadow_Map_Channel_1 = float4(1.0, 0.0, 0.0, 0.0) [
			ParameterName="Distance Field Facial Shadow Map Channel";
			Group="02 - Distance Field Facial Shadow";
			MaskChannel=Red
		];
		ScalarParameter Face_ID = 250.0 [
			ParameterName="Face ID";
			Group="13 - Ray Tracing Shadow";
			SortPriority=82;
			Description="在有ID Map或顶点色输入的情况下指定脸或头发的ID, 适用于脸和头发使用同一个材质的情况.\r\n\r\n如果要使用发影(头发在脸上的投影)功能, 则必须正确设置脸和头发的ID.\r\n\r\n\r\nSpecifying the ID of the face or hair with ID Map or vertex color input, suitable for face and hair using the same material.\r\n\r\nIf you want to use the hair shadow (shadows of hair on the face) feature, the face and hair IDs must be set correctly.";
		];
		ScalarParameter Hair_ID = 240.0 [
			ParameterName="Hair ID";
			Group="13 - Ray Tracing Shadow";
			SortPriority=82;
			Description="在有ID Map或顶点色输入的情况下指定脸或头发的ID, 适用于脸和头发使用同一个材质的情况.\r\n\r\n如果要使用发影(头发在脸上的投影)功能, 则必须正确设置脸和头发的ID.\r\n\r\n\r\nSpecifying the ID of the face or hair with ID Map or vertex color input, suitable for face and hair using the same material.\r\n\r\nIf you want to use the hair shadow (shadows of hair on the face) feature, the face and hair IDs must be set correctly.";
		];
	}

	Inputs = {
	}

	Outputs = {
		MaterialAttributes Output;
		float4 ToonBufferA;
		float4 ToonBufferB;
		float4 ToonBufferC;
		// rgb = through-hair overlay colour, a = opacity. Constant zero while the enable switch is
		// off, which keeps the material out of Moon_MeshPass_FaceOverlay entirely (the engine's
		// enrollment check is value-based).
		float4 FaceOverlayData;
		// x = depth threshold cm (0 = global CVar), y = depth fade cm, z/w = view fade start/end.
		// Never affects pass enrollment; only read where FaceOverlayData survives.
		float4 FaceOverlayParams;
		// Extra occluder toon-stencil IDs (0-255 authoring space, -1 = unused). z/w reserved so
		// two more slots can be added without touching the engine node.
		float4 FaceOverlayStencilIDs;
	}

	Graph = {
		MaterialAttributes Attributes;
		float3 VertexTangentWS = UE.Expression(Class="VertexTangentWS", OutputType="float3");
		float3 Multiply = (VertexTangentWS * 0.5);
		float3 Add = (Multiply + 0.5);
		float4 AppendMany = AppendMany((UE.Expression(Class="VertexColor", OutputType="float4")).r, (UE.Expression(Class="VertexColor", OutputType="float4")).g, (UE.Expression(Class="VertexColor", OutputType="float4")).b, (UE.Expression(Class="VertexColor", OutputType="float4")).a, OutputIndex=2);
		#Region "Texture Sample"
		float3 AppendMany_1 = AppendMany((UE.Expression(Class="VertexColor", OutputType="float4")).r, (UE.Expression(Class="VertexColor", OutputType="float4")).g, (UE.Expression(Class="VertexColor", OutputType="float4")).b, (UE.Expression(Class="VertexColor", OutputType="float4")).a, OutputIndex=1);
		float4 StaticSwitchParameter =
			UE.Expression(
				Class="StaticSwitchParameter",
				OutputType="float4",
				True=AppendMany,
				False=float4(pow(AppendMany_1, 2.2), (UE.Expression(Class="VertexColor", OutputType="float4")).a),
				Group="01 - Global Mask Map",
				SortPriority=41,
				ParameterName="Use Vertex Color In sRGB Space"
			);
		#EndRegion

		float4 Sampled_Vertex_Color = StaticSwitchParameter;
		#Region "UVs"
		float2 Add_1 = MF_ToonUV(Global_Mask_Map_UV_Channel, Global_Mask_Map_UV_Scale_Offset);
		#EndRegion

		float2 Global_Mask_Map_UV = Add_1;
		#Region "Texture Sample"
		float4 Global_Mask_Map =
			UE.Expression(
				Class="TextureSampleParameter2D",
				OutputType="float4",
				OutputIndex=5,
				ParameterName="Global Mask Map",
				Group="01 - Global Mask Map",
				Desc="用于存放各种线性数据的贴图, 每个通道存放什么数据可以根据你的项目需求定制.\r\n颜色空间: 线性.\r\n\r\n\r\nTexture used to store various linear data. What data is stored in each channel can be customized according to your project needs.\r\nColor space: linear.",
				Coordinates=Global_Mask_Map_UV,
				Texture=Path(Plugins.MoonToon, "Textures/T_White_Linear"),
				SamplerType="SAMPLERTYPE_LinearColor"
			);
		float4 Global_Mask_Map_1 =
			UE.Expression(
				Class="TextureSampleParameter2D",
				OutputType="float4",
				OutputIndex=5,
				ParameterName="Global Mask Map",
				Group="01 - Global Mask Map",
				Desc="用于存放各种线性数据的贴图, 每个通道存放什么数据可以根据你的项目需求定制.\r\n颜色空间: 线性.\r\n\r\n\r\nTexture used to store various linear data. What data is stored in each channel can be customized according to your project needs.\r\nColor space: linear.",
				Coordinates=Global_Mask_Map_UV,
				Texture=Path(Plugins.MoonToon, "Textures/T_White_Linear"),
				SamplerType="SAMPLERTYPE_LinearColor",
				SamplerSource="SSM_Wrap_WorldGroupSettings"
			);
		float4 StaticSwitchParameter_1 =
			UE.Expression(
				Class="StaticSwitchParameter",
				OutputType="float4",
				True=Global_Mask_Map.rgba,
				False=Global_Mask_Map_1.rgba,
				Group="00 - Global Settings",
				SortPriority=32,
				ParameterName="Enable Per Texture Sampler"
			);
		float4 StaticSwitchParameter_2 =
			UE.Expression(
				Class="StaticSwitchParameter",
				OutputType="float4",
				True=Sampled_Vertex_Color,
				False=StaticSwitchParameter_1,
				Group="01 - Global Mask Map",
				SortPriority=40,
				ParameterName="Use Vertex Color Instead Mask Map"
			);
		#EndRegion

		float4 Sampled_Global_Mask_Map = StaticSwitchParameter_2;
		float KajiyaSecondaryMaskChannel_Masked = KajiyaSecondaryMaskChannel(Input = Sampled_Global_Mask_Map);
		float2 MaterialExpressionTextureCoordinate_3 = UE.Expression(Class="TextureCoordinate", OutputType="float2");
		float3 MF_MoonMainLightDirection = MF_MoonMainLightDirection();
		float2 Custom =
			UE.Expression(
				Class="Custom",
				OutputType="float2",
				Code="float3 L = normalize(MainLightDirWS);\r\nfloat3 U = normalize(WorldUpWS);\r\n\r\n// 主光“上下”量（仰角）\r\nfloat elev = dot(L, U); // [-1,1]\r\n\r\n// 映射到自定义区间\r\nfloat a = min(ElevMin, ElevMax);\r\nfloat b = max(ElevMin, ElevMax);\r\nfloat t = saturate((elev - a) / max(1e-4, b - a));\r\nif (ElevMin > ElevMax) t = 1.0 - t;\r\n\r\n// 曲线\r\nt = pow(t, max(1e-3, Curve));\r\n\r\n// 动态偏移 + 手动偏移 + 总区间限制\r\nfloat dyn = lerp(DynMin, DynMax, t) * VSign;\r\nfloat offsetV = clamp(AddOffset + dyn, ClampMin, ClampMax);\r\n\r\nreturn UV + float2(0.0, offsetV);",
				Description="Custom",
				UV=MaterialExpressionTextureCoordinate_3,
				MainLightDirWS=MF_MoonMainLightDirection,
				WorldUpWS=float3(0.0, 0.0, 1.0),
				AddOffset=AddOffset,
				DynMin=DynMin,
				DynMax=DynMax,
				ElevMin=ElevMin,
				ElevMax=ElevMax,
				Curve=Curve,
				ClampMin=ClampMin,
				ClampMax=ClampMax,
				VSign=VSign
			);
		#Region "Texture Sample"
		float4 Hair_Highlight_Mask =
			UE.Expression(
				Class="TextureSampleParameter2D",
				OutputType="float4",
				OutputIndex=5,
				ParameterName="Hair Highlight Mask",
				Group="03 - Hair Highlight Mask",
				SortPriority=5,
				Coordinates=Custom,
				Texture=Path(Engine, "EngineResources/Black"),
				SamplerType="SAMPLERTYPE_Color"
			);
		#EndRegion

		float Hair_Highlight_Mask_Channel_Masked = Hair_Highlight_Mask_Channel(Input = Hair_Highlight_Mask.rgb);
		float Hair_Highlight_Mask_Texture = Hair_Highlight_Mask_Channel_Masked;
		float ShadingFeatureID = MF_MoonToonFeatureSelect(KajiyaSecondaryMaskChannel_Masked, KajiyaSecondaryMaskChannel_Masked, Hair_Highlight_Mask_Texture, BodyBaseColor.rgb, OutputIndex=3);
		float4 ShadingFeatureColor = MF_MoonToonFeatureSelect(KajiyaSecondaryMaskChannel_Masked, KajiyaSecondaryMaskChannel_Masked, Hair_Highlight_Mask_Texture, BodyBaseColor.rgb, OutputIndex=4);
		#Region "Texture Sample"
		float2 MF_UVChannelSwitch_1 = MF_UVChannelSwitch(Inner_Outline_Map_UV_Channel);
		float4 Inner_Outline_Map =
			UE.Expression(
				Class="TextureSampleParameter2D",
				OutputType="float4",
				OutputIndex=5,
				ParameterName="Inner Outline Map",
				Group="22 - Inner Outline",
				Desc="0: 无影响 1: 内描边\r\n\r\n0: No effect 1: Inner Outline",
				Coordinates=MF_UVChannelSwitch_1,
				Texture=Path(Plugins.MoonToon, "Textures/T_Black_Linear"),
				SamplerType="SAMPLERTYPE_LinearColor",
				MipValueMode="TMVM_MipLevel",
				AutomaticViewMipBias=false,
				ConstMipValue=0
			);
		float4 StaticSwitchParameter_3 =
			UE.Expression(
				Class="StaticSwitchParameter",
				OutputType="float4",
				True=Sampled_Global_Mask_Map,
				False=Inner_Outline_Map.rgba,
				Group="22 - Inner Outline",
				SortPriority=32,
				ParameterName="Inner Outline From Global Mask Map"
			);
		#EndRegion

		float Inner_Outline_Channel_Masked = Inner_Outline_Channel(Input = StaticSwitchParameter_3);
		float Sampled_Inner_Outline = Inner_Outline_Channel_Masked;
		#Region "Inner Outline"
		float3 LinearInterpolate = lerp(1.0, Inner_Outline_Color.rgb, Sampled_Inner_Outline);
		float3 StaticSwitchParameter_4 =
			UE.Expression(
				Class="StaticSwitchParameter",
				OutputType="float3",
				True=LinearInterpolate,
				False=1.0,
				Group="22 - Inner Outline",
				SortPriority=0,
				ParameterName="Enable Inner Outline"
			);
		#EndRegion

		float3 InnerOutlineColor = StaticSwitchParameter_4;
		#Region "UVs"
		float2 Add_2 = MF_ToonUV(Global_UV_Channel, Global_UV_Scale_Offset);
		#EndRegion

		float2 Global_UV = Add_2;
		#Region "Texture Sample"
		float4 Base_Color_Map =
			UE.Expression(
				Class="TextureSampleParameter2D",
				OutputType="float4",
				OutputIndex=5,
				ParameterName="Base Color Map",
				Group="10 - Diffuse",
				SortPriority=5,
				Coordinates=Global_UV,
				Texture=Path(Engine, "EngineResources/WhiteSquareTexture"),
				SamplerType="SAMPLERTYPE_Color"
			);
		float4 Base_Color_Map_1 =
			UE.Expression(
				Class="TextureSampleParameter2D",
				OutputType="float4",
				OutputIndex=5,
				ParameterName="Base Color Map",
				Group="10 - Diffuse",
				SortPriority=5,
				Coordinates=Global_UV,
				Texture=Path(Engine, "EngineResources/WhiteSquareTexture"),
				SamplerType="SAMPLERTYPE_Color",
				SamplerSource="SSM_Wrap_WorldGroupSettings"
			);
		float4 StaticSwitchParameter_5 =
			UE.Expression(
				Class="StaticSwitchParameter",
				OutputType="float4",
				True=Base_Color_Map.rgba,
				False=Base_Color_Map_1.rgba,
				Group="00 - Global Settings",
				SortPriority=32,
				ParameterName="Enable Per Texture Sampler"
			);
		#EndRegion

		float4 Sampled_Base_Color = StaticSwitchParameter_5;
		#Region "Diffuse"
		float3 Multiply_3 = (Base_Color.rgb * Sampled_Base_Color.rgb);
		float3 Multiply_4 = (Multiply_3 * InnerOutlineColor);
		#EndRegion

		float3 Base_Color_1 = Multiply_4;
		float4 StaticSwitchParameter_6 =
			UE.Expression(
				Class="StaticSwitchParameter",
				OutputType="float4",
				True=ShadingFeatureColor,
				False=Base_Color_1,
				Group="00 - Global Settings",
				SortPriority=70,
				ParameterName="Debug Shading Feature"
			);
		float4 StaticSwitchParameter_7 =
			UE.Expression(
				Class="StaticSwitchParameter",
				OutputType="float4",
				True=Add,
				False=StaticSwitchParameter_6,
				Group="00 - Global Settings",
				SortPriority=70,
				ParameterName="Debug Tangent"
			);
		Attributes.BaseColor = StaticSwitchParameter_7;
		#Region "Texture Sample"
		float4 Metallic_Map =
			UE.Expression(
				Class="TextureSampleParameter2D",
				OutputType="float4",
				OutputIndex=5,
				ParameterName="Metallic Map",
				Group="11 - Specular",
				SortPriority=51,
				Coordinates=Global_UV,
				Texture=Path(Plugins.MoonToon, "Textures/T_White_Linear"),
				SamplerType="SAMPLERTYPE_LinearColor"
			);
		float4 Metallic_Map_1 =
			UE.Expression(
				Class="TextureSampleParameter2D",
				OutputType="float4",
				OutputIndex=5,
				ParameterName="Metallic Map",
				Group="11 - Specular",
				SortPriority=51,
				Coordinates=Global_UV,
				Texture=Path(Plugins.MoonToon, "Textures/T_White_Linear"),
				SamplerType="SAMPLERTYPE_LinearColor",
				SamplerSource="SSM_Wrap_WorldGroupSettings"
			);
		float4 StaticSwitchParameter_8 =
			UE.Expression(
				Class="StaticSwitchParameter",
				OutputType="float4",
				True=Metallic_Map.rgba,
				False=Metallic_Map_1.rgba,
				Group="00 - Global Settings",
				SortPriority=32,
				ParameterName="Enable Per Texture Sampler"
			);
		float4 StaticSwitchParameter_9 =
			UE.Expression(
				Class="StaticSwitchParameter",
				OutputType="float4",
				True=Sampled_Global_Mask_Map,
				False=StaticSwitchParameter_8,
				Group="11 - Specular",
				SortPriority=50,
				ParameterName="Metallic From Global Mask Map",
				DefaultValue=true
			);
		#EndRegion

		float Metallic_Channel_Masked = Metallic_Channel(Input = StaticSwitchParameter_9);
		float Sampled_Metallic = Metallic_Channel_Masked;
		#Region "Specular"
		float Multiply_5 = (Sampled_Metallic * Metallic);
		#EndRegion

		float Metallic_1 = Multiply_5;
		Attributes.Metallic = Metallic_1;
		Attributes.Specular = Specular;
		#Region "Texture Sample"
		float4 Roughness_Map =
			UE.Expression(
				Class="TextureSampleParameter2D",
				OutputType="float4",
				OutputIndex=5,
				ParameterName="Roughness Map",
				Group="11 - Specular",
				SortPriority=41,
				Coordinates=Global_UV,
				Texture=Path(Plugins.MoonToon, "Textures/T_White_Linear"),
				SamplerType="SAMPLERTYPE_LinearColor"
			);
		float4 Roughness_Map_1 =
			UE.Expression(
				Class="TextureSampleParameter2D",
				OutputType="float4",
				OutputIndex=5,
				ParameterName="Roughness Map",
				Group="11 - Specular",
				SortPriority=41,
				Coordinates=Global_UV,
				Texture=Path(Plugins.MoonToon, "Textures/T_White_Linear"),
				SamplerType="SAMPLERTYPE_LinearColor",
				SamplerSource="SSM_Wrap_WorldGroupSettings"
			);
		float4 StaticSwitchParameter_10 =
			UE.Expression(
				Class="StaticSwitchParameter",
				OutputType="float4",
				True=Roughness_Map.rgba,
				False=Roughness_Map_1.rgba,
				Group="00 - Global Settings",
				SortPriority=32,
				ParameterName="Enable Per Texture Sampler"
			);
		float4 StaticSwitchParameter_11 =
			UE.Expression(
				Class="StaticSwitchParameter",
				OutputType="float4",
				True=Sampled_Global_Mask_Map,
				False=StaticSwitchParameter_10,
				Group="11 - Specular",
				SortPriority=40,
				ParameterName="Roughness From Global Mask Map",
				DefaultValue=true
			);
		#EndRegion

		float Roughness_Channel_Masked = Roughness_Channel(Input = StaticSwitchParameter_11);
		float Sampled_Roughness = Roughness_Channel_Masked;
		#Region "Specular"
		float StaticSwitchParameter_12 =
			UE.Expression(
				Class="StaticSwitchParameter",
				OutputType="float",
				True=(1.0 - Sampled_Roughness),
				False=Sampled_Roughness,
				Group="11 - Specular",
				SortPriority=43,
				ParameterName="Invert Roughness Channel"
			);
		float Multiply_6 = (StaticSwitchParameter_12 * Roughness);
		#EndRegion

		float Roughness_1 = Multiply_6;
		Attributes.Roughness = Roughness_1;
		#Region "Specular"
		float StaticSwitchParameter_13 =
			UE.Expression(
				Class="StaticSwitchParameter",
				OutputType="float",
				True=Anisotropy,
				False=0.0,
				Group="11 - Specular",
				SortPriority=2,
				ParameterName="Use Anisotropy"
			);
		#EndRegion

		float Anisotropy_Output = StaticSwitchParameter_13;
		Attributes.Anisotropy = Anisotropy_Output;
		#Region "Texture Sample"
		float4 Emissive_Map =
			UE.Expression(
				Class="TextureSampleParameter2D",
				OutputType="float4",
				OutputIndex=5,
				ParameterName="Emissive Map",
				Group="23 - Emissive",
				Coordinates=Global_UV,
				Texture=Path(Engine, "EngineResources/WhiteSquareTexture"),
				SamplerType="SAMPLERTYPE_Color"
			);
		float4 Emissive_Map_1 =
			UE.Expression(
				Class="TextureSampleParameter2D",
				OutputType="float4",
				OutputIndex=5,
				ParameterName="Emissive Map",
				Group="23 - Emissive",
				Coordinates=Global_UV,
				Texture=Path(Engine, "EngineResources/WhiteSquareTexture"),
				SamplerType="SAMPLERTYPE_Color",
				SamplerSource="SSM_Wrap_WorldGroupSettings"
			);
		float3 StaticSwitchParameter_14 =
			UE.Expression(
				Class="StaticSwitchParameter",
				OutputType="float3",
				True=Emissive_Map.rgb,
				False=Emissive_Map_1.rgb,
				Group="00 - Global Settings",
				SortPriority=32,
				ParameterName="Enable Per Texture Sampler"
			);
		#EndRegion

		float3 Sampled_Emissive = StaticSwitchParameter_14;
		#Region "Emissive"
		float3 Multiply_7 = (Emissive_Intensity * Sampled_Emissive);
		float3 StaticSwitchParameter_15 =
			UE.Expression(
				Class="StaticSwitchParameter",
				OutputType="float3",
				True=Multiply_7,
				False=0.0,
				Group="23 - Emissive",
				SortPriority=0,
				ParameterName="Enable Emission"
			);
		#EndRegion

		float3 Emission = StaticSwitchParameter_15;
		Attributes.EmissiveColor = Emission;
		#Region "Texture Sample"
		float4 Opacity_Map =
			UE.Expression(
				Class="TextureSampleParameter2D",
				OutputType="float4",
				OutputIndex=5,
				ParameterName="Opacity Map",
				Group="21 - Translucency",
				Coordinates=Global_UV,
				Texture=Path(Engine, "EngineResources/WhiteSquareTexture"),
				SamplerType="SAMPLERTYPE_Color"
			);
		float4 Opacity_Map_1 =
			UE.Expression(
				Class="TextureSampleParameter2D",
				OutputType="float4",
				OutputIndex=5,
				ParameterName="Opacity Map",
				Group="21 - Translucency",
				Coordinates=Global_UV,
				Texture=Path(Engine, "EngineResources/WhiteSquareTexture"),
				SamplerType="SAMPLERTYPE_Color",
				SamplerSource="SSM_Wrap_WorldGroupSettings"
			);
		float4 StaticSwitchParameter_16 =
			UE.Expression(
