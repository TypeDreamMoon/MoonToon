		float4 StaticSwitchParameter_48 =
			UE.Expression(
				Class="StaticSwitchParameter",
				OutputType="float4",
				True=Sampled_Global_Mask_Map,
				False=StaticSwitchParameter_47,
				Group="10 - Diffuse",
