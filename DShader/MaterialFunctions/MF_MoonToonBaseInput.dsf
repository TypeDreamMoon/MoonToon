		#EndRegion

		float3 TangentWS = StaticSwitchParameter_27;
		Attributes.Tangent = TangentWS;
		float2 MaterialExpressionTextureCoordinate_6 = UE.Expression(Class="TextureCoordinate", OutputType="float2", CoordinateIndex=1);
		#Region "Decode Hightlight Tangent or Face Forward Dir"
		float2 StaticSwitchParameter_28 =
			UE.Expression(
				Class="StaticSwitchParameter",
				OutputType="float2",
				True=normalize(Transform).rg,
				False=MaterialExpressionTextureCoordinate_6,
				Group="00 - Global Settings",
				SortPriority=61,
				ParameterName="Use Highlight Tangent baked in Houdini UV23",
				DefaultValue=true
			);
		#EndRegion

		float2 MaterialExpressionTextureCoordinate_6_1 = UE.Expression(Class="TextureCoordinate", OutputType="float2", CoordinateIndex=1);
		#Region "Decode Hightlight Tangent or Face Forward Dir"
		float2 StaticSwitchParameter_29 = Is_KajiyaHair(
			True = StaticSwitchParameter_28,
			False = Is_ToonKajiyaHair(True = StaticSwitchParameter_28, False = MaterialExpressionTextureCoordinate_6_1));
		float2 StaticSwitchParameter_30 = Is_DFFacialShadow(True = normalize(Transform).rg, False = StaticSwitchParameter_29);
		#EndRegion

		float2 Custom_Vertex_UV1 = StaticSwitchParameter_30;
		Attributes.CustomizedUV1 = Custom_Vertex_UV1;
		float2 MaterialExpressionTextureCoordinate_5_3 = UE.Expression(Class="TextureCoordinate", OutputType="float2", CoordinateIndex=2);
		float2 MaterialExpressionTextureCoordinate_5_4 = UE.Expression(Class="TextureCoordinate", OutputType="float2", CoordinateIndex=2);
		float2 MaterialExpressionTextureCoordinate_7 = UE.Expression(Class="TextureCoordinate", OutputType="float2", CoordinateIndex=2);
		#Region "Decode Hightlight Tangent or Face Forward Dir"
		float2 StaticSwitchParameter_31 =
			UE.Expression(
				Class="StaticSwitchParameter",
				OutputType="float2",
				True=float2(normalize(Transform).b, MaterialExpressionTextureCoordinate_5_4.g),
				False=MaterialExpressionTextureCoordinate_7,
				Group="00 - Global Settings",
				SortPriority=61,
				ParameterName="Use Highlight Tangent baked in Houdini UV23",
				DefaultValue=true
