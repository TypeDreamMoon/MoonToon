		float2 MaterialExpressionTextureCoordinate_4_2 = UE.Expression(Class="TextureCoordinate", OutputType="float2", CoordinateIndex=1);
		float2 MaterialExpressionTextureCoordinate_5_2 = UE.Expression(Class="TextureCoordinate", OutputType="float2", CoordinateIndex=2);
		#Region "Decode Hightlight Tangent or Face Forward Dir"
		// The shared [0,1] -> tangent-space -> world decode. Both the Kajiya strand tangent (below)
		// and the face-forward CustomizedUV path (further down) read it; it lives up here because the
		// graph evaluates in order and the strand switch is its first consumer.
		float3 Multiply_11 = (float3(MaterialExpressionTextureCoordinate_4_2.rg, MaterialExpressionTextureCoordinate_5_2.r) * 2.0);
		float3 Add_4 = (Multiply_11 + -1.0);
		float3 Transform = UE.Expression(Class="Transform", OutputType="float3", Input=Add_4);
