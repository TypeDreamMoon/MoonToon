			False = Is_ToonKajiyaHair(True = StaticSwitchParameter_31, False = MaterialExpressionTextureCoordinate_7_1));
		float2 StaticSwitchParameter_33 = Is_DFFacialShadow(True = float2(normalize(Transform).b, MaterialExpressionTextureCoordinate_5_3.g), False = StaticSwitchParameter_32);
		#EndRegion

		float2 Custom_Vertex_UV2 = StaticSwitchParameter_33;
		Attributes.CustomizedUV2 = Custom_Vertex_UV2;
		#Region "RT Shadow Flag (call in Ray Tracing Hit Shader (FMooaCustomPayload))"
		float StaticSwitchParameter_34 =
			UE.Expression(
				Class="StaticSwitchParameter",
				OutputType="float",
				True=1.0,
				False=0.0,
				Group="13 - Ray Tracing Shadow",
				SortPriority=60,
				ParameterName="Disable Self Shadow",
				DefaultValue=true
			);
		float StaticSwitchParameter_35 =
			UE.Expression(
				Class="StaticSwitchParameter",
				OutputType="float",
				True=1.0,
				False=0.0,
				Group="13 - Ray Tracing Shadow",
				SortPriority=61,
				ParameterName="Disable Cast Shadow On Toon",
				DefaultValue=true
			);
		#EndRegion

		#Region "Texture Sample"
		float2 MF_UVChannelSwitch_4 = MF_UVChannelSwitch(ID_Map_UV_Channel);
		float4 StaticSwitchParameter_36 = MF_ToonSampleLinearMip0(ID_Map_R_, MF_UVChannelSwitch_4).rgba;
		float4 StaticSwitchParameter_37 =
			UE.Expression(
				Class="StaticSwitchParameter",
				OutputType="float4",
				True=Sampled_Global_Mask_Map,
				False=StaticSwitchParameter_36,
				Group="13 - Ray Tracing Shadow",
				SortPriority=31,
				ParameterName="ID From Global Mask Map"
			);
		float4 StaticSwitchParameter_38 =
			UE.Expression(
				Class="StaticSwitchParameter",
				OutputType="float4",
				True=Sampled_Vertex_Color,
				False=StaticSwitchParameter_37,
				Group="13 - Ray Tracing Shadow",
				SortPriority=30,
				ParameterName="ID From Vertex Color"
			);
		#EndRegion

		float ID_Channel_Masked = ID_Channel(Input = StaticSwitchParameter_38);
		float Sampled_ID_Map = ID_Channel_Masked;
		#Region "RayTracing Shadow"
		float Multiply_12 = (Sampled_ID_Map * 255.0);
		#EndRegion

		float ID = floor(Multiply_12);
		#Region "RayTracing Shadow"
		float Add_5 = (ID + floor(ID_Offset));
		float Divide = (Add_5 / 255.0);
		float Multiply_13 = (saturate(Divide) * 31.0);
		#EndRegion

		float Encoded_Stencil = Multiply_13;
		#Region "RT Shadow Flag (call in Ray Tracing Hit Shader (FMooaCustomPayload))"
		float Encode_Mooa_Ray_Tracing_Data =
			UE.Expression(
				Class="Custom",
				OutputType="float",
				Code="FMoonCustomPayload MoonCustomPayload = (FMoonCustomPayload)0;\r\nif (DisableSelfShadow) MoonCustomPayload.SetDisableSelfShadow();\r\nif (DisableCastShadowOnToon) MoonCustomPayload.SetDisableCastShadowOnToon();\r\nMoonCustomPayload.SetStencil(inStencil);\r\nreturn MoonCustomPayload.MoonCustomData;",
				Description="Encode Mooa Ray Tracing Data",
				DisableSelfShadow=StaticSwitchParameter_34,
				DisableCastShadowOnToon=StaticSwitchParameter_35,
				inStencil=Encoded_Stencil
			);
		#EndRegion

		float Encoded_Ray_Tracing_Data = Encode_Mooa_Ray_Tracing_Data;
		Attributes.CustomData0 = Encoded_Ray_Tracing_Data;
		#Region "Texture Sample"
		float3 StaticSwitchParameter_45 = MF_ToonSampleColor(Shadow_Color_Map, Global_UV).rgb;
		#EndRegion

		float3 Sampled_Shadow_Color = StaticSwitchParameter_45;
		#Region "Diffuse"
		float3 Multiply_14 = (Shadow_Color.rgb * Sampled_Shadow_Color);
		float3 Multiply_15 = (Multiply_14 * InnerOutlineColor);
		#EndRegion

		float3 Shadow_Color_1 = Multiply_15;
		float3 StaticSwitchParameter_46 =
			UE.Expression(
				Class="StaticSwitchParameter",
				OutputType="float3",
				True=Add,
				False=Shadow_Color_1,
				Group="00 - Global Settings",
				SortPriority=70,
				ParameterName="Debug Tangent"
			);
		#Region "Diffuse Ramp Index"
		// Custom ramp: ToonRampAtlas registers the (texture, row) pair into the dynamic ramp atlas at
		// uniform-buffer fill time and returns its slice, so the material never hand-picks an index.
		// The static switch keeps the legacy hand-authored index as the default, which is why existing
		// material instances are untouched -- and the unused branch is culled at translation.
		float Custom_Diffuse_Ramp_Slice =
			UE.Expression(
				Class="ToonRampAtlas",
				OutputType="float1",
				RampTexture=Custom_Diffuse_Ramp,
