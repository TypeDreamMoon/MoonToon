		#EndRegion

		#Region "Texture Sample"
		float4 StaticSwitchParameter_47 = MF_ToonSampleLinear(Diffuse_Ramp_Offset_Map, Global_UV).rgba;
		float4 StaticSwitchParameter_48 =
			UE.Expression(
				Class="StaticSwitchParameter",
				OutputType="float4",
				True=Sampled_Global_Mask_Map,
				False=StaticSwitchParameter_47,
				Group="10 - Diffuse",
				SortPriority=35,
				ParameterName="Diffuse Ramp Offset From Global Mask Map",
				DefaultValue=true
			);
		#EndRegion

		float Diffuse_Ramp_Offset_Channel_Masked = Diffuse_Ramp_Offset_Channel(Input = StaticSwitchParameter_48);
		float Sampled_Diffuse_Ramp_Offset = Diffuse_Ramp_Offset_Channel_Masked;
		#Region "Diffuse"
		float LinearInterpolate_3 = lerp(0.5, Sampled_Diffuse_Ramp_Offset, Diffuse_Ramp_Offset_Intensity);
		#EndRegion

		float Diffuse_Ramp_UV_Offset = LinearInterpolate_3;
		#Region "Texture Sample"
		float3 StaticSwitchParameter_49 = MF_ToonSampleColor(Specular_Color_Map, Global_UV).rgb;
		#EndRegion

		float3 Sampled_Specular_Color = StaticSwitchParameter_49;
		#Region "Specular"
		float3 Multiply_16 = (Specular_Color.rgb * Sampled_Specular_Color);
		#EndRegion

		float3 Specular_Color_1 = Multiply_16;
		#Region "Specular Ramp Index"
		// Mirror of the diffuse path above, against the 32-slice specular atlas.
		float Custom_Specular_Ramp_Slice =
			UE.Expression(
				Class="ToonRampAtlas",
				OutputType="float1",
				RampTexture=Custom_Specular_Ramp,
				Row=Custom_Specular_Ramp_Row,
				bSpecularRamp=true
			);
		float Specular_Ramp_Index =
			UE.Expression(
				Class="StaticSwitchParameter",
				OutputType="float1",
				True=Custom_Specular_Ramp_Slice,
				False=Specular_Color_Ramp_Index,
				Group="11 - Specular",
				SortPriority=1,
				ParameterName="Use Custom Specular Ramp",
				DefaultValue=false
			);
		#EndRegion

		#Region "Texture Sample"
		float4 StaticSwitchParameter_50 = MF_ToonSampleLinear(Specular_Ramp_Offset_Map, Global_UV).rgba;
		float4 StaticSwitchParameter_51 =
			UE.Expression(
				Class="StaticSwitchParameter",
				OutputType="float4",
				True=Sampled_Global_Mask_Map,
				False=StaticSwitchParameter_50,
				Group="11 - Specular",
				SortPriority=60,
				ParameterName="Specular Ramp Offset From Global Mask Map",
				DefaultValue=true
			);
		#EndRegion

		float Specular_Ramp_Offset_Channel_Masked = Specular_Ramp_Offset_Channel(Input = StaticSwitchParameter_51);
		float Sampled_Specular_Ramp_Offset = Specular_Ramp_Offset_Channel_Masked;
		#Region "Specular"
		float Subtract = (Sampled_Specular_Ramp_Offset - 0.5);
		float Multiply_17 = (Specular_Ramp_Offset_Intensity * Subtract);
		float Add_6 = (Multiply_17 + 0.5);
		#EndRegion

		float Specular_Ramp_Offset = Add_6;
		float Rim_Intensity = Rim_Light_Intensity;
		float Rim_Light_Width_Channel_Masked = Rim_Light_Width_Channel(Input = Sampled_Global_Mask_Map);
		float Rim_Light_Width_Channel_1_Masked = Rim_Light_Width_Channel_1(Input = Sampled_Vertex_Color);
		#Region "Texture Sample"
		float StaticSwitchParameter_52 =
			UE.Expression(
				Class="StaticSwitchParameter",
				OutputType="float",
				True=Rim_Light_Width_Channel_1_Masked,
				False=1.0,
				Group="12 - Rim Light",
				SortPriority=32,
				ParameterName="Rim Light Width From Vertex Color"
			);
		float StaticSwitchParameter_53 =
			UE.Expression(
				Class="StaticSwitchParameter",
				OutputType="float",
				True=Rim_Light_Width_Channel_Masked,
				False=StaticSwitchParameter_52,
				Group="12 - Rim Light",
				SortPriority=33,
				ParameterName="Rim Light Width From Global Mask Map"
			);
		#EndRegion

		float Sampled_Rim_Width = StaticSwitchParameter_53;
		#Region "Rim Light"
		float Multiply_18 = (Rim_Light_Width * Sampled_Rim_Width);
		#EndRegion

		float Rim_Width = Multiply_18;
		float2 MaterialExpressionTextureCoordinate_0 = UE.Expression(Class="TextureCoordinate", OutputType="float2");
		float4 SA_Map_3 =
			UE.Expression(
				Class="TextureSampleParameter2D",
				OutputType="float4",
				OutputIndex=5,
				ParameterName="SA Map",
				Group="00 - Global Settings",
				Coordinates=MaterialExpressionTextureCoordinate_0,
				Texture=Path(Engine, "EngineResources/Black"),
				SamplerType="SAMPLERTYPE_Color",
				SamplerSource="SSM_Wrap_WorldGroupSettings"
			);
		float SA_SDF_Left = SA_Map_3.r;
		float2 MaterialExpressionTextureCoordinate_2 = UE.Expression(Class="TextureCoordinate", OutputType="float2");
		#Region "Texture Sample"
		float2 Multiply_19 = (float2(-1.0, 1.0) * MaterialExpressionTextureCoordinate_2);
		float4 Distance_Field_Facial_Shadow_Map =
			UE.Expression(
				Class="TextureSampleParameter2D",
				OutputType="float4",
				OutputIndex=5,
				ParameterName="Distance Field Facial Shadow Map",
				Group="02 - Distance Field Facial Shadow",
				Desc="距离场面影贴图, 关于制作方法搜索\"Distance Field Facial Shadow\".\r\n压缩格式必须是\"Half Float (R16F)\", 且禁用sRGB.\r\n\r\n\r\nDistance Field Facial Shadow Map, search \"Distance Field Facial Shadow\" for the production method.\r\nThe compression format must be \"Half Float (R16F)\", and disable sRGB.",
				Coordinates=Multiply_19,
				Texture=Path(Plugins.MoonToon, "Textures/T_White_Linear"),
				SamplerType="SAMPLERTYPE_LinearColor",
				SamplerSource="SSM_Wrap_WorldGroupSettings",
				MipValueMode="TMVM_MipLevel",
				ConstMipValue=0
			);
		#EndRegion

		float Distance_Field_Facial_Shadow_Map_Channel_Masked = Distance_Field_Facial_Shadow_Map_Channel(Input = Distance_Field_Facial_Shadow_Map.rgba);
		float SampledFacialShadowSdfRight = Distance_Field_Facial_Shadow_Map_Channel_Masked;
		float2 MaterialExpressionTextureCoordinate_2_1 = UE.Expression(Class="TextureCoordinate", OutputType="float2");
		#Region "Texture Sample"
		float4 Distance_Field_Facial_Shadow_Map_1 =
			UE.Expression(
				Class="TextureSampleParameter2D",
				OutputType="float4",
				OutputIndex=5,
				ParameterName="Distance Field Facial Shadow Map",
				Group="02 - Distance Field Facial Shadow",
				Desc="距离场面影贴图, 关于制作方法搜索\"Distance Field Facial Shadow\".\r\n压缩格式必须是\"Half Float (R16F)\", 且禁用sRGB.\r\n\r\n\r\nDistance Field Facial Shadow Map, search \"Distance Field Facial Shadow\" for the production method.\r\nThe compression format must be \"Half Float (R16F)\", and disable sRGB.",
				Coordinates=MaterialExpressionTextureCoordinate_2_1,
				Texture=Path(Plugins.MoonToon, "Textures/T_White_Linear"),
				SamplerType="SAMPLERTYPE_LinearColor",
				SamplerSource="SSM_Wrap_WorldGroupSettings",
				MipValueMode="TMVM_MipLevel",
				ConstMipValue=0
			);
		#EndRegion

		float Distance_Field_Facial_Shadow_Map_Channel_1_Masked = Distance_Field_Facial_Shadow_Map_Channel_1(Input = Distance_Field_Facial_Shadow_Map_1.rgba);
		float SampledFacialShadowSdfLeft = Distance_Field_Facial_Shadow_Map_Channel_1_Masked;
		#Region "Distance Field Facial Shadow"
		float StaticSwitchParameter_54 =
			UE.Expression(
				Class="StaticSwitchParameter",
				OutputType="float",
				True=SampledFacialShadowSdfRight,
				False=SampledFacialShadowSdfLeft,
				Group="02 - Distance Field Facial Shadow",
				SortPriority=32,
				ParameterName="Flip Left Right"
			);
		float StaticSwitchParameter_55 = Is_DFFacialShadow(True = StaticSwitchParameter_54, False = 0.0);
		#EndRegion

		float FacialShadowSdfLeft = StaticSwitchParameter_55;
		float StaticSwitchParameter_56 =
			UE.Expression(
				Class="StaticSwitchParameter",
				OutputType="float",
				True=SA_SDF_Left,
				False=FacialShadowSdfLeft,
				Group="00 - Global Settings",
				SortPriority=70,
				ParameterName="SDF Face Shadow From SA Map"
			);
		float2 MaterialExpressionTextureCoordinate_0_1 = UE.Expression(Class="TextureCoordinate", OutputType="float2");
		#Region "Texture Sample"
		float2 Multiply_20 = (float2(-1.0, 1.0) * MaterialExpressionTextureCoordinate_0_1);
		float4 SA_Map_4 =
			UE.Expression(
				Class="TextureSampleParameter2D",
				OutputType="float4",
				OutputIndex=5,
				ParameterName="SA Map",
				Group="00 - Global Settings",
				Coordinates=Multiply_20,
				Texture=Path(Engine, "EngineResources/Black"),
				SamplerType="SAMPLERTYPE_Color",
				SamplerSource="SSM_Wrap_WorldGroupSettings"
			);
		#EndRegion

		float3 SA_SDF_Right = SA_Map_4.rgb;
		#Region "Distance Field Facial Shadow"
		float StaticSwitchParameter_57 =
			UE.Expression(
				Class="StaticSwitchParameter",
				OutputType="float",
				True=SampledFacialShadowSdfLeft,
				False=SampledFacialShadowSdfRight,
				Group="02 - Distance Field Facial Shadow",
				SortPriority=32,
				ParameterName="Flip Left Right"
			);
		float StaticSwitchParameter_58 = Is_DFFacialShadow(True = StaticSwitchParameter_57, False = 0.0);
		#EndRegion

		float FacialShadowSdfRight = StaticSwitchParameter_58;
		float3 StaticSwitchParameter_59 =
			UE.Expression(
				Class="StaticSwitchParameter",
				OutputType="float3",
				True=SA_SDF_Right,
				False=FacialShadowSdfRight,
				Group="00 - Global Settings",
				SortPriority=70,
				ParameterName="SDF Face Shadow From SA Map"
			);
		#Region "RayTracing Shadow"
		float If =
			UE.Expression(
				Class="If",
				OutputType="float",
				A=ID,
				B=floor(Face_ID),
				AGreaterThanB=0.0,
				AEqualsB=1.0,
				ALessThanB=0.0
			);
		float StaticSwitchParameter_60 =
			UE.Expression(
				Class="StaticSwitchParameter",
				OutputType="float",
				True=1.0,
				False=If,
				Group="13 - Ray Tracing Shadow",
				SortPriority=81,
				ParameterName="Is Face"
			);
		#EndRegion

		float Is_Face = StaticSwitchParameter_60;
		#Region "RayTracing Shadow"
		float StaticSwitchParameter_61 =
			UE.Expression(
				Class="StaticSwitchParameter",
				OutputType="float",
				True=2.0,
				False=1.0,
				Group="13 - Ray Tracing Shadow",
				SortPriority=80,
				ParameterName="Use Screen Space Depth Test Hair Shadow"
			);
		float If_1 =
			UE.Expression(
				Class="If",
				OutputType="float",
				A=ID,
				B=floor(Hair_ID),
				AGreaterThanB=0.0,
				AEqualsB=1.0,
				ALessThanB=0.0
			);
		float StaticSwitchParameter_62 =
			UE.Expression(
				Class="StaticSwitchParameter",
				OutputType="float",
				True=1.0,
				False=If_1,
				Group="13 - Ray Tracing Shadow",
				SortPriority=81,
				ParameterName="Is Hair"
			);
		#EndRegion

		float Is_Hair = StaticSwitchParameter_62;
		#Region "RayTracing Shadow"
		float If_2 =
			UE.Expression(
				Class="If",
				OutputType="float",
				A=Is_Hair,
				AGreaterThanB=3.0,
				AEqualsB=0.0,
				ALessThanB=0.0
			);
		float If_3 =
			UE.Expression(
				Class="If",
				OutputType="float",
				A=Is_Face,
				AGreaterThanB=StaticSwitchParameter_61,
				AEqualsB=If_2,
				ALessThanB=If_2
			);
		#EndRegion

		float Encoded_Ray_Tracing_Flags = If_3;
		float4 MoonEncodeToonAttributes =
			UE.Expression(
				Class="MoonEncodeToonAttributes",
				OutputType="float4",
				ShadingFeatureID=ShadingFeatureID,
				MainLightShadowColor=StaticSwitchParameter_46,
				DiffuseColorRampIndex=Diffuse_Ramp_Index,
				DiffuseColorRampUVOffset=Diffuse_Ramp_UV_Offset,
				SpecularColor=Specular_Color_1,
				SpecularColorRampIndex=Specular_Ramp_Index,
				SpecularColorRampUVOffset=Specular_Ramp_Offset,
				ReflectionIntensity=Reflection,
				RimLightIntensity=Rim_Intensity,
				RimLightWidth=Rim_Width,
				FacialShadowSdfLeft=StaticSwitchParameter_56,
				FacialShadowSdfRight=StaticSwitchParameter_59,
				Stencil=Encoded_Stencil,
				RayTracingShadowFlag=Encoded_Ray_Tracing_Flags
			);
		Attributes.MoonEncodedAttribute0 = MoonEncodeToonAttributes.rgba;
		float4 MoonEncodeToonAttributes_1 =
			UE.Expression(
				Class="MoonEncodeToonAttributes",
				OutputType="float4",
				OutputIndex=1,
				ShadingFeatureID=ShadingFeatureID,
				MainLightShadowColor=StaticSwitchParameter_46,
				DiffuseColorRampIndex=Diffuse_Ramp_Index,
				DiffuseColorRampUVOffset=Diffuse_Ramp_UV_Offset,
				SpecularColor=Specular_Color_1,
				SpecularColorRampIndex=Specular_Ramp_Index,
				SpecularColorRampUVOffset=Specular_Ramp_Offset,
				ReflectionIntensity=Reflection,
				RimLightIntensity=Rim_Intensity,
				RimLightWidth=Rim_Width,
				FacialShadowSdfLeft=StaticSwitchParameter_56,
				FacialShadowSdfRight=StaticSwitchParameter_59,
				Stencil=Encoded_Stencil,
				RayTracingShadowFlag=Encoded_Ray_Tracing_Flags,
				ScreenSpaceHairShadowIntensity=Screen_Space_Hair_Shadow_Intensity,
				DisableShadowMapShadow=StaticSwitchParameter_34
			);
		Attributes.MoonEncodedAttribute1 = MoonEncodeToonAttributes_1.rgba;
		float4 MoonEncodeToonAttributes_2 =
			UE.Expression(
				Class="MoonEncodeToonAttributes",
				OutputType="float4",
				OutputIndex=2,
				ShadingFeatureID=ShadingFeatureID,
				MainLightShadowColor=StaticSwitchParameter_46,
				DiffuseColorRampIndex=Diffuse_Ramp_Index,
				DiffuseColorRampUVOffset=Diffuse_Ramp_UV_Offset,
				SpecularColor=Specular_Color_1,
				SpecularColorRampIndex=Specular_Ramp_Index,
				SpecularColorRampUVOffset=Specular_Ramp_Offset,
				ReflectionIntensity=Reflection,
				RimLightIntensity=Rim_Intensity,
				RimLightWidth=Rim_Width,
				FacialShadowSdfLeft=StaticSwitchParameter_56,
				FacialShadowSdfRight=StaticSwitchParameter_59,
				Stencil=Encoded_Stencil,
				RayTracingShadowFlag=Encoded_Ray_Tracing_Flags
			);
		Attributes.MoonEncodedAttribute2 = MoonEncodeToonAttributes_2.rgba;
		float4 MoonEncodeToonAttributes_3 =
			UE.Expression(
				Class="MoonEncodeToonAttributes",
				OutputType="float4",
				OutputIndex=3,
				ShadingFeatureID=ShadingFeatureID,
				MainLightShadowColor=StaticSwitchParameter_46,
				DiffuseColorRampIndex=Diffuse_Ramp_Index,
				DiffuseColorRampUVOffset=Diffuse_Ramp_UV_Offset,
				SpecularColor=Specular_Color_1,
				SpecularColorRampIndex=Specular_Ramp_Index,
				SpecularColorRampUVOffset=Specular_Ramp_Offset,
				ReflectionIntensity=Reflection,
				RimLightIntensity=Rim_Intensity,
				RimLightWidth=Rim_Width,
				FacialShadowSdfLeft=StaticSwitchParameter_56,
				FacialShadowSdfRight=StaticSwitchParameter_59,
				Stencil=Encoded_Stencil,
				RayTracingShadowFlag=Encoded_Ray_Tracing_Flags
			);
		Attributes.MoonEncodedAttribute3 = MoonEncodeToonAttributes_3.rgba;
		float4 MoonEncodeToonAttributes_4 =
			UE.Expression(
				Class="MoonEncodeToonAttributes",
				OutputType="float4",
				OutputIndex=4,
				ShadingFeatureID=ShadingFeatureID,
				MainLightShadowColor=StaticSwitchParameter_46,
				DiffuseColorRampIndex=Diffuse_Ramp_Index,
				DiffuseColorRampUVOffset=Diffuse_Ramp_UV_Offset,
				SpecularColor=Specular_Color_1,
				SpecularColorRampIndex=Specular_Ramp_Index,
				SpecularColorRampUVOffset=Specular_Ramp_Offset,
				ReflectionIntensity=Reflection,
				RimLightIntensity=Rim_Intensity,
				RimLightWidth=Rim_Width,
				FacialShadowSdfLeft=StaticSwitchParameter_56,
				FacialShadowSdfRight=StaticSwitchParameter_59,
				Stencil=Encoded_Stencil,
				RayTracingShadowFlag=Encoded_Ray_Tracing_Flags
			);
		Attributes.MoonEncodedAttribute4 = MoonEncodeToonAttributes_4.rgba;
		Attributes.CustomData1 = 1.0;
		float4 MF_MoonToonBufferInput_1 = MF_MoonToonFeatureSelect(KajiyaSecondaryMaskChannel_Masked, KajiyaSecondaryMaskChannel_Masked, Hair_Highlight_Mask_Texture, BodyBaseColor.rgb, OutputIndex=0);
		float4 ToonBufferA_1 = MF_MoonToonBufferInput_1;
		float4 MF_MoonToonBufferInput_2 = MF_MoonToonFeatureSelect(KajiyaSecondaryMaskChannel_Masked, KajiyaSecondaryMaskChannel_Masked, Hair_Highlight_Mask_Texture, BodyBaseColor.rgb, OutputIndex=1);
		float4 ToonBufferB_1 = MF_MoonToonBufferInput_2;
		#Region "Toon Buffer"
		float4 MF_MoonToonBufferInput_3 = MF_MoonToonFeatureSelect(KajiyaSecondaryMaskChannel_Masked, KajiyaSecondaryMaskChannel_Masked, Hair_Highlight_Mask_Texture, BodyBaseColor.rgb, OutputIndex=2);
		#EndRegion

		float4 ToonBufferC_1 = MF_MoonToonBufferInput_3;

		#Region "See Through Overlay"
		// Base_Color_1 is the material's final albedo (base colour param x map x inner-outline),
		// deliberately taken BEFORE the debug switches so debug views never leak into the overlay.
		float3 Multiply_Overlay = (Base_Color_1 * Through_Hair_Tint.rgb);
		float4 StaticSwitchParameter_Overlay =
			UE.Expression(
				Class="StaticSwitchParameter",
				OutputType="float4",
				True=float4(Multiply_Overlay, Through_Hair_Opacity),
				False=float4(0.0, 0.0, 0.0, 0.0),
				Group="24 - See Through Overlay",
				SortPriority=5,
				ParameterName="Enable See Through Overlay"
			);
		#EndRegion

		float4 Face_Overlay_Data = StaticSwitchParameter_Overlay;
		float4 Face_Overlay_Params = float4(Through_Hair_Depth_Threshold, Through_Hair_Depth_Fade, Through_Hair_View_Fade_Start, Through_Hair_View_Fade_End);
		float4 Face_Overlay_Stencil_IDs = float4(Through_Hair_Occluder_ID_A, Through_Hair_Occluder_ID_B, -1.0, -1.0);

		Output = Attributes;
		ToonBufferA = ToonBufferA_1;
		ToonBufferB = ToonBufferB_1;
		ToonBufferC = ToonBufferC_1;
		FaceOverlayData = Face_Overlay_Data;
		FaceOverlayParams = Face_Overlay_Params;
		FaceOverlayStencilIDs = Face_Overlay_Stencil_IDs;
		MatcapData = Matcap_Data;
	}
}