		#Region "Decode Hightlight Tangent or Face Forward Dir"
		// Kajiya strand tangent, decoded exactly like the face-forward bake: the UV channels hold a
		// [0,1]-remapped TANGENT-SPACE direction (written by the MoonToon "Bake Strand Tangent" tool,
		// which shares the face-forward encoding), so it must be expanded *2-1 and transformed
		// tangent->world before it can feed Attributes.Tangent -- the toon engine path outputs that
		// pin as a world-space vector as-is. The original MooaToon decode read the raw UV values as a
		// world vector ("baked in Houdini"); that convention had no baker in this project, broke
		// under skinning, and read VRM-import UV residue as tangents. The Transform node below is the
		// same decode the face-forward path uses, reused rather than duplicated.
		float3 StaticSwitchParameter_25 =
			UE.Expression(
				Class="StaticSwitchParameter",
				OutputType="float3",
