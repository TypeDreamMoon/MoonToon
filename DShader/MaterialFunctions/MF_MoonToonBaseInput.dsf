		float StaticSwitchParameter_35 =
			UE.Expression(
				Class="StaticSwitchParameter",
				OutputType="float",
				True=1.0,
				False=0.0,
				Group="13 - Ray Tracing Shadow",
				SortPriority=61,
				ParameterName="Disable Cast Shadow On Toon",
				DefaultValue=true
			);
		#EndRegion

		#Region "Texture Sample"
		float2 MF_UVChannelSwitch_4 = MF_UVChannelSwitch(ID_Map_UV_Channel);
		float4 ID_Map_R_ =
			UE.Expression(
				Class="TextureSampleParameter2D",
				OutputType="float4",
				OutputIndex=5,
				ParameterName="ID Map(R)",
				Group="13 - Ray Tracing Shadow",
				Desc="ID Map是指将角色的不同部位填充不同的颜色, 以便在制作贴图或者后期效果时方便抠图.\r\n在影视工作流中通常是必备的贴图, 其分辨率可以很低, 只要保证不溢出UV边界即可.\r\n不同的值代表不同的ID, ID之间至少要有0.031(也就是8/255)的数值差.\r\n颜色空间: 线性.\r\n\r\nMooaToon使用ID来区分同角色的不同部位, 以精确控制每个部位是否投射阴影.\r\n或者用不同ID区分不同角色, 以实现同角色的模型之间没有自阴影, 但不同角色之间可以相互投影.\r\n\r\n\r\nID Map refers to filling different parts of the character with different colors to facilitate cutout when making textures or post-effects.\r\nID Map are usually necessary in film production workflows, and their resolution can be very low, as long as they do not overflow the UV boundary.\r\nDifferent values ​​represent different IDs, and there must be at least a numerical difference of 0.031 (that is, 8/255) between IDs.\r\nColor space: linear.\r\n\r\nMooaToon uses ID to distinguish different parts of the same character to precisely control whether each part casts a shadow.\r\nOr use different IDs to distinguish different characters, so that there is no self-shadowing between models of the same character, but different characters can cast shadows each other.",
				Coordinates=MF_UVChannelSwitch_4,
				Texture=Path(Plugins.MoonToon, "Textures/T_Black_Linear"),
				SamplerType="SAMPLERTYPE_LinearColor",
				MipValueMode="TMVM_MipLevel",
				ConstMipValue=0
			);
		float4 ID_Map_R_1 =
			UE.Expression(
				Class="TextureSampleParameter2D",
				OutputType="float4",
				OutputIndex=5,
				ParameterName="ID Map(R)",
				Group="13 - Ray Tracing Shadow",
				Desc="ID Map是指将角色的不同部位填充不同的颜色, 以便在制作贴图或者后期效果时方便抠图.\r\n在影视工作流中通常是必备的贴图, 其分辨率可以很低, 只要保证不溢出UV边界即可.\r\n不同的值代表不同的ID, ID之间至少要有0.031(也就是8/255)的数值差.\r\n颜色空间: 线性.\r\n\r\nMooaToon使用ID来区分同角色的不同部位, 以精确控制每个部位是否投射阴影.\r\n或者用不同ID区分不同角色, 以实现同角色的模型之间没有自阴影, 但不同角色之间可以相互投影.\r\n\r\n\r\nID Map refers to filling different parts of the character with different colors to facilitate cutout when making textures or post-effects.\r\nID Map are usually necessary in film production workflows, and their resolution can be very low, as long as they do not overflow the UV boundary.\r\nDifferent values ​​represent different IDs, and there must be at least a numerical difference of 0.031 (that is, 8/255) between IDs.\r\nColor space: linear.\r\n\r\nMooaToon uses ID to distinguish different parts of the same character to precisely control whether each part casts a shadow.\r\nOr use different IDs to distinguish different characters, so that there is no self-shadowing between models of the same character, but different characters can cast shadows each other.",
				Coordinates=MF_UVChannelSwitch_4,
				Texture=Path(Plugins.MoonToon, "Textures/T_Black_Linear"),
				SamplerType="SAMPLERTYPE_LinearColor",
				SamplerSource="SSM_Wrap_WorldGroupSettings",
				MipValueMode="TMVM_MipLevel",
				ConstMipValue=0
			);
		float4 StaticSwitchParameter_36 =
