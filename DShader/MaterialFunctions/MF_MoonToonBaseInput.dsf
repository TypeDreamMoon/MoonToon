		float2 MaterialExpressionTextureCoordinate_5_3 = UE.Expression(Class="TextureCoordinate", OutputType="float2", CoordinateIndex=2);
		float2 MaterialExpressionTextureCoordinate_5_4 = UE.Expression(Class="TextureCoordinate", OutputType="float2", CoordinateIndex=2);
		float2 MaterialExpressionTextureCoordinate_7 = UE.Expression(Class="TextureCoordinate", OutputType="float2", CoordinateIndex=2);
		#Region "Decode Hightlight Tangent or Face Forward Dir"
