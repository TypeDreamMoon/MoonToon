		#EndRegion

		float2 MaterialExpressionTextureCoordinate_7_1 = UE.Expression(Class="TextureCoordinate", OutputType="float2", CoordinateIndex=2);
		#Region "Decode Hightlight Tangent or Face Forward Dir"
		float2 StaticSwitchParameter_32 = Is_KajiyaHair(
