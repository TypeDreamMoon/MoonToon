		float3 NormalTS = StaticSwitchParameter_24;
		Attributes.Normal = NormalTS;

		#Region "Matcap"
		// MToon 1.0 builds the matcap frame from the VIEW VECTOR and pins one axis to the horizontal
		// plane, rather than taking the view-space normal directly. That is what keeps the matcap
		// still while the camera rolls -- Unity's toon shader ships the same thing as a separate
		// "Stabilize Camera Rolling" toggle. The spec is Y-up, so its
		//     normalize(float3(V.z, 0, -V.x))
		// becomes normalize(float3(V.y, -V.x, 0)) here, because UE's world is Z-up. Porting it
		// verbatim would rotate the matcap about the wrong axis.
		// 0.495 rather than 0.5 is the spec's half-texel guard against sampling past the sphere edge.
		// One line the spec does not have: straight down the world Z axis that frame is degenerate
		// (V.xy == 0), so it falls back to a fixed axis instead of producing NaNs.
		float3 Matcap_NormalWS = UE.Expression(Class="Transform", OutputType="float3", Input=NormalTS);
		float3 Matcap_ViewWS = UE.Expression(Class="CameraVectorWS", OutputType="float3");
		float2 Matcap_UV =
			UE.Expression(
				Class="Custom",
				OutputType="float2",
				Code="float3 N = normalize(NormalWS);\r\nfloat3 V = normalize(ViewWS);\r\nfloat2 Horizontal = float2(V.y, -V.x);\r\nfloat HorizontalLen = length(Horizontal);\r\nfloat3 AxisX = HorizontalLen > 1e-4f ? float3(Horizontal / HorizontalLen, 0.0f) : float3(1.0f, 0.0f, 0.0f);\r\nfloat3 AxisY = cross(V, AxisX);\r\nreturn float2(dot(AxisX, N), dot(AxisY, N)) * 0.495f + 0.5f;",
				Description="Matcap UV (MToon roll-stable frame, Z-up)",
				NormalWS=Matcap_NormalWS,
				ViewWS=Matcap_ViewWS
			);
		float2 Matcap_Mask_UV = MF_ToonUV(Matcap_Mask_UV_Channel, Matcap_Mask_UV_Scale_Offset);
		float3 Matcap_Sampled = MF_ToonSampleColor(Matcap_Map, Matcap_UV).rgb;
		float4 Matcap_Mask_Sampled = MF_ToonSampleLinear(Matcap_Mask_Map, Matcap_Mask_UV).rgba;
		// Mask and intensity are folded in here rather than sent to the engine separately: the
		// engine only ever multiplies them, so this keeps the mask texture entirely on the authoring
		// side and costs the GBuffer nothing.
		float3 Matcap_RGB = ((Matcap_Sampled * Matcap_Mask_Sampled.r) * Matcap_Intensity);
		// Uses the switch declared in Properties rather than an inline copy: two nodes with the same
		// ParameterName would still be one panel row, but only the declared one carries the
		// Description every parameter is required to have.
		float4 Matcap_Data = Enable_Matcap(
			True = float4(Matcap_RGB, Matcap_Lighting_Mix),
			False = float4(0.0, 0.0, 0.0, 0.0));
		#EndRegion

		float2 MaterialExpressionTextureCoordinate_4 = UE.Expression(Class="TextureCoordinate", OutputType="float2", CoordinateIndex=1);
		float2 MaterialExpressionTextureCoordinate_5 = UE.Expression(Class="TextureCoordinate", OutputType="float2", CoordinateIndex=2);
		float2 MaterialExpressionTextureCoordinate_4_2 = UE.Expression(Class="TextureCoordinate", OutputType="float2", CoordinateIndex=1);
		float2 MaterialExpressionTextureCoordinate_5_2 = UE.Expression(Class="TextureCoordinate", OutputType="float2", CoordinateIndex=2);
		#Region "Decode Hightlight Tangent or Face Forward Dir"
		// The shared [0,1] -> tangent-space -> world decode. Both the Kajiya strand tangent (below)
		// and the face-forward CustomizedUV path (further down) read it; it lives up here because the
		// graph evaluates in order and the strand switch is its first consumer.
		float3 Multiply_11 = (float3(MaterialExpressionTextureCoordinate_4_2.rg, MaterialExpressionTextureCoordinate_5_2.r) * 2.0);
		float3 Add_4 = (Multiply_11 + -1.0);
		float3 Transform = UE.Expression(Class="Transform", OutputType="float3", Input=Add_4);
		#EndRegion

		#Region "Decode Hightlight Tangent or Face Forward Dir"
		// Kajiya strand tangent, decoded exactly like the face-forward bake: the UV channels hold a
		// [0,1]-remapped TANGENT-SPACE direction (written by the MoonToon "Bake Strand Tangent" tool,
		// which shares the face-forward encoding), so it must be expanded *2-1 and transformed
		// tangent->world before it can feed Attributes.Tangent -- the toon engine path outputs that
		// pin as a world-space vector as-is. The original MooaToon decode read the raw UV values as a
		// world vector ("baked in Houdini"); that convention had no baker in this project, broke
		// under skinning, and read VRM-import UV residue as tangents. The Transform node below is the
		// same decode the face-forward path uses, reused rather than duplicated.
		float3 StaticSwitchParameter_25 =
			UE.Expression(
				Class="StaticSwitchParameter",
				OutputType="float3",
				True=normalize(Transform),
				False=0.0,
				Group="00 - Global Settings",
				SortPriority=61,
				ParameterName="Use Highlight Tangent baked in Houdini UV23",
				DefaultValue=true
			);
		float3 StaticSwitchParameter_26 = Is_KajiyaHair(
			True = StaticSwitchParameter_25,
			False = Is_ToonKajiyaHair(True = StaticSwitchParameter_25, False = float3(0.0, 0.0, 0.0)));
