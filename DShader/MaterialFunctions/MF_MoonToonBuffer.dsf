// MoonToon toon-buffer writer.
//
// Re-authored from MF_MoonToonBufferInput. Two things change from that asset:
//   * ShadingFeatureID is a real function input instead of a material parameter that
//     always read 0 (MOON_SHADING_FEATURE_ID_DEFAULT), which is why no feature branch
//     ever ran. ToonBufferA.x is the live 8-bit field; the GBuffer copy is deprecated.
//   * The pin/parameter name mismatch is now visible. The HLSL still calls its Kajiya
//     inputs In_Kajiya_*, while the material parameters keep their In_Hair_* names so
//     existing material instances still bind; which parameter feeds which pin is spelled
//     out in the Graph call below instead of being hidden in node connections.

Function MoonToonBufferWrite(
	in float DMask,
	in float ShadingFeatureID,
	in float SecondaryShadingFeatureID,
	in float In_HairMask_Mask,
	in float In_HairMask_Intensity,
	in float In_HairMask_ShadowIntensity,
	in float In_Kajiya_TangentRotate,
	in float In_Kajiya_SecondaryShift,
	in float In_Kajiya_SecondaryMask,
	in float In_Kajiya_PrimaryShift,
	in float In_Kajiya_PrimaryExpScale,
	in float In_Kajiya_SecondaryExpScale,
	in float In_Kajiya_OverallIntensity,
	in float In_Kajiya_PrimaryIntensity,
	in float In_Kajiya_SecondaryIntensity,
	in float In_Kajiya_SecondaryShiftScale,
	in float In_Kajiya_ShadowStrength,
	in float In_ToonKajiya_TangentRotate,
	in float In_ToonKajiya_SecondaryStrandShift,
	in float In_ToonKajiya_SecondaryMask,
	in float In_ToonKajiya_PrimaryStrandShift,
	in float In_ToonKajiya_PrimaryExpScale,
	in float In_ToonKajiya_SecondaryExpScale,
	in float In_ToonKajiya_OverallIntensity,
	in float In_ToonKajiya_PrimaryIntensity,
	in float In_ToonKajiya_SecondaryIntensity,
	in float In_ToonKajiya_SecondaryShiftScale,
	in float In_ToonKajiya_ShadowStrength,
	in float In_Skin_ScatterStrength,
	in float In_Skin_TransStrength,
	in float In_Skin_TransPower,
	in float In_Skin_PrimaryRoughnessScale,
	in float In_Skin_SecondaryRoughnessScale,
	in float In_Skin_SecondaryRampOffset,
	in float In_Skin_OverallSpecIntensity,
	in float In_Skin_PrimaryLobeIntensity,
	in float In_Skin_SecondaryLobeIntensity,
	in float In_Skin_SpecShadowStrength,
	in float In_Skin_WarmTintStrength,
	in float3 In_Stockings_BodyColor,
	in float In_Stockings_Density,
	in float In_Stockings_FresnelPower,
	in float In_Stockings_TransStrength,
	in float In_Stockings_RoughnessScale,
	in float In_Stockings_SpecIntensity,
	in float In_Stockings_ShadowStrength,
	in float In_Stockings_GrazingDarken,
	in float In_Stockings_GrazingSpecBoost,
	in float In_Eye_DiffuseWrapStrength,
	in float In_Eye_LimbalDarkenStrength,
	in float In_Eye_PrimaryIntensity,
	in float In_Eye_PrimaryRoughnessScale,
	in float In_Eye_SecondaryIntensity,
	in float In_Eye_SecondaryRampOffset,
	in float In_Eye_SecondaryRoughnessScale,
	in float In_Eye_SpecularShadowStrength,
	in float3 In_Eye_EyeTintRGB,
	in float In_ClothVelvet_DiffuseWrapStrength,
	in float In_ClothVelvet_GrazingDarkenStrength,
	in float In_ClothVelvet_RetroDiffuseStrength,
	in float In_ClothVelvet_RimBias,
	in float In_ClothVelvet_RoughnessScale,
	in float In_ClothVelvet_SheenIntensity,
	in float In_ClothVelvet_SheenPower,
	in float In_ClothVelvet_SheenShadowStrength,
	in float3 In_ClothVelvet_SheenTintRGB,
	in float In_ToonMetal_DiffuseIntensity,
	in float In_ToonMetal_EdgeBoost,
	in float In_ToonMetal_RampOffset,
	in float In_ToonMetal_Reserved,
	in float In_ToonMetal_RoughnessScale,
	in float In_ToonMetal_ShadowSpecularFloor,
	in float In_ToonMetal_SpecularContrast,
	in float In_ToonMetal_SpecularIntensity,
	in float3 In_ToonMetal_MetalTintRGB,
	in float In_ToonEmissiveInk_EdgeBoost,
	in float In_ToonEmissiveInk_InkBlend,
	in float In_ToonEmissiveInk_InkDarkenStrength,
	in float In_ToonEmissiveInk_LightInfluence,
	in float In_ToonEmissiveInk_RimBias,
	in float In_ToonEmissiveInk_RoughnessScale,
	in float In_ToonEmissiveInk_ShadowLift,
	in float In_ToonEmissiveInk_SpecularIntensity,
	in float3 In_ToonEmissiveInk_InkTintRGB,
	out float4 TBufferA, out float4 TBufferB, out float4 TBufferC, out float4 DebugColor)
{
	FToonBuffer TBuffer = (FToonBuffer)0;
	InitToonBuffer(TBuffer);

	DebugColor = float4(0, 0, 0, 1);
	TBuffer.ShadingFeatureID = ShadingFeatureID;

	if (ShadingFeatureID == MOON_SHADING_FEATURE_ID_SKIN)
	{
		if (DMask >= 0.5)
		{
			TBuffer.ShadingFeatureID = MOON_SHADING_FEATURE_ID_SKIN;
		}
		else
		{
			TBuffer.ShadingFeatureID = SecondaryShadingFeatureID;
		}
	}

	if (TBuffer.ShadingFeatureID == MOON_SHADING_FEATURE_ID_HAIR_HIGHLIGHT_MASK)
	{
		TBuffer.FeatureInputScalarA = In_HairMask_Mask;
		TBuffer.FeatureInputScalarB = In_HairMask_Intensity;
		TBuffer.FeatureInputScalarC = In_HairMask_ShadowIntensity;
		DebugColor = float4(In_HairMask_Mask, 0, 0, 1.f);
	}
	else if (TBuffer.ShadingFeatureID == MOON_SHADING_FEATURE_ID_KAJIYA_HAIR_SPECULAR)
	{
		TBuffer.FeatureInputScalarA = In_Kajiya_TangentRotate;
		TBuffer.FeatureInputScalarB = In_Kajiya_SecondaryShift;
		TBuffer.FeatureInputScalarC = In_Kajiya_SecondaryMask;
		TBuffer.FeatureInputScalarD = In_Kajiya_PrimaryShift;
		TBuffer.FeatureInputScalarE = In_Kajiya_PrimaryExpScale;
		TBuffer.FeatureInputScalarF = In_Kajiya_SecondaryExpScale;
		TBuffer.FeatureInputScalarG = In_Kajiya_OverallIntensity;
		TBuffer.FeatureInputVector.x = In_Kajiya_PrimaryIntensity;
		TBuffer.FeatureInputVector.y = In_Kajiya_SecondaryIntensity;
		TBuffer.FeatureInputVector.z = In_Kajiya_SecondaryShiftScale;
		TBuffer.FeatureInputVector.w = In_Kajiya_ShadowStrength;
		DebugColor = float4(0.f, 1, 0, 1.f);
	}
	else if (TBuffer.ShadingFeatureID == MOON_SHADING_FEATURE_ID_TOON_KAJIYA_HAIR_SPECULAR)
	{
		TBuffer.FeatureInputScalarA = In_ToonKajiya_TangentRotate;
		TBuffer.FeatureInputScalarB = In_ToonKajiya_SecondaryStrandShift;
		TBuffer.FeatureInputScalarC = In_ToonKajiya_SecondaryMask;
		TBuffer.FeatureInputScalarD = In_ToonKajiya_PrimaryStrandShift;
		TBuffer.FeatureInputScalarE = In_ToonKajiya_PrimaryExpScale;
		TBuffer.FeatureInputScalarF = In_ToonKajiya_SecondaryExpScale;
		TBuffer.FeatureInputScalarG = In_ToonKajiya_OverallIntensity;
		TBuffer.FeatureInputVector.x = In_ToonKajiya_PrimaryIntensity;
		TBuffer.FeatureInputVector.y = In_ToonKajiya_SecondaryIntensity;
		TBuffer.FeatureInputVector.z = In_ToonKajiya_SecondaryShiftScale;
		TBuffer.FeatureInputVector.w = In_ToonKajiya_ShadowStrength;
		DebugColor = float4(0.f, 0, 1, 1.f);
	}
	else if (TBuffer.ShadingFeatureID == MOON_SHADING_FEATURE_ID_SKIN)
	{
		TBuffer.FeatureInputScalarA = In_Skin_ScatterStrength;
		TBuffer.FeatureInputScalarB = In_Skin_TransStrength;
		TBuffer.FeatureInputScalarC = In_Skin_TransPower;
		TBuffer.FeatureInputScalarD = In_Skin_PrimaryRoughnessScale;
		TBuffer.FeatureInputScalarE = In_Skin_SecondaryRoughnessScale;
		TBuffer.FeatureInputScalarF = In_Skin_SecondaryRampOffset;
		TBuffer.FeatureInputScalarG = In_Skin_OverallSpecIntensity;
		TBuffer.FeatureInputVector.x = In_Skin_PrimaryLobeIntensity;
		TBuffer.FeatureInputVector.y = In_Skin_SecondaryLobeIntensity;
		TBuffer.FeatureInputVector.z = In_Skin_SpecShadowStrength;
		TBuffer.FeatureInputVector.w = In_Skin_WarmTintStrength;
		DebugColor = float4(1.f, 1, 0, 1.f);
	}
	else if (TBuffer.ShadingFeatureID == MOON_SHADING_FEATURE_ID_PBR_STOCKINGS)
	{
		TBuffer.FeatureInputScalarA = In_Stockings_Density;
		TBuffer.FeatureInputScalarB = In_Stockings_FresnelPower;
		TBuffer.FeatureInputScalarC = In_Stockings_TransStrength;
		TBuffer.FeatureInputScalarD = In_Stockings_RoughnessScale;
		TBuffer.FeatureInputScalarE = In_Stockings_SpecIntensity;
		TBuffer.FeatureInputScalarF = In_Stockings_ShadowStrength;
		TBuffer.FeatureInputScalarG = In_Stockings_GrazingDarken;
		TBuffer.FeatureInputVector.xyz = In_Stockings_BodyColor;
		TBuffer.FeatureInputVector.w = In_Stockings_GrazingSpecBoost;
		DebugColor = float4(1.f, 0, 1, 1.f);
	}
	else if (TBuffer.ShadingFeatureID == MOON_SHADING_FEATURE_ID_EYE)
	{
		TBuffer.FeatureInputScalarA = In_Eye_DiffuseWrapStrength;
		TBuffer.FeatureInputScalarB = In_Eye_LimbalDarkenStrength;
		TBuffer.FeatureInputScalarC = In_Eye_SpecularShadowStrength;
		TBuffer.FeatureInputScalarD = In_Eye_PrimaryRoughnessScale;
		TBuffer.FeatureInputScalarE = In_Eye_SecondaryRoughnessScale;
		TBuffer.FeatureInputScalarF = In_Eye_PrimaryIntensity;
		TBuffer.FeatureInputScalarG = In_Eye_SecondaryIntensity;
		TBuffer.FeatureInputVector.xyz = In_Eye_EyeTintRGB;
		TBuffer.FeatureInputVector.w = In_Eye_SecondaryRampOffset;
		DebugColor = float4(0.f, 1, 1, 1.f);
	}
	else if (TBuffer.ShadingFeatureID == MOON_SHADING_FEATURE_ID_CLOTH_VELVET)
	{
		TBuffer.FeatureInputScalarA = In_ClothVelvet_DiffuseWrapStrength;
		TBuffer.FeatureInputScalarB = In_ClothVelvet_SheenPower;
		TBuffer.FeatureInputScalarC = In_ClothVelvet_SheenShadowStrength;
		TBuffer.FeatureInputScalarD = In_ClothVelvet_RoughnessScale;
		TBuffer.FeatureInputScalarE = In_ClothVelvet_SheenIntensity;
		TBuffer.FeatureInputScalarF = In_ClothVelvet_RetroDiffuseStrength;
		TBuffer.FeatureInputScalarG = In_ClothVelvet_GrazingDarkenStrength;
		TBuffer.FeatureInputVector.xyz = In_ClothVelvet_SheenTintRGB;
		TBuffer.FeatureInputVector.w = In_ClothVelvet_RimBias;
		DebugColor = float4(.5f, 1, .5, 1.f);
	}
	else if (TBuffer.ShadingFeatureID == MOON_SHADING_FEATURE_ID_TOON_METAL)
	{
		TBuffer.FeatureInputScalarA = In_ToonMetal_DiffuseIntensity;
		TBuffer.FeatureInputScalarB = In_ToonMetal_ShadowSpecularFloor;
		TBuffer.FeatureInputScalarC = In_ToonMetal_RampOffset;
		TBuffer.FeatureInputScalarD = In_ToonMetal_RoughnessScale;
		TBuffer.FeatureInputScalarE = In_ToonMetal_SpecularIntensity;
		TBuffer.FeatureInputScalarF = In_ToonMetal_EdgeBoost;
		TBuffer.FeatureInputScalarG = In_ToonMetal_SpecularContrast;
		TBuffer.FeatureInputVector.xyz = In_ToonMetal_MetalTintRGB;
		TBuffer.FeatureInputVector.w = In_ToonMetal_Reserved;
		DebugColor = float4(1.f, 0.5, 0.5, 1.f);
	}
	else if (TBuffer.ShadingFeatureID == MOON_SHADING_FEATURE_ID_TOON_EMISSIVE_INK)
	{
		TBuffer.FeatureInputScalarA = In_ToonEmissiveInk_LightInfluence;
		TBuffer.FeatureInputScalarB = In_ToonEmissiveInk_ShadowLift;
		TBuffer.FeatureInputScalarC = In_ToonEmissiveInk_InkDarkenStrength;
		TBuffer.FeatureInputScalarD = In_ToonEmissiveInk_RoughnessScale;
		TBuffer.FeatureInputScalarE = In_ToonEmissiveInk_SpecularIntensity;
		TBuffer.FeatureInputScalarF = In_ToonEmissiveInk_EdgeBoost;
		TBuffer.FeatureInputScalarG = In_ToonEmissiveInk_InkBlend;
		TBuffer.FeatureInputVector.xyz = In_ToonEmissiveInk_InkTintRGB;
		TBuffer.FeatureInputVector.w = In_ToonEmissiveInk_RimBias;
		DebugColor = float4(.5f, .5, 1, 1.f);
	}

	EncodeToonBuffer(TBuffer, TBufferA, TBufferB, TBufferC);
}

ShaderFunction(Name="MaterialFunctions/MF_MoonToonBuffer", Root="Plugin.MoonToon")
{
	Settings = {
		Description       = "Packs the MoonToon shading inputs into ToonBufferA/B/C.";
		ExposeToLibrary   = true;
		LibraryCategories = "MoonToon";
	}

	Inputs = {
		opt float ShadingFeatureID = 0.0 [Description="MOON_SHADING_FEATURE_ID_*. Selects the toon feature branch."];
		opt float SecondaryShadingFeatureID = 0.0 [Description="Feature used when DMask < 0.5 on the Skin branch."];
		opt float DMask = 1.0 [Description="Skin dual-feature mask. >= 0.5 keeps ShadingFeatureID. Defaults to 1.0 to match the old white-texture default."];
		opt float InHighlightMask = 0.0 [Description="Hair highlight mask."];
		opt float InToonKajiyaKay_PrimaryStrandShift = 0.0 [Description="Toon Kajiya primary strand shift."];
		opt float InToonKajiyaKay_SecondaryStrandShift = 0.0 [Description="Toon Kajiya secondary strand shift."];
		opt float3 InToonStockings_BodyColor = float3(0.0, 0.0, 0.0) [Description="Stockings body colour."];
	}

	Outputs = {
		float4 ToonBufferA;
		float4 ToonBufferB;
		float4 ToonBufferC;
		float4 ResultShadingFeatureColor;
	}

	Properties = {

		ScalarParameter In_ClothVelvet_DiffuseWrapStrength = 0.0 [Group="39 - Feature: Cloth Velvet"; SortPriority=0; SliderMin=0; SliderMax=1; Description="布料漫反射的 wrap 强度. 取值 0~1, 默认 0.0.\r\nWrap of the cloth's diffuse. Range 0 to 1, default 0.0."];
		ScalarParameter In_ClothVelvet_GrazingDarkenStrength = 0.0 [Group="39 - Feature: Cloth Velvet"; SortPriority=6; SliderMin=0; SliderMax=1; Description="掠射角变暗强度. 取值 0~1, 默认 0.0.\r\nGrazing-angle darkening. Range 0 to 1, default 0.0."];
		ScalarParameter In_ClothVelvet_RetroDiffuseStrength = 0.0 [Group="39 - Feature: Cloth Velvet"; SortPriority=5; SliderMin=0; SliderMax=1; Description="逆反射强度 —— 光从相机方向来时的额外提亮, 天鹅绒的典型特征. 取值 0~1, 默认 0.0.\r\nRetro-reflection: extra brightening when the light comes from the camera, typical of velvet. Range 0 to 1, default 0.0."];
		ScalarParameter In_ClothVelvet_RimBias = 0.0 [Group="39 - Feature: Cloth Velvet"; SortPriority=8; SliderMin=0; SliderMax=1; Description="绒光在背光面的保底值. 0 = 背光面没有绒光. 取值 0~1, 默认 0.0.\r\nSheen floor on the side away from the light. 0 = no sheen there. Range 0 to 1, default 0.0."];
		ScalarParameter In_ClothVelvet_RoughnessScale = 1.0 [Group="39 - Feature: Cloth Velvet"; SortPriority=3; SliderMin=0; SliderMax=1; Description="高光粗糙度倍数. 取值 0~1, 默认 1.0.\r\nHighlight roughness multiplier. Range 0 to 1, default 1.0."];
		ScalarParameter In_ClothVelvet_SheenIntensity = 0.0 [Group="39 - Feature: Cloth Velvet"; SortPriority=4; SliderMin=0; SliderMax=1; Description="绒光强度. 0 = 没有绒感. 取值 0~1, 默认 0.0.\r\nSheen strength. 0 = no velvet look. Range 0 to 1, default 0.0."];
		ScalarParameter In_ClothVelvet_SheenPower = 0.0 [Group="39 - Feature: Cloth Velvet"; SortPriority=1; SliderMin=0; SliderMax=15.9; Description="绒光的幂次. 越大, 绒光越集中在轮廓边缘. 取值 0~15.9, 默认 0.0.\r\nSheen power. Larger keeps the sheen closer to the silhouette. Range 0 to 15.9, default 0.0."];
		ScalarParameter In_ClothVelvet_SheenShadowStrength = 0.0 [Group="39 - Feature: Cloth Velvet"; SortPriority=2; SliderMin=0; SliderMax=1; Description="绒光受阴影影响的程度. 取值 0~1, 默认 0.0.\r\nHow much shadow dims the sheen. Range 0 to 1, default 0.0."];

		ScalarParameter In_Eye_DiffuseWrapStrength = 0.0 [Group="22 - Eye|Shading"; SortPriority=0; SliderMin=0; SliderMax=1; Description="眼球漫反射的 wrap 强度, 让受光过渡更柔和. 取值 0~1, 默认 0.0.\r\nWrap of the eye's diffuse, for a softer light falloff. Range 0 to 1, default 0.0."];
		ScalarParameter In_Eye_LimbalDarkenStrength = 0.0 [Group="22 - Eye|Shading"; SortPriority=1; SliderMin=0; SliderMax=1; Description="角膜缘变暗强度 —— 视角越偏, 眼球边缘越深. 取值 0~1, 默认 0.0.\r\nLimbal darkening: the eye's edge deepens as the view turns away. Range 0 to 1, default 0.0."];
		ScalarParameter In_Eye_PrimaryIntensity = 0.0 [Group="22 - Eye|Shading"; SortPriority=5; SliderMin=0; SliderMax=1; Description="主高光强度. 取值 0~1, 默认 0.0.\r\nPrimary highlight strength. Range 0 to 1, default 0.0."];
		ScalarParameter In_Eye_PrimaryRoughnessScale = 1.0 [Group="22 - Eye|Shading"; SortPriority=3; SliderMin=0; SliderMax=1; Description="主高光(小而锐的那点)粗糙度倍数. 取值 0~1, 默认 1.0.\r\nRoughness multiplier of the primary highlight (the small sharp one). Range 0 to 1, default 1.0."];
		ScalarParameter In_Eye_SecondaryIntensity = 0.0 [Group="22 - Eye|Shading"; SortPriority=6; SliderMin=0; SliderMax=1; Description="次高光强度. 取值 0~1, 默认 0.0.\r\nSecondary highlight strength. Range 0 to 1, default 0.0."];
		ScalarParameter In_Eye_SecondaryRampOffset = 0.0 [Group="22 - Eye|Shading"; SortPriority=8; SliderMin=0; SliderMax=1; Description="次高光在 Specular Ramp 上的横向偏移. 取值 0~1, 默认 0.0.\r\nHorizontal offset of the secondary highlight on the Specular Ramp. Range 0 to 1, default 0.0."];
		ScalarParameter In_Eye_SecondaryRoughnessScale = 1.0 [Group="22 - Eye|Shading"; SortPriority=4; SliderMin=0; SliderMax=1; Description="次高光(大而柔的那片)粗糙度倍数. 取值 0~1, 默认 1.0.\r\nRoughness multiplier of the secondary highlight (the large soft one). Range 0 to 1, default 1.0."];
		ScalarParameter In_Eye_SpecularShadowStrength = 0.0 [Group="22 - Eye|Shading"; SortPriority=2; SliderMin=0; SliderMax=1; Description="高光受阴影影响的程度. 取值 0~1, 默认 0.0.\r\nHow much shadow dims the highlight. Range 0 to 1, default 0.0."];

		ScalarParameter In_Hair_HighlightMask = 0.0 [Group="35 - Feature: Hair Highlight Mask"; SortPriority=0; SliderMin=0; SliderMax=1; Description="天使环遮罩, 一般由发丝高光贴图驱动. 逐像素输入会与这个常量相加. 取值 0~1, 默认 0.0.\r\nAngel ring mask, usually driven by the hair highlight texture; the per-pixel input is added to this constant. Range 0 to 1, default 0.0."];
		ScalarParameter In_Hair_HighlightMaskIntensity = 0.0 [Group="35 - Feature: Hair Highlight Mask"; SortPriority=1; SliderMin=0; SliderMax=1; Description="天使环强度. 0 = 关闭. 取值 0~1, 默认 0.0.\r\nAngel ring strength. 0 = off. Range 0 to 1, default 0.0."];
		ScalarParameter In_Hair_HighlightMaskShadowIntensity = 0.0 [Group="35 - Feature: Hair Highlight Mask"; SortPriority=2; SliderMin=0; SliderMax=1; Description="天使环在阴影中保留多少. 0 = 阴影里完全消失, 1 = 不受阴影影响. 取值 0~1, 默认 0.0.\r\nHow much of the ring survives in shadow. 0 = gone in shadow, 1 = unaffected. Range 0 to 1, default 0.0."];

		ScalarParameter In_Hair_OverallSpecIntensity = 0.0 [Group="33 - Feature: Hair Kajiya"; SortPriority=6; SliderMin=0; SliderMax=1; Description="两道高光的总强度. 0 = 关闭整个 Kajiya 高光. 取值 0~1, 默认 0.0.\r\nOverall strength of both highlights. 0 turns the Kajiya highlight off. Range 0 to 1, default 0.0."];
		ScalarParameter In_Hair_PrimaryExpScale = 1.0 [Group="33 - Feature: Hair Kajiya"; SortPriority=4; SliderMin=0; SliderMax=7.9; Description="主高光锐度倍数. 大于 1 更锐, 小于 1 更散. 取值 0~7.9, 默认 1.0.\r\nSharpness multiplier of the primary highlight. Above 1 sharper, below 1 broader. Range 0 to 7.9, default 1.0."];
		ScalarParameter In_Hair_PrimaryIntensity = 0.0 [Group="33 - Feature: Hair Kajiya"; SortPriority=7; SliderMin=0; SliderMax=1; Description="主高光强度. 取值 0~1, 默认 0.0.\r\nPrimary highlight strength. Range 0 to 1, default 0.0."];
		ScalarParameter In_Hair_PrimaryShift = 0.0 [Group="33 - Feature: Hair Kajiya"; SortPriority=3; SliderMin=-1; SliderMax=0.99; Description="主高光(靠近发根的那道)沿法线的偏移. 正值上移, 负值下移. 取值 -1~0.99, 默认 0.0.\r\nShifts the primary highlight (the one nearer the root) along the normal. Positive moves it up, negative down. Range -1 to 0.99, default 0.0."];
		ScalarParameter In_Hair_SecondaryExpScale = 1.0 [Group="33 - Feature: Hair Kajiya"; SortPriority=5; SliderMin=0; SliderMax=7.9; Description="次高光锐度倍数. 取值 0~7.9, 默认 1.0.\r\nSharpness multiplier of the secondary highlight. Range 0 to 7.9, default 1.0."];
		ScalarParameter In_Hair_SecondaryIntensity = 0.0 [Group="33 - Feature: Hair Kajiya"; SortPriority=8; SliderMin=0; SliderMax=1; Description="次高光强度. 取值 0~1, 默认 0.0.\r\nSecondary highlight strength. Range 0 to 1, default 0.0."];
		ScalarParameter In_Hair_SecondaryMask = 0.0 [Group="33 - Feature: Hair Kajiya"; SortPriority=2; SliderMin=0; SliderMax=1; Description="次高光的遮罩, 0~1. 通常由发丝遮罩贴图驱动. 取值 0~1, 默认 0.0.\r\nMask for the secondary highlight, usually driven by a strand mask texture. Range 0 to 1, default 0.0."];
		ScalarParameter In_Hair_SecondaryShift = 0.0 [Group="33 - Feature: Hair Kajiya"; SortPriority=1; SliderMin=-1; SliderMax=0.99; Description="次高光(靠近发梢的那道)沿法线的偏移. 取值 -1~0.99, 默认 0.0.\r\nShifts the secondary highlight (the one nearer the tip) along the normal. Range -1 to 0.99, default 0.0."];
		ScalarParameter In_Hair_SecondaryShiftScale = 1.0 [Group="33 - Feature: Hair Kajiya"; SortPriority=9; SliderMin=0; SliderMax=1; Description="次高光偏移的额外缩放, 用来拉开两道高光的间距. 取值 0~1, 默认 1.0.\r\nExtra scale on the secondary shift, to set the two highlights apart. Range 0 to 1, default 1.0."];
		ScalarParameter In_Hair_ShadowStrength = 0.0 [Group="33 - Feature: Hair Kajiya"; SortPriority=10; SliderMin=0; SliderMax=1; Description="高光受阴影影响的程度. 0 = 阴影里也保持全亮, 1 = 完全跟随阴影. 取值 0~1, 默认 0.0.\r\nHow much shadow dims the highlight. 0 = full strength in shadow, 1 = follows the shadow fully. Range 0 to 1, default 0.0."];
		ScalarParameter In_Hair_TangentRotate = 0.0 [Group="33 - Feature: Hair Kajiya"; SortPriority=0; SliderMin=-1; SliderMax=0.99; Description="发丝切线绕法线旋转, 单位为 PI 弧度. 仅在材质没有各向异性方向时生效. 取值 -1~0.99, 默认 0.0.\r\nRotates the strand tangent about the normal, in units of PI radians. Only when the material gives no anisotropy direction. Range -1 to 0.99, default 0.0."];

		ScalarParameter In_Skin_OverallSpecIntensity = 0.0 [Group="37 - Feature: Skin"; SortPriority=6; SliderMin=0; SliderMax=1; Description="两道高光的总强度. 0 = 没有高光. 取值 0~1, 默认 0.0.\r\nOverall strength of both highlights. 0 = no highlight. Range 0 to 1, default 0.0."];
		ScalarParameter In_Skin_PrimaryLobeIntensity = 0.0 [Group="37 - Feature: Skin"; SortPriority=7; SliderMin=0; SliderMax=1; Description="主高光瓣强度. 取值 0~1, 默认 0.0.\r\nPrimary lobe strength. Range 0 to 1, default 0.0."];
		ScalarParameter In_Skin_PrimaryRoughnessScale = 1.0 [Group="37 - Feature: Skin"; SortPriority=3; SliderMin=0; SliderMax=1; Description="主高光粗糙度倍数. 小于 1 让高光更小更锐. 取值 0~1, 默认 1.0.\r\nRoughness multiplier of the primary highlight. Below 1 makes it smaller and sharper. Range 0 to 1, default 1.0."];
		ScalarParameter In_Skin_ScatterStrength = 0.0 [Group="37 - Feature: Skin"; SortPriority=0; SliderMin=0; SliderMax=1; Description="次表面散射强度. 会把明暗交界线向暗部推, 让皮肤过渡更软. 取值 0~1, 默认 0.0.\r\nSubsurface scattering strength. Pushes the terminator into the dark side so skin transitions softly. Range 0 to 1, default 0.0."];
		ScalarParameter In_Skin_SecondaryLobeIntensity = 0.0 [Group="37 - Feature: Skin"; SortPriority=8; SliderMin=0; SliderMax=1; Description="次高光瓣强度. 取值 0~1, 默认 0.0.\r\nSecondary lobe strength. Range 0 to 1, default 0.0."];
		ScalarParameter In_Skin_SecondaryRampOffset = 0.0 [Group="37 - Feature: Skin"; SortPriority=5; SliderMin=0; SliderMax=1; Description="次高光在 Specular Ramp 上的横向偏移. 取值 0~1, 默认 0.0.\r\nHorizontal offset of the secondary highlight on the Specular Ramp. Range 0 to 1, default 0.0."];
		ScalarParameter In_Skin_SecondaryRoughnessScale = 1.0 [Group="37 - Feature: Skin"; SortPriority=4; SliderMin=0; SliderMax=1; Description="次高光粗糙度倍数, 通常比主高光大, 做出油光的外圈. 取值 0~1, 默认 1.0.\r\nRoughness multiplier of the secondary highlight; usually larger than the primary, for an oily outer halo. Range 0 to 1, default 1.0."];
		ScalarParameter In_Skin_SpecShadowStrength = 0.0 [Group="37 - Feature: Skin"; SortPriority=9; SliderMin=0; SliderMax=1; Description="高光受阴影影响的程度. 取值 0~1, 默认 0.0.\r\nHow much shadow dims the highlight. Range 0 to 1, default 0.0."];
		ScalarParameter In_Skin_TransPower = 0.0 [Group="37 - Feature: Skin"; SortPriority=2; SliderMin=0; SliderMax=1; Description="背光透射的范围. 越大越宽: 0 = 只在正背光方向很窄的一圈, 1 = 侧逆光也透. 取值 0~1, 默认 0.0.\r\nWidth of the back-light transmission. Larger is broader: 0 = a narrow ring straight against the light, 1 = side back light shows through too. Range 0 to 1, default 0.0."];
		ScalarParameter In_Skin_TransStrength = 0.0 [Group="37 - Feature: Skin"; SortPriority=1; SliderMin=0; SliderMax=1; Description="背光透射强度(耳朵、鼻翼的透光). 取值 0~1, 默认 0.0.\r\nBack-light transmission strength (light through ears and nostrils). Range 0 to 1, default 0.0."];
		ScalarParameter In_Skin_WarmTintStrength = 0.0 [Group="37 - Feature: Skin"; SortPriority=10; SliderMin=0; SliderMax=1; Description="散射的暖色偏移强度. 越大散射越偏红. 取值 0~1, 默认 0.0.\r\nWarm hue shift of the scattering. Larger reads redder. Range 0 to 1, default 0.0."];

		ScalarParameter In_Stockings_Density = 0.0 [Group="38 - Feature: Stockings"; SortPriority=104; SliderMin=0; SliderMax=1; Description="(旧版写入) 丝袜遮蔽率. \r\n(Legacy writer) stocking coverage."];
		ScalarParameter In_Stockings_FresnelPower = 0.0 [Group="38 - Feature: Stockings"; SortPriority=1; SliderMin=0; SliderMax=15.9; Description="掠射角衰减的幂次. 越大, 变暗只发生在更接近边缘的地方. 取值 0~15.9, 默认 0.0.\r\nPower of the grazing-angle darkening. Larger keeps the darkening closer to the silhouette. Range 0 to 15.9, default 0.0."];
		ScalarParameter In_Stockings_GrazingDarken = 0.0 [Group="38 - Feature: Stockings"; SortPriority=6; SliderMin=0; SliderMax=1; Description="掠射角变暗强度, 做出丝袜边缘收深的效果. 取值 0~1, 默认 0.0.\r\nGrazing-angle darkening, for the deeper edge of a stocking. Range 0 to 1, default 0.0."];
		ScalarParameter In_Stockings_GrazingSpecBoost = 0.0 [Group="38 - Feature: Stockings"; SortPriority=8; SliderMin=0; SliderMax=1; Description="掠射角高光增益, 做出边缘的一圈亮光. 取值 0~1, 默认 0.0.\r\nGrazing-angle highlight boost, for a bright rim along the edge. Range 0 to 1, default 0.0."];
		ScalarParameter In_Stockings_RoughnessScale = 1.0 [Group="38 - Feature: Stockings"; SortPriority=105; SliderMin=0; SliderMax=4; Description="(旧版写入) 丝袜高光粗糙度倍数. \r\n(Legacy writer) stocking highlight roughness multiplier."];
		ScalarParameter In_Stockings_ShadowStrength = 0.0 [Group="38 - Feature: Stockings"; SortPriority=5; SliderMin=0; SliderMax=1; Description="漫反射受阴影影响的程度. 取值 0~1, 默认 0.0.\r\nHow much shadow dims the diffuse. Range 0 to 1, default 0.0."];
		ScalarParameter In_Stockings_SpecIntensity = 0.0 [Group="38 - Feature: Stockings"; SortPriority=4; SliderMin=0; SliderMax=1; Description="高光总强度. 取值 0~1, 默认 0.0.\r\nOverall highlight strength. Range 0 to 1, default 0.0."];
		ScalarParameter In_Stockings_TransStrength = 0.0 [Group="38 - Feature: Stockings"; SortPriority=2; SliderMin=0; SliderMax=1; Description="背光透射强度 —— 光从腿后面穿过丝袜到达眼睛的量. 取值 0~1, 默认 0.0.\r\nBack-light transmission: how much light from behind the leg reaches the eye through the stocking. Range 0 to 1, default 0.0."];

		ScalarParameter In_ToonEmissiveInk_EdgeBoost = 0.0 [Group="41 - Feature: Emissive Ink"; SortPriority=5; SliderMin=0; SliderMax=1; Description="掠射角高光增益. 取值 0~1, 默认 0.0.\r\nGrazing-angle highlight boost. Range 0 to 1, default 0.0."];
		ScalarParameter In_ToonEmissiveInk_InkBlend = 0.0 [Group="41 - Feature: Emissive Ink"; SortPriority=6; SliderMin=0; SliderMax=1; Description="墨色与材质 Base Color 的混合比. 0 = 完全用 Base Color, 1 = 完全用墨色. 取值 0~1, 默认 0.0.\r\nMix between Base Color and the ink colour. 0 = all Base Color, 1 = all ink. Range 0 to 1, default 0.0."];
		ScalarParameter In_ToonEmissiveInk_InkDarkenStrength = 0.0 [Group="41 - Feature: Emissive Ink"; SortPriority=2; SliderMin=0; SliderMax=1; Description="掠射角变暗强度, 做出墨色向边缘收深. 取值 0~1, 默认 0.0.\r\nGrazing-angle darkening, so the ink deepens towards the edge. Range 0 to 1, default 0.0."];
		ScalarParameter In_ToonEmissiveInk_LightInfluence = 0.0 [Group="41 - Feature: Emissive Ink"; SortPriority=0; SliderMin=0; SliderMax=1; Description="受光影响程度. 0 = 完全自发光不受光照, 1 = 正常受光. 取值 0~1, 默认 0.0.\r\nHow much lighting applies. 0 = pure emissive, 1 = lit normally. Range 0 to 1, default 0.0."];
		ScalarParameter In_ToonEmissiveInk_RimBias = 0.0 [Group="41 - Feature: Emissive Ink"; SortPriority=8; SliderMin=0; SliderMax=1; Description="边缘高光的菲涅尔偏置. 取值 0~1, 默认 0.0.\r\nFresnel bias of the edge highlight. Range 0 to 1, default 0.0."];
		ScalarParameter In_ToonEmissiveInk_RoughnessScale = 1.0 [Group="41 - Feature: Emissive Ink"; SortPriority=3; SliderMin=0; SliderMax=1; Description="高光粗糙度倍数. 取值 0~1, 默认 1.0.\r\nHighlight roughness multiplier. Range 0 to 1, default 1.0."];
		ScalarParameter In_ToonEmissiveInk_ShadowLift = 0.0 [Group="41 - Feature: Emissive Ink"; SortPriority=1; SliderMin=0; SliderMax=1; Description="阴影提亮 —— 阴影中保留多少亮度. 0 = 阴影全黑. 取值 0~1, 默认 0.0.\r\nShadow lift: how much brightness survives in shadow. 0 = black shadow. Range 0 to 1, default 0.0."];
		ScalarParameter In_ToonEmissiveInk_SpecularIntensity = 0.0 [Group="41 - Feature: Emissive Ink"; SortPriority=4; SliderMin=0; SliderMax=1; Description="高光总强度. 取值 0~1, 默认 0.0.\r\nOverall highlight strength. Range 0 to 1, default 0.0."];

		ScalarParameter In_ToonHair_OverallSpecIntensity = 0.0 [Group="34 - Feature: Hair Toon Kajiya"; SortPriority=6; SliderMin=0; SliderMax=1; Description="两道高光的总强度. 0 = 关闭整个 Kajiya 高光. 取值 0~1, 默认 0.0.\r\nOverall strength of both highlights. 0 turns the Kajiya highlight off. Range 0 to 1, default 0.0."];
		ScalarParameter In_ToonHair_PrimaryExpScale = 1.0 [Group="34 - Feature: Hair Toon Kajiya"; SortPriority=4; SliderMin=0; SliderMax=7.9; Description="主高光锐度倍数. 大于 1 更锐, 小于 1 更散. 取值 0~7.9, 默认 1.0.\r\nSharpness multiplier of the primary highlight. Above 1 sharper, below 1 broader. Range 0 to 7.9, default 1.0."];
		ScalarParameter In_ToonHair_PrimaryIntensity = 0.0 [Group="34 - Feature: Hair Toon Kajiya"; SortPriority=7; SliderMin=0; SliderMax=1; Description="主高光强度. 取值 0~1, 默认 0.0.\r\nPrimary highlight strength. Range 0 to 1, default 0.0."];
		ScalarParameter In_ToonHair_PrimaryStrandShift = 0.0 [Group="34 - Feature: Hair Toon Kajiya"; SortPriority=3; SliderMin=-1; SliderMax=0.99; Description="主高光(靠近发根的那道)沿法线的偏移. 正值上移, 负值下移. 取值 -1~0.99, 默认 0.0.\r\nShifts the primary highlight (the one nearer the root) along the normal. Positive moves it up, negative down. Range -1 to 0.99, default 0.0."];
		ScalarParameter In_ToonHair_SecondaryExpScale = 1.0 [Group="34 - Feature: Hair Toon Kajiya"; SortPriority=5; SliderMin=0; SliderMax=7.9; Description="次高光锐度倍数. 取值 0~7.9, 默认 1.0.\r\nSharpness multiplier of the secondary highlight. Range 0 to 7.9, default 1.0."];
		ScalarParameter In_ToonHair_SecondaryIntensity = 0.0 [Group="34 - Feature: Hair Toon Kajiya"; SortPriority=8; SliderMin=0; SliderMax=1; Description="次高光强度. 取值 0~1, 默认 0.0.\r\nSecondary highlight strength. Range 0 to 1, default 0.0."];
		ScalarParameter In_ToonHair_SecondaryMask = 0.0 [Group="34 - Feature: Hair Toon Kajiya"; SortPriority=2; SliderMin=0; SliderMax=1; Description="次高光的遮罩, 0~1. 通常由发丝遮罩贴图驱动. 取值 0~1, 默认 0.0.\r\nMask for the secondary highlight, usually driven by a strand mask texture. Range 0 to 1, default 0.0."];
		ScalarParameter In_ToonHair_SecondaryShift = 0.0 [Group="34 - Feature: Hair Toon Kajiya"; SortPriority=1; SliderMin=-1; SliderMax=0.99; Description="次高光(靠近发梢的那道)沿法线的偏移. 取值 -1~0.99, 默认 0.0.\r\nShifts the secondary highlight (the one nearer the tip) along the normal. Range -1 to 0.99, default 0.0."];
		ScalarParameter In_ToonHair_SecondaryShiftScale = 1.0 [Group="34 - Feature: Hair Toon Kajiya"; SortPriority=9; SliderMin=0; SliderMax=1; Description="次高光偏移的额外缩放, 用来拉开两道高光的间距. 取值 0~1, 默认 1.0.\r\nExtra scale on the secondary shift, to set the two highlights apart. Range 0 to 1, default 1.0."];
		ScalarParameter In_ToonHair_ShadowStrength = 0.0 [Group="34 - Feature: Hair Toon Kajiya"; SortPriority=10; SliderMin=0; SliderMax=1; Description="高光受阴影影响的程度. 0 = 阴影里也保持全亮, 1 = 完全跟随阴影. 取值 0~1, 默认 0.0.\r\nHow much shadow dims the highlight. 0 = full strength in shadow, 1 = follows the shadow fully. Range 0 to 1, default 0.0."];
		ScalarParameter In_ToonHair_TangentRotate = 0.0 [Group="34 - Feature: Hair Toon Kajiya"; SortPriority=0; SliderMin=-1; SliderMax=0.99; Description="发丝切线绕法线旋转, 单位为 PI 弧度. 仅在材质没有各向异性方向时生效. 取值 -1~0.99, 默认 0.0.\r\nRotates the strand tangent about the normal, in units of PI radians. Only when the material gives no anisotropy direction. Range -1 to 0.99, default 0.0."];

		ScalarParameter In_ToonMetal_DiffuseIntensity = 0.0 [Group="40 - Feature: Metal"; SortPriority=0; SliderMin=0; SliderMax=1; Description="金属漫反射强度. 金属通常很低. 取值 0~1, 默认 0.0.\r\nMetal diffuse strength; usually low for metal. Range 0 to 1, default 0.0."];
		ScalarParameter In_ToonMetal_EdgeBoost = 0.0 [Group="40 - Feature: Metal"; SortPriority=5; SliderMin=0; SliderMax=1; Description="掠射角高光增益, 做出金属边缘的亮边. 取值 0~1, 默认 0.0.\r\nGrazing-angle highlight boost, for the bright rim of metal. Range 0 to 1, default 0.0."];
		ScalarParameter In_ToonMetal_RampOffset = 0.0 [Group="40 - Feature: Metal"; SortPriority=2; SliderMin=-1; SliderMax=0.99; Description="高光在 Specular Ramp 上的横向偏移, 用来整体调亮或调暗. 取值 -1~0.99, 默认 0.0.\r\nHorizontal offset of the highlight on the Specular Ramp, to brighten or darken it as a whole. Range -1 to 0.99, default 0.0."];
		ScalarParameter In_ToonMetal_Reserved = 0.0 [Group="40 - Feature: Metal"; SortPriority=100; SliderMin=0; SliderMax=1; Description="(旧版写入) 保留, 不使用. \r\n(Legacy writer) reserved, unused."];
		ScalarParameter In_ToonMetal_RoughnessScale = 1.0 [Group="40 - Feature: Metal"; SortPriority=3; SliderMin=0; SliderMax=1; Description="高光粗糙度倍数. 取值 0~1, 默认 1.0.\r\nHighlight roughness multiplier. Range 0 to 1, default 1.0."];
		ScalarParameter In_ToonMetal_ShadowSpecularFloor = 0.0 [Group="40 - Feature: Metal"; SortPriority=1; SliderMin=0; SliderMax=1; Description="阴影中高光的保底值. 0 = 阴影里高光全灭. 取值 0~1, 默认 0.0.\r\nHighlight floor in shadow. 0 = the highlight vanishes in shadow. Range 0 to 1, default 0.0."];
		ScalarParameter In_ToonMetal_SpecularContrast = 1.0 [Group="40 - Feature: Metal"; SortPriority=6; SliderMin=1; SliderMax=16.9; Description="高光对比度(Ramp 的幂次). 越大高光越硬、越集中. 取值 1~16.9, 默认 1.0.\r\nHighlight contrast (a power on the ramp). Larger is harder and tighter. Range 1 to 16.9, default 1.0."];
		ScalarParameter In_ToonMetal_SpecularIntensity = 0.0 [Group="40 - Feature: Metal"; SortPriority=4; SliderMin=0; SliderMax=1; Description="高光总强度. 取值 0~1, 默认 0.0.\r\nOverall highlight strength. Range 0 to 1, default 0.0."];

		VectorParameter In_ClothVelvet_SheenTintRGB = float4(1.0, 1.0, 1.0, 1.0) [Group="39 - Feature: Cloth Velvet"; SortPriority=7; Description="绒光颜色.\r\nColour of the velvet sheen."];
		VectorParameter In_Eye_EyeTintRGB = float4(0.0, 0.0, 0.0, 0.0) [Group="22 - Eye|Shading"; SortPriority=7; Description="眼球染色. 全黑 = 未授权, 此时用材质的 Base Color.\r\nEye tint. Black = unset, then Base Color is used."];
		VectorParameter In_ToonEmissiveInk_InkTintRGB = float4(0.0, 0.0, 0.0, 0.0) [Group="41 - Feature: Emissive Ink"; SortPriority=7; Description="墨色.\r\nColour of the ink."];
		VectorParameter In_ToonMetal_MetalTintRGB = float4(1.0, 1.0, 1.0, 1.0) [Group="40 - Feature: Metal"; SortPriority=7; Description="金属高光染色.\r\nMetal highlight tint."];
	}

	Graph = {
		MoonToonBufferWrite(
			DMask,
			ShadingFeatureID,
			SecondaryShadingFeatureID,
			InHighlightMask,   // pin In_HairMask_Mask
			In_Hair_HighlightMaskIntensity,   // pin In_HairMask_Intensity
			In_Hair_HighlightMaskShadowIntensity,   // pin In_HairMask_ShadowIntensity
			In_Hair_TangentRotate,   // pin In_Kajiya_TangentRotate
			In_Hair_SecondaryShift,   // pin In_Kajiya_SecondaryShift
			In_Hair_SecondaryMask,   // pin In_Kajiya_SecondaryMask
			In_Hair_PrimaryShift,   // pin In_Kajiya_PrimaryShift
			In_Hair_PrimaryExpScale,   // pin In_Kajiya_PrimaryExpScale
			In_Hair_SecondaryExpScale,   // pin In_Kajiya_SecondaryExpScale
			In_Hair_OverallSpecIntensity,   // pin In_Kajiya_OverallIntensity
			In_Hair_PrimaryIntensity,   // pin In_Kajiya_PrimaryIntensity
			In_Hair_SecondaryIntensity,   // pin In_Kajiya_SecondaryIntensity
			In_Hair_SecondaryShiftScale,   // pin In_Kajiya_SecondaryShiftScale
			In_Hair_ShadowStrength,   // pin In_Kajiya_ShadowStrength
			In_ToonHair_TangentRotate,   // pin In_ToonKajiya_TangentRotate
			InToonKajiyaKay_SecondaryStrandShift + In_ToonHair_SecondaryShift,   // pin In_ToonKajiya_SecondaryStrandShift
			In_ToonHair_SecondaryMask,   // pin In_ToonKajiya_SecondaryMask
			InToonKajiyaKay_PrimaryStrandShift + In_ToonHair_PrimaryStrandShift,   // pin In_ToonKajiya_PrimaryStrandShift
			In_ToonHair_PrimaryExpScale,   // pin In_ToonKajiya_PrimaryExpScale
			In_ToonHair_SecondaryExpScale,   // pin In_ToonKajiya_SecondaryExpScale
			In_ToonHair_OverallSpecIntensity,   // pin In_ToonKajiya_OverallIntensity
			In_ToonHair_PrimaryIntensity,   // pin In_ToonKajiya_PrimaryIntensity
			In_ToonHair_SecondaryIntensity,   // pin In_ToonKajiya_SecondaryIntensity
			In_ToonHair_SecondaryShiftScale,   // pin In_ToonKajiya_SecondaryShiftScale
			In_ToonHair_ShadowStrength,   // pin In_ToonKajiya_ShadowStrength
			In_Skin_ScatterStrength,
			In_Skin_TransStrength,
			In_Skin_TransPower,
			In_Skin_PrimaryRoughnessScale,
			In_Skin_SecondaryRoughnessScale,
			In_Skin_SecondaryRampOffset,
			In_Skin_OverallSpecIntensity,
			In_Skin_PrimaryLobeIntensity,
			In_Skin_SecondaryLobeIntensity,
			In_Skin_SpecShadowStrength,
			In_Skin_WarmTintStrength,
			InToonStockings_BodyColor,   // pin In_Stockings_BodyColor
			In_Stockings_Density,
			In_Stockings_FresnelPower,
			In_Stockings_TransStrength,
			In_Stockings_RoughnessScale,
			In_Stockings_SpecIntensity,
			In_Stockings_ShadowStrength,
			In_Stockings_GrazingDarken,
			In_Stockings_GrazingSpecBoost,
			In_Eye_DiffuseWrapStrength,
			In_Eye_LimbalDarkenStrength,
			In_Eye_PrimaryIntensity,
			In_Eye_PrimaryRoughnessScale,
			In_Eye_SecondaryIntensity,
			In_Eye_SecondaryRampOffset,
			In_Eye_SecondaryRoughnessScale,
			In_Eye_SpecularShadowStrength,
			In_Eye_EyeTintRGB,
			In_ClothVelvet_DiffuseWrapStrength,
			In_ClothVelvet_GrazingDarkenStrength,
			In_ClothVelvet_RetroDiffuseStrength,
			In_ClothVelvet_RimBias,
			In_ClothVelvet_RoughnessScale,
			In_ClothVelvet_SheenIntensity,
			In_ClothVelvet_SheenPower,
			In_ClothVelvet_SheenShadowStrength,
			In_ClothVelvet_SheenTintRGB,
			In_ToonMetal_DiffuseIntensity,
			In_ToonMetal_EdgeBoost,
			In_ToonMetal_RampOffset,
			In_ToonMetal_Reserved,
			In_ToonMetal_RoughnessScale,
			In_ToonMetal_ShadowSpecularFloor,
			In_ToonMetal_SpecularContrast,
			In_ToonMetal_SpecularIntensity,
			In_ToonMetal_MetalTintRGB,
			In_ToonEmissiveInk_EdgeBoost,
			In_ToonEmissiveInk_InkBlend,
			In_ToonEmissiveInk_InkDarkenStrength,
			In_ToonEmissiveInk_LightInfluence,
			In_ToonEmissiveInk_RimBias,
			In_ToonEmissiveInk_RoughnessScale,
			In_ToonEmissiveInk_ShadowLift,
			In_ToonEmissiveInk_SpecularIntensity,
			In_ToonEmissiveInk_InkTintRGB,
			ToonBufferA, ToonBufferB, ToonBufferC, ResultShadingFeatureColor);
	}
}
