Function ToonModifierWrite_OilFilm(
	in float Intensity,
	in float HighlightScale,
	in float FalloffPower,
	in float HueShift,
	out float4 ModifierData)
{
	FToonBuffer TBuffer = (FToonBuffer)0;
	InitToonBuffer(TBuffer);

	TBuffer.ModifierInputVector.x = Intensity;
	TBuffer.ModifierInputVector.y = HighlightScale;
	TBuffer.ModifierInputVector.z = FalloffPower;
	TBuffer.ModifierInputVector.w = HueShift;

	ModifierData = TBuffer.ModifierInputVector;
}

