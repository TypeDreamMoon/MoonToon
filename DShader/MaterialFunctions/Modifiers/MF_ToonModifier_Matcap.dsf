// GENERATED from Engine/Shaders/Shared/MoonToonModifierSlots.h by Tools/gen_feature_functions.py.
// Edit the slot table (for the mapping) or the generator (for names/defaults), not this file.
//
// One modifier, one material function. A modifier is ADDITIVE on top of whatever shading feature the
// material selected, so unlike a feature it does not compete for the 30 group's single choice.

import "Shared/ToonFunctions.dsh";

Function ToonModifierWrite_Matcap(
	in float3 Color,
	in float LightingMix,
	out float4 ModifierData)
{
	FToonBuffer TBuffer = (FToonBuffer)0;
	InitToonBuffer(TBuffer);

	TBuffer.ModifierInputVector.xyz = Color;
	TBuffer.ModifierInputVector.w = LightingMix;

	ModifierData = TBuffer.ModifierInputVector;
}

ShaderFunction(Name="MaterialFunctions/Modifiers/MF_ToonModifier_Matcap", Root="Plugin.MoonToon")
{
	Settings = {
		Description       = "The Matcap modifier's channels, named after its slot table.";
		ExposeToLibrary   = true;
		LibraryCategories = "MoonToon|Modifiers";
	}

	Inputs = {
		opt float3 NormalTS = float3(0.0, 0.0, 1.0) [Description="Tangent-space normal, the same one the surface ends up shading with."];
	}

	Outputs = {
		// The legacy lane: the four channels packed into ToonFeatureRT4, reached through
		// MF_MoonToonModifierSelect. First, and staying first, because that selector reads OutputIndex 0.
		float4 ModifierData;
		// The Substrate lane: one output per slot, named as MoonToonModifierSlots.h names it -- which
		// is what UMaterialExpressionMoonToonModifier calls the matching pin for this Modifier.
		float3 Color;
		float LightingMix;
	}

	Graph = {
		float3 Slot_Color = MF_ToonMatcap(NormalTS, OutputIndex=0);
		float Slot_LightingMix = MF_ToonMatcap(NormalTS, OutputIndex=1);

		ToonModifierWrite_Matcap(
			Slot_Color,
			Slot_LightingMix,
			ModifierData);

		Color = Slot_Color;
		LightingMix = Slot_LightingMix;
	}
}
