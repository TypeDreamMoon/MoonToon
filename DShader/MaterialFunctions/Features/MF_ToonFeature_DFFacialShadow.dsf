Function ToonFeatureWrite_DFFacialShadow(
	in float ScatterStrength,
	in float TransmissionStrength,
	in float TransmissionPower,
	in float PrimaryRoughnessScale,
	in float SecondaryRoughnessScale,
	in float SecondaryRampOffset,
	in float OverallSpecIntensity,
	in float PrimaryLobeIntensity,
	in float SecondaryLobeIntensity,
	in float SpecShadowStrength,
	in float WarmTintStrength,
	out float4 TBufferA, out float4 TBufferB, out float4 TBufferC)
{
	FToonBuffer TBuffer = (FToonBuffer)0;
	InitToonBuffer(TBuffer);

	TBuffer.ShadingFeatureID = MOON_SHADING_FEATURE_ID_DISTANCE_FIELD_FACIAL_SHADOW;
	TBuffer.FeatureInputScalarA = ScatterStrength;
	TBuffer.FeatureInputScalarB = TransmissionStrength;
	TBuffer.FeatureInputScalarC = TransmissionPower;
	TBuffer.FeatureInputScalarD = PrimaryRoughnessScale;
	TBuffer.FeatureInputScalarE = SecondaryRoughnessScale;
	TBuffer.FeatureInputScalarF = SecondaryRampOffset;
	TBuffer.FeatureInputScalarG = OverallSpecIntensity;
	TBuffer.FeatureInputVector.x = PrimaryLobeIntensity;
	TBuffer.FeatureInputVector.y = SecondaryLobeIntensity;
	TBuffer.FeatureInputVector.z = SpecShadowStrength;
	TBuffer.FeatureInputVector.w = WarmTintStrength;

	EncodeToonBuffer(TBuffer, TBufferA, TBufferB, TBufferC);
}

