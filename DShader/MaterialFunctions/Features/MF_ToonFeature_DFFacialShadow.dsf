Function ToonFeatureWrite_DFFacialShadow(
	in float ScatterStrength,
	in float TransmissionStrength,
	in float TransmissionPower,
	in float PrimaryRoughnessScale,
	in float SecondaryRoughnessScale,
	in float SecondaryRampOffset,
	in float OverallSpecIntensity,
