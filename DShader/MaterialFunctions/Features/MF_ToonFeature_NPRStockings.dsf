// GENERATED from Engine/Shaders/Shared/MoonToonFeatureSlots.h by Tools/gen_feature_functions.py.
// Edit the slot table (for the mapping) or the generator (for names/defaults), not this file.
//
// One toon feature, one material function. It declares only its own slots, so a material instance
// that selected a different feature never shows these parameters -- that pruning is why feature
// selection had to become static.
//
// Two output lanes over ONE set of parameters:
//   * ToonBufferA/B/C -- the packed RGBA8 form the legacy (r.Substrate=0) toon prepass reads,
//     reached through MF_MoonToonFeatureSelect. Kept first so its OutputIndex 0/1/2 do not move.
//   * one output per SLOT, named as the slot table names it -- what M_MoonToon wires straight onto
//     the Substrate Moon toon closure's pins, which wear those same names. No packing, because a
//     Substrate value cannot come out of an HLSL Custom node and the packer is one.

import "Shared/ToonFunctions.dsh";

Function ToonFeatureWrite_NPRStockings(
	in float Density,
	in float FresnelPower,
	in float TransmissionStrength,
	in float TransmissionDistortion,
	in float SpecularIntensity,
	in float ShadowStrength,
	in float GrazingDarkenStrength,
	in float3 SkinColor,
	in float GrazingSpecBoost,
	out float4 TBufferA, out float4 TBufferB, out float4 TBufferC)
{
	FToonBuffer TBuffer = (FToonBuffer)0;
	InitToonBuffer(TBuffer);

	TBuffer.ShadingFeatureID = MOON_SHADING_FEATURE_ID_NPR_STOCKINGS;
	TBuffer.FeatureInputScalarA = Density;
	TBuffer.FeatureInputScalarB = FresnelPower;
	TBuffer.FeatureInputScalarC = TransmissionStrength;
	TBuffer.FeatureInputScalarD = TransmissionDistortion;
	TBuffer.FeatureInputScalarE = SpecularIntensity;
	TBuffer.FeatureInputScalarF = ShadowStrength;
	TBuffer.FeatureInputScalarG = GrazingDarkenStrength;
	TBuffer.FeatureInputVector.xyz = SkinColor;
	TBuffer.FeatureInputVector.w = GrazingSpecBoost;

	EncodeToonBuffer(TBuffer, TBufferA, TBufferB, TBufferC);
}

ShaderFunction(Name="MaterialFunctions/Features/MF_ToonFeature_NPRStockings", Root="Plugin.MoonToon")
{
	Settings = {
		Description       = "The NPRStockings toon feature's channels, named after its slot table.";
		ExposeToLibrary   = true;
		LibraryCategories = "MoonToon|Features";
	}

	Inputs = {
		opt float InThickness = 1.0 [Description="Per-pixel thickness multiplier from a map, applied to the denier value BEFORE the opacity curve. 1 = full denier, 0.5 = half."];
		opt float4 GlobalMaskA = float4(1.0, 1.0, 1.0, 1.0) [Description="The three packed mask maps the base input sampled, already resolved. Which one the weave mask reads is Stockings Sheen Mask Source."];
		opt float4 GlobalMaskB = float4(1.0, 1.0, 1.0, 1.0) [Description="Packed mask map 2."];
		opt float4 GlobalMaskC = float4(1.0, 1.0, 1.0, 1.0) [Description="Packed mask map 3."];
		opt float3 InSkinColor = float3(0.0, 0.0, 0.0) [Description="Per-pixel SkinColor from a map, added to the parameter."];
	}

	Outputs = {
		// The legacy lane: the same channels packed into the three RGBA8 ToonBuffer float4s the
		// r.Substrate=0 toon prepass splats into its full-screen targets. FIRST, and staying first,
		// because MF_MoonToonFeatureSelect reaches them by OutputIndex 0/1/2.
		float4 ToonBufferA;
		float4 ToonBufferB;
		float4 ToonBufferC;
		// The Substrate lane: one output per slot this feature's table declares, named exactly as the
		// table names it -- which is also what UMaterialExpressionSubstrateMoonToonBSDF /
		// UMaterialExpressionMoonToonFeature call the matching pin, so M_MoonToon can wire the closure
		// by name instead of by lane. Order is slot-table order.
		float Density;
		float FresnelPower;
		float TransmissionStrength;
		float TransmissionDistortion;
		float SpecularIntensity;
		float ShadowStrength;
		float GrazingDarkenStrength;
		float3 SkinColor;
		float GrazingSpecBoost;
	}

	Properties = {
		ScalarParameter In_Stockings_Denier = 30.0 [Group="38 - Feature: Stockings"; SortPriority=0; SliderMin=0; SliderMax=250; Description="丝袜旦数(D), 直接填现实规格: 10D 极薄, 20D 薄透, 30D 半透, 40~70D 半不透, 80~120D 不透, 250D 完全不透. 换算成遮蔽率走半衰期曲线 1-pow(0.5, D/35) —— 35D 是半透点, 每再加 35D 剩余透光减半, 所以数字可以一直往上加不需要上限. 0 = 没有丝袜. 旦数同时驱动三件事: 遮蔽率、透射量、以及高光锐度(薄的更亮更锐, 厚的更哑). 逐像素厚度贴图乘在旦数上 —— 膝盖脚跟被撑薄所以旦数低, 袜口和脚尖加固区旦数高. 取值 0~250, 默认 30.0.\r\nStocking denier, as on the packet: 10D very sheer, 30D semi-sheer, 80-120D opaque, 250D fully opaque. Coverage is 1-pow(0.5, D/35), so 35D is half coverage and every further 35D halves what gets through; 0 = no stocking. Denier drives coverage, transmission and highlight sharpness; the per-pixel thickness map multiplies it. Range 0 to 250, default 30.0."];
		ScalarParameter In_Stockings_FresnelPower = 0.0 [Group="38 - Feature: Stockings"; SortPriority=1; SliderMin=0; SliderMax=15.9; Description="掠射角衰减的幂次. 越大, 变暗只发生在更接近边缘的地方. 取值 0~15.9, 默认 0.0.\r\nPower of the grazing-angle darkening. Larger keeps the darkening closer to the silhouette. Range 0 to 15.9, default 0.0."];
		ScalarParameter In_Stockings_TransStrength = 0.0 [Group="38 - Feature: Stockings"; SortPriority=2; SliderMin=0; SliderMax=1; Description="背光透射强度 —— 光从腿后面穿过丝袜到达眼睛的量. 取值 0~1, 默认 0.0.\r\nBack-light transmission: how much light from behind the leg reaches the eye through the stocking. Range 0 to 1, default 0.0."];
		ScalarParameter In_Stockings_TransDistortion = 0.2 [Group="38 - Feature: Stockings"; SortPriority=3; SliderMin=0; SliderMax=1; Description="背光透射的法线扭曲量(DICE GDC 2011 的 Distortion). 0 = 只有光正对着镜头背面时才透光; 调大以后小腿侧面这种'夹角大、布料厚'的地方也会透出来, 通常 0.1~0.3. 取值 0~1, 默认 0.2.\r\nNormal distortion of the back-light transmission (DICE GDC 2011). 0 = only straight behind; larger lets the sides of the calf glow too, usually 0.1-0.3. Range 0 to 1, default 0.2."];
		ScalarParameter In_Stockings_SpecIntensity = 0.0 [Group="38 - Feature: Stockings"; SortPriority=4; SliderMin=0; SliderMax=1; Description="高光总强度. 取值 0~1, 默认 0.0.\r\nOverall highlight strength. Range 0 to 1, default 0.0."];
		ScalarParameter In_Stockings_ShadowStrength = 0.0 [Group="38 - Feature: Stockings"; SortPriority=5; SliderMin=0; SliderMax=1; Description="漫反射受阴影影响的程度. 取值 0~1, 默认 0.0.\r\nHow much shadow dims the diffuse. Range 0 to 1, default 0.0."];
		ScalarParameter In_Stockings_GrazingDarken = 0.0 [Group="38 - Feature: Stockings"; SortPriority=6; SliderMin=0; SliderMax=1; Description="掠射角变暗强度, 做出丝袜边缘收深的效果. 取值 0~1, 默认 0.0.\r\nGrazing-angle darkening, for the deeper edge of a stocking. Range 0 to 1, default 0.0."];
		VectorParameter In_Stockings_SkinColorRGB = float4(0.0, 0.0, 0.0, 0.0) [Group="38 - Feature: Stockings"; SortPriority=7; Description="透出来的皮肤颜色 —— 注意是腿, 不是丝袜. 丝袜自身的颜色用材质的 Base Color. 全黑 = 未授权, 此时回退成布料色(Density 的混合变成空操作, 但吸收/透射/高光照常).\r\nColour of the skin showing through (the leg, not the stocking; the stocking's colour is Base Color). Black = unset, then the cloth colour is used."];
		ScalarParameter In_Stockings_GrazingSpecBoost = 0.0 [Group="38 - Feature: Stockings"; SortPriority=8; SliderMin=0; SliderMax=1; Description="掠射角高光增益, 做出边缘的一圈亮光. 取值 0~1, 默认 0.0.\r\nGrazing-angle highlight boost, for a bright rim along the edge. Range 0 to 1, default 0.0."];
	}

	Graph = {
		// Sub-material table row (MF_ToonSubMaterial.dss): the generic feature channels.
		float SubMat_ID = MF_ToonSubMaterialID(Output="Result");
		float4 SubMat_C4 = MF_ToonSubMaterial(SubMat_ID, Output="C4");
		float4 SubMat_W4 = MF_ToonSubMaterial(SubMat_ID, Output="W4");
		float4 SubMat_C5 = MF_ToonSubMaterial(SubMat_ID, Output="C5");
		float4 SubMat_W5 = MF_ToonSubMaterial(SubMat_ID, Output="W5");
		float4 SubMat_C6 = MF_ToonSubMaterial(SubMat_ID, Output="C6");
		float4 SubMat_W6 = MF_ToonSubMaterial(SubMat_ID, Output="W6");

		// Denier -> opacity, half-life form. Denier is grams per 9000m of filament, i.e. how much
		// fibre is in the way, so occlusion is Beer-Lambert in it: every extra 35D halves what
		// still gets through. Written as pow(0.5, D/35) rather than exp(-D/50) because the
		// language has no exp() and the half-life constant is the readable one -- 35 IS the
		// half-opacity denier. Unbounded on purpose (no UIMax): 250D saturates at 0.993 by itself.
		// The thickness map scales denier BEFORE the curve, so a map value of 0.5 means half as
		// many filaments here, which is what a stretched knee actually is.
		float StockingsOpacity = 1.0 - pow(0.5, max(InThickness * In_Stockings_Denier, 0.0) / 35.0);

		float Slot_Density_Authored = StockingsOpacity;
		float Slot_Density = UE.Expression(Class="StaticSwitchParameter", OutputType="float", True=lerp(Slot_Density_Authored, SubMat_C4.x, SubMat_W4.x), False=Slot_Density_Authored, Group="15 - Sub Material", SortPriority=0, ParameterName="Use SubMaterial Table");
		float Slot_FresnelPower_Authored = In_Stockings_FresnelPower;
		float Slot_FresnelPower = UE.Expression(Class="StaticSwitchParameter", OutputType="float", True=lerp(Slot_FresnelPower_Authored, SubMat_C4.y, SubMat_W4.y), False=Slot_FresnelPower_Authored, Group="15 - Sub Material", SortPriority=0, ParameterName="Use SubMaterial Table");
		float Slot_TransmissionStrength_Authored = In_Stockings_TransStrength;
		float Slot_TransmissionStrength = UE.Expression(Class="StaticSwitchParameter", OutputType="float", True=lerp(Slot_TransmissionStrength_Authored, SubMat_C4.z, SubMat_W4.z), False=Slot_TransmissionStrength_Authored, Group="15 - Sub Material", SortPriority=0, ParameterName="Use SubMaterial Table");
		float Slot_TransmissionDistortion_Authored = In_Stockings_TransDistortion;
		float Slot_TransmissionDistortion = UE.Expression(Class="StaticSwitchParameter", OutputType="float", True=lerp(Slot_TransmissionDistortion_Authored, SubMat_C4.w, SubMat_W4.w), False=Slot_TransmissionDistortion_Authored, Group="15 - Sub Material", SortPriority=0, ParameterName="Use SubMaterial Table");
		float Slot_SpecularIntensity_Authored = MF_ToonStockingsSheenMask(GlobalMaskA, GlobalMaskB, GlobalMaskC) * In_Stockings_SpecIntensity;
		float Slot_SpecularIntensity = UE.Expression(Class="StaticSwitchParameter", OutputType="float", True=lerp(Slot_SpecularIntensity_Authored, SubMat_C5.x, SubMat_W5.x), False=Slot_SpecularIntensity_Authored, Group="15 - Sub Material", SortPriority=0, ParameterName="Use SubMaterial Table");
		float Slot_ShadowStrength_Authored = In_Stockings_ShadowStrength;
		float Slot_ShadowStrength = UE.Expression(Class="StaticSwitchParameter", OutputType="float", True=lerp(Slot_ShadowStrength_Authored, SubMat_C5.y, SubMat_W5.y), False=Slot_ShadowStrength_Authored, Group="15 - Sub Material", SortPriority=0, ParameterName="Use SubMaterial Table");
		float Slot_GrazingDarkenStrength_Authored = In_Stockings_GrazingDarken;
		float Slot_GrazingDarkenStrength = UE.Expression(Class="StaticSwitchParameter", OutputType="float", True=lerp(Slot_GrazingDarkenStrength_Authored, SubMat_C5.z, SubMat_W5.z), False=Slot_GrazingDarkenStrength_Authored, Group="15 - Sub Material", SortPriority=0, ParameterName="Use SubMaterial Table");
		float3 Slot_SkinColor_Authored = InSkinColor + In_Stockings_SkinColorRGB.rgb;
		float3 Slot_SkinColor = UE.Expression(Class="StaticSwitchParameter", OutputType="float3", True=lerp(Slot_SkinColor_Authored, SubMat_C6.xyz, SubMat_W6.xyz), False=Slot_SkinColor_Authored, Group="15 - Sub Material", SortPriority=0, ParameterName="Use SubMaterial Table");
		float Slot_GrazingSpecBoost_Authored = In_Stockings_GrazingSpecBoost;
		float Slot_GrazingSpecBoost = UE.Expression(Class="StaticSwitchParameter", OutputType="float", True=lerp(Slot_GrazingSpecBoost_Authored, SubMat_C6.w, SubMat_W6.w), False=Slot_GrazingSpecBoost_Authored, Group="15 - Sub Material", SortPriority=0, ParameterName="Use SubMaterial Table");

		ToonFeatureWrite_NPRStockings(
			Slot_Density,
			Slot_FresnelPower,
			Slot_TransmissionStrength,
			Slot_TransmissionDistortion,
			Slot_SpecularIntensity,
			Slot_ShadowStrength,
			Slot_GrazingDarkenStrength,
			Slot_SkinColor,
			Slot_GrazingSpecBoost,
			ToonBufferA, ToonBufferB, ToonBufferC);

		Density = Slot_Density;
		FresnelPower = Slot_FresnelPower;
		TransmissionStrength = Slot_TransmissionStrength;
		TransmissionDistortion = Slot_TransmissionDistortion;
		SpecularIntensity = Slot_SpecularIntensity;
		ShadowStrength = Slot_ShadowStrength;
		GrazingDarkenStrength = Slot_GrazingDarkenStrength;
		SkinColor = Slot_SkinColor;
		GrazingSpecBoost = Slot_GrazingSpecBoost;
	}
}
