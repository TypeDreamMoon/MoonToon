		// UMaterialExpressionMoonToonFeature call the matching pin, so M_MoonToon can wire the closure
		// by name instead of by lane. Order is slot-table order.
		float BloomWeight;
	}

	Properties = {
		ScalarParameter In_PBRSpecular_BloomWeight = 0.0 [Group="32 - Feature: PBR Specular"; SortPriority=0; Description="该材质的 Bloom 权重, 0 = 未授权(按 1.0 处理)."];
	}

