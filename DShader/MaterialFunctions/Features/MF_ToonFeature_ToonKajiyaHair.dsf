// selection had to become static.
//
// Two output lanes over ONE set of parameters:
//   * ToonBufferA/B/C -- the packed RGBA8 form the legacy (r.Substrate=0) toon prepass reads,
//     reached through MF_MoonToonFeatureSelect. Kept first so its OutputIndex 0/1/2 do not move.
//   * one output per SLOT, named as the slot table names it -- what M_MoonToon wires straight onto
//     the Substrate Moon toon closure's pins, which wear those same names. No packing, because a
//     Substrate value cannot come out of an HLSL Custom node and the packer is one.

Function ToonFeatureWrite_ToonKajiyaHair(
	in float TangentRotate,
	in float SecondaryShift,
	in float SecondaryMask,
	in float PrimaryShift,
	in float PrimaryExpScale,
	in float SecondaryExpScale,
	in float OverallIntensity,
	in float PrimaryIntensity,
	in float SecondaryIntensity,
	in float SecondaryShiftScale,
	in float ShadowStrength,
	out float4 TBufferA, out float4 TBufferB, out float4 TBufferC)
{
	FToonBuffer TBuffer = (FToonBuffer)0;
	InitToonBuffer(TBuffer);

	TBuffer.ShadingFeatureID = MOON_SHADING_FEATURE_ID_TOON_KAJIYA_HAIR_SPECULAR;
	TBuffer.FeatureInputScalarA = TangentRotate;
	TBuffer.FeatureInputScalarB = SecondaryShift;
	TBuffer.FeatureInputScalarC = SecondaryMask;
	TBuffer.FeatureInputScalarD = PrimaryShift;
	TBuffer.FeatureInputScalarE = PrimaryExpScale;
	TBuffer.FeatureInputScalarF = SecondaryExpScale;
	TBuffer.FeatureInputScalarG = OverallIntensity;
	TBuffer.FeatureInputVector.x = PrimaryIntensity;
	TBuffer.FeatureInputVector.y = SecondaryIntensity;
	TBuffer.FeatureInputVector.z = SecondaryShiftScale;
	TBuffer.FeatureInputVector.w = ShadowStrength;

	EncodeToonBuffer(TBuffer, TBufferA, TBufferB, TBufferC);
}

