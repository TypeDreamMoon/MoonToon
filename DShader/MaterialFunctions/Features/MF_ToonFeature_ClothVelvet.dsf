// selection had to become static.
//
// Two output lanes over ONE set of parameters:
//   * ToonBufferA/B/C -- the packed RGBA8 form the legacy (r.Substrate=0) toon prepass reads,
//     reached through MF_MoonToonFeatureSelect. Kept first so its OutputIndex 0/1/2 do not move.
//   * one output per SLOT, named as the slot table names it -- what M_MoonToon wires straight onto
//     the Substrate Moon toon closure's pins, which wear those same names. No packing, because a
//     Substrate value cannot come out of an HLSL Custom node and the packer is one.

import "Shared/ToonFunctions.dsh";

Function ToonFeatureWrite_ClothVelvet(
	in float WrapStrength,
	in float SheenPower,
	in float SheenShadowStrength,
	in float RoughnessScale,
	in float SheenIntensity,
	in float RetroDiffuseStrength,
	in float GrazingDarkenStrength,
	in float3 SheenTint,
	in float RimBias,
	out float4 TBufferA, out float4 TBufferB, out float4 TBufferC)
{
	FToonBuffer TBuffer = (FToonBuffer)0;
	InitToonBuffer(TBuffer);

	TBuffer.ShadingFeatureID = MOON_SHADING_FEATURE_ID_CLOTH_VELVET;
	TBuffer.FeatureInputScalarA = WrapStrength;
	TBuffer.FeatureInputScalarB = SheenPower;
	TBuffer.FeatureInputScalarC = SheenShadowStrength;
	TBuffer.FeatureInputScalarD = RoughnessScale;
	TBuffer.FeatureInputScalarE = SheenIntensity;
	TBuffer.FeatureInputScalarF = RetroDiffuseStrength;
	TBuffer.FeatureInputScalarG = GrazingDarkenStrength;
	TBuffer.FeatureInputVector.xyz = SheenTint;
	TBuffer.FeatureInputVector.w = RimBias;

	EncodeToonBuffer(TBuffer, TBufferA, TBufferB, TBufferC);
}

