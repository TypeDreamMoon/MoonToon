	TBuffer.ShadingFeatureID = MOON_SHADING_FEATURE_ID_HAIR_HIGHLIGHT_MASK;
	TBuffer.FeatureInputScalarA = Mask;
	TBuffer.FeatureInputScalarB = Intensity;
	TBuffer.FeatureInputScalarC = ShadowIntensity;
	TBuffer.FeatureInputScalarD = ViewAnchorBlend;

	EncodeToonBuffer(TBuffer, TBufferA, TBufferB, TBufferC);
}

