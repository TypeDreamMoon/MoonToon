		ScalarParameter In_Hair_HighlightMaskIntensity = 0.0 [Group="33 - Feature: Hair Highlight Mask"; SortPriority=1; Description="天使环强度. 0 = 关闭."];
		ScalarParameter In_Hair_HighlightMaskShadowIntensity = 0.0 [Group="33 - Feature: Hair Highlight Mask"; SortPriority=2; Description="天使环在阴影中保留多少. 0 = 阴影里完全消失, 1 = 不受阴影影响."];
		ScalarParameter In_Hair_HighlightViewAnchorBlend = 0.0 [Group="33 - Feature: Hair Highlight Mask"; SortPriority=3; Description="0 = 天使环锚定在光照角度(旧行为); 1 = 锚定在视角, 环会跟着相机走, 更接近手绘动画的做法."];
