Function ToonFeatureWrite_Default(
	in float MultiBandCelEnable,
	in float TerminatorWidth,
	in float BloomWeight,
	out float4 TBufferA, out float4 TBufferB, out float4 TBufferC)
{
	FToonBuffer TBuffer = (FToonBuffer)0;
	InitToonBuffer(TBuffer);

	TBuffer.ShadingFeatureID = MOON_SHADING_FEATURE_ID_DEFAULT;
	TBuffer.FeatureInputScalarB = MultiBandCelEnable;
	TBuffer.FeatureInputScalarC = TerminatorWidth;
	TBuffer.FeatureInputVector.w = BloomWeight;

	EncodeToonBuffer(TBuffer, TBufferA, TBufferB, TBufferC);
}

