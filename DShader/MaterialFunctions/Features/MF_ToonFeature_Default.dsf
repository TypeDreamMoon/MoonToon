		ScalarParameter In_Default_TerminatorWidth = 0.0 [Group="31 - Feature: Default"; SortPriority=1; Description="每材质的明暗交界宽度, 与逐光源的 ToonLightSmooth 解耦 —— 同一盏灯下皮肤软、布料硬. 0 = 完全交给 Ramp."];
