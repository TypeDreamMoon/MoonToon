// Edit the slot table (for the mapping) or the generator (for names/defaults), not this file.
//
// One toon feature, one material function. It declares only its own slots, so a material instance
// that selected a different feature never shows these parameters -- that pruning is why feature
// selection had to become static.
//
// Two output lanes over ONE set of parameters:
//   * ToonBufferA/B/C -- the packed RGBA8 form the legacy (r.Substrate=0) toon prepass reads,
//     reached through MF_MoonToonFeatureSelect. Kept first so its OutputIndex 0/1/2 do not move.
//   * one output per SLOT, named as the slot table names it -- what M_MoonToon wires straight onto
//     the Substrate Moon toon closure's pins, which wear those same names. No packing, because a
//     Substrate value cannot come out of an HLSL Custom node and the packer is one.

Function ToonFeatureWrite_Eye(
	in float DiffuseWrapStrength,
	in float LimbalDarkenStrength,
	in float SpecularShadowStrength,
	in float PrimaryRoughnessScale,
	in float SecondaryRoughnessScale,
	in float PrimaryIntensity,
	in float SecondaryIntensity,
	in float3 EyeTint,
	in float SecondaryRampOffset,
	out float4 TBufferA, out float4 TBufferB, out float4 TBufferC)
{
	FToonBuffer TBuffer = (FToonBuffer)0;
	InitToonBuffer(TBuffer);

	TBuffer.ShadingFeatureID = MOON_SHADING_FEATURE_ID_EYE;
	TBuffer.FeatureInputScalarA = DiffuseWrapStrength;
	TBuffer.FeatureInputScalarB = LimbalDarkenStrength;
	TBuffer.FeatureInputScalarC = SpecularShadowStrength;
	TBuffer.FeatureInputScalarD = PrimaryRoughnessScale;
	TBuffer.FeatureInputScalarE = SecondaryRoughnessScale;
	TBuffer.FeatureInputScalarF = PrimaryIntensity;
	TBuffer.FeatureInputScalarG = SecondaryIntensity;
	TBuffer.FeatureInputVector.xyz = EyeTint;
	TBuffer.FeatureInputVector.w = SecondaryRampOffset;

	EncodeToonBuffer(TBuffer, TBufferA, TBufferB, TBufferC);
}

