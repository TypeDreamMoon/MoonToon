Function ToonFeatureWrite_Matcap(
	in float Intensity,
	in float3 MatcapColor,
	out float4 TBufferA, out float4 TBufferB, out float4 TBufferC)
{
	FToonBuffer TBuffer = (FToonBuffer)0;
	InitToonBuffer(TBuffer);

	TBuffer.ShadingFeatureID = MOON_SHADING_FEATURE_ID_MATCAP;
	TBuffer.FeatureInputScalarA = Intensity;
	TBuffer.FeatureInputVector.xyz = MatcapColor;

	EncodeToonBuffer(TBuffer, TBufferA, TBufferB, TBufferC);
}

