// Picks which packed mask map a consumer reads, from the ones the base input already sampled.
//
// The point of the indirection: a mask map is sampled ONCE for the whole material and every
// consumer selects a channel out of the result. Giving each consumer its own texture parameter
// instead would cost a fetch per consumer even when they all point at the same asset, because the
// translator dedupes on generated code and two texture parameters generate two different uniform
// slots (FHLSLMaterialTranslator::AddCodeChunkInner hashes the code, not the value).
//
// Index 0 is "no mask" and returns white, so a consumer that was never configured multiplies by 1
// rather than by whatever happens to be in some other feature's channel.
GraphFunction SelectGlobalMaskMap(in float4 MapA, in float4 MapB, in float4 MapC, in float MapIndex, out float4 Result)
{
	float4 Unmasked = float4(1.0, 1.0, 1.0, 1.0);
	Result = lerp(lerp(lerp(Unmasked, MapA, saturate(MapIndex)), MapB, saturate(MapIndex - 1.0)), MapC, saturate(MapIndex - 2.0));
}

// Sub-material table (T22 / G01), DShader/MaterialFunctions/Shared/MF_ToonSubMaterial.dss.
VirtualFunction(Name="MF_ToonSubMaterialID")
{
	Options = {
		Asset = Path(Plugins.MoonToon, "MaterialFunctions/Shared/MF_ToonSubMaterialID");
		Description = "The sub-material ID (0..15) from the ID map, vertex colour, UV range or a constant.";
	}
	Inputs = { }
	Outputs = { float Result; float PatternID; }
}

VirtualFunction(Name="MF_ToonSubMaterial")
{
	Options = {
		Asset = Path(Plugins.MoonToon, "MaterialFunctions/Shared/MF_ToonSubMaterial");
		Description = "One row of the sub-material table: C0..C7 the values, W0..W7 the override weights.";
	}
	Inputs = { float ID; }
	Outputs = {
		float Result;
		float4 C0; float4 C1; float4 C2; float4 C3; float4 C4; float4 C5; float4 C6; float4 C7;
		float4 W0; float4 W1; float4 W2; float4 W3; float4 W4; float4 W5; float4 W6; float4 W7;
	}
}
