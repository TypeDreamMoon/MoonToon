{
	Options = {
		Asset = Path(Plugins.MoonToon, "MaterialFunctions/Shared/MF_ToonShadowColorLUT");
		Description = "Shadow colour from a 32^3 albedo LUT (T08 / G22).";
	}

	Inputs = {
		float3 BaseColor;
		float3 ShadowColorIn;
	}

	Outputs = {
		float3 Result;
	}
}

