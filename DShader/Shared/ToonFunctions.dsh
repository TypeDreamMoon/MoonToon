// The engine and plugin material functions the MoonToon sources call.
//
// A VirtualFunction declares an asset that already exists; it generates nothing. They were copied
// into every file that called them -- 193 lines of it in MF_MoonToonBaseInput alone, and a second
// copy of MF_UVChannelSwitch in MF_ToonUV -- so a signature change had to be made in each place or
// the odd one out failed at its call site instead of at the declaration.
//
// Import this instead. Declaring one that the importing file never calls costs nothing.

VirtualFunction(Name="MF_MoonToonFeatureSelect")
{
	Options = {
		Asset = Path(Plugins.MoonToon, "MaterialFunctions/MF_MoonToonFeatureSelect");
		Description = "Static toon feature selection; see Tools/gen_feature_functions.py.";
	}

	// Mirrors the Inputs block the generator writes into MF_MoonToonFeatureSelect.dsf, in the same
	// order -- these are positional. Change one and this has to follow, or the call site fails with
	// an arity error rather than anything that names the real problem.
	Inputs = {
		opt float InToonKajiyaSecondaryStrandShift = 0.0;
		opt float InToonKajiyaPrimaryStrandShift = 0.0;
		opt float4 InGlobalMaskA = float4(1.0, 1.0, 1.0, 1.0);
		opt float4 InGlobalMaskB = float4(1.0, 1.0, 1.0, 1.0);
		opt float4 InGlobalMaskC = float4(1.0, 1.0, 1.0, 1.0);
		opt float3 InStockingsBodyColor = float3(0.0, 0.0, 0.0);
	}

	Outputs = {
		float4 ToonBufferA;
		float4 ToonBufferB;
		float4 ToonBufferC;
		float ShadingFeatureID;
		float4 DebugColor;
	}
}
VirtualFunction(Name="AppendMany")
{
	Options = {
		Asset = Path(Engine, "Functions/Engine_MaterialFunctions02/Utility/AppendMany");
		Description = "Generated from /Engine/Functions/Engine_MaterialFunctions02/Utility/AppendMany.AppendMany";
	}

	Inputs = {
		opt float R = 0.0;
		opt float G = 0.0;
		opt float B = 0.0;
		opt float A = 0.0;
	}

	Outputs = {
		float2 RG;
		float3 RGB;
		float4 RGBA;
	}
}
VirtualFunction(Name="MF_UVChannelSwitch")
{
	Options = {
		Asset = Path(Plugins.MoonToon, "MaterialFunctions/Utils/MF_UVChannelSwitch");
		Description = "Generated from /MoonToon/MaterialFunctions/Utils/MF_UVChannelSwitch.MF_UVChannelSwitch";
	}

	Inputs = {
		float UVChannelIndex [
			Description="The UV channel index to output.";
			SortPriority=100;
		];
	}

	Outputs = {
		float2 Result;
	}
}
