VirtualFunction(Name="MF_ToonSeeThroughOverlay")
{
	Options = {
		Asset = Path(Plugins.MoonToon, "MaterialFunctions/Shared/MF_ToonSeeThroughOverlay");
	}

	Inputs = {
		float3 BaseColor;
		opt float4 GlobalMaskA = float4(1.0, 1.0, 1.0, 1.0);
		opt float4 GlobalMaskB = float4(1.0, 1.0, 1.0, 1.0);
		opt float4 GlobalMaskC = float4(1.0, 1.0, 1.0, 1.0);
	}

	Outputs = {
		float4 FaceOverlayData;
		float4 FaceOverlayParams;
		float4 FaceOverlayStencilIDs;
		// Engine #10: this material's own FaceOverlay occluder class (0 = not an occluder).
		float FaceOverlayOccluderClass;
		// See-through group for the per-character tier: 0 auto, 1 brow, 2 eye.
		float FaceOverlayPart;
		// Hair-thickness falloff, cm (0 = engine default).
		float FaceOverlayThickness;
	}
}
